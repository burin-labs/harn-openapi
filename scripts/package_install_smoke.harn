/**
 * package_install_smoke - verify a clean consumer can install this package,
 * generate a typed SDK, and project its registry through CLI and MCP.
 *
 * By default the smoke installs the current checkout as a path dependency,
 * which keeps PR CI useful before a release tag exists. Set HARN_PACKAGE_REF
 * to test a published ref such as
 * `github.com/burin-labs/harn-openapi@v0.2.0-rc.1`.
 */
import { ToolCatalog } from "std/tools"

type PingResult = {ok: bool}

fn _repo_root(fs: HarnessFs) -> string {
  return fs.source_dir() + "/.."
}

fn _sh_quote(value: string) -> string {
  return "'" + replace(value, "'", "'\"'\"'") + "'"
}

fn _harn_bin(env: HarnessEnv) -> string {
  const bin = env.get("HARN_BIN")
  if bin != nil && bin != "" {
    return bin
  }
  return "harn"
}

fn _package_ref(env: HarnessEnv, repo_root: string) -> string {
  const package_ref = env.get("HARN_PACKAGE_REF")
  if package_ref != nil && package_ref != "" {
    return package_ref
  }
  return repo_root
}

fn _scratch_root(random: HarnessRandom, repo_root: string, label: string) -> string {
  return repo_root + "/.harn/tmp/" + label + "-" + random.uuid()
}

fn _run(
  harness: {stdio: HarnessStdio, process: HarnessProcess},
  cwd: string,
  label: string,
  cmd: string,
) {
  harness.stdio.println("running: ${label}")
  const result = harness.process.shell_at(cwd, cmd)
  if result.stdout != "" {
    harness.stdio.println(result.stdout.trim())
  }
  if !result.success {
    if result.stderr != "" {
      harness.stdio.println(result.stderr.trim())
    }
    throw "package_install_smoke: " + label + " failed"
  }
}

pipeline default(harness: Harness) {
  const repo_root = _repo_root(harness.fs)
  const smoke_root = _scratch_root(harness.random, repo_root, "harn-openapi-install-smoke")
  const harn_bin = _harn_bin(harness.env)
  const package_ref = _package_ref(harness.env, repo_root)
  harness.fs.mkdir(smoke_root)
  harness.fs.write_text(
    smoke_root + "/harn.toml",
    """
[package]
name = "harn-openapi-consumer-smoke"
version = "0.0.0"
""",
  )
  _run(
    {stdio: harness.stdio, process: harness.process},
    smoke_root,
    "add harn-openapi dependency",
    _sh_quote(harn_bin) + " add --alias harn-openapi " + _sh_quote(package_ref),
  )
  _run(
    {stdio: harness.stdio, process: harness.process},
    smoke_root,
    "locked offline install",
    _sh_quote(harn_bin) + " install --locked --offline --json",
  )
  harness.fs.write_text(
    smoke_root + "/smoke.harn",
    """
import { codegen_module, operations, parse } from "harn-openapi/default"

pipeline default(harness: Harness) {
  const raw = "{\"openapi\":\"3.1.0\",\"info\":{\"title\":\"Package Smoke\",\"version\":\"0.0.0\"},\"paths\":{\"/ping\":{\"get\":{\"operationId\":\"ping\",\"x-harn\":{\"cli\":{\"command\":[\"ping\"]}},\"responses\":{\"200\":{\"description\":\"ok\",\"content\":{\"application/json\":{\"schema\":{\"type\":\"object\",\"properties\":{\"ok\":{\"type\":\"boolean\"}},\"required\":[\"ok\"],\"additionalProperties\":false}}}}}}}}}"
  const doc: OpenApiDoc = parse(raw)
  const ops: list<Operation> = operations(doc)
  require len(ops) == 1, "package import should parse and walk one operation"
  const op = ops[0]
  require op != nil, "package import should expose the parsed operation"
  require op.operation_id == "ping", "operation id should round-trip"
  const root = harness.fs.source_dir()
  harness.fs.write_text(
    root + "/generated.harn",
    codegen_module(harness.fs, doc, {
      module_name: "package_smoke",
      client_name: "PackageSmokeClient",
      default_base_url: "https://api.example.test",
    }),
  )
  harness.fs.write_text(
    root + "/server.harn",
    "import { adapter_tools, new_client } from \"./generated\"\n\n"
      + "fn main(harness: Harness) {\n"
      + "  harness.testing.http_mock_clear()\n"
      + "  harness.testing.http_mock(\"GET\", \"https://api.example.test/ping\", {status: 200, body: \"{\\\"ok\\\":true}\"})\n"
      + "  const client = new_client()\n"
      + "  harness.tools.mcp_tools(adapter_tools({clock: harness.clock, net: harness.net}, client))\n"
      + "}\n",
  )
  harness.stdio.println("package_install_smoke consumer: ok")
}
""",
  )
  _run(
    {stdio: harness.stdio, process: harness.process},
    smoke_root,
    "check consumer smoke",
    _sh_quote(harn_bin) + " check smoke.harn",
  )
  _run(
    {stdio: harness.stdio, process: harness.process},
    smoke_root,
    "run consumer smoke",
    _sh_quote(harn_bin) + " run smoke.harn",
  )
  const server_path = smoke_root + "/server.harn"
  const schema = harness.process.run({program: harn_bin, args: ["tool", "schema", server_path]})
  require schema.success, "installed package schema projection failed: " + schema.stderr
  const catalog: ToolCatalog = schema_expect(json_parse(schema.stdout), ToolCatalog)
  require catalog.schema_version == "harn-tools/1.0", "catalog version should be stable"
  require len(catalog.tools) == 1, "installed package should generate one tool"
  const generated_tool = catalog.tools[0]
  require generated_tool != nil, "installed package should generate a tool entry"
  require generated_tool.name == "ping", "installed package should retain the operation"
  require generated_tool.title == "ping", "operation id should backfill an absent summary"
  const help = harness.process.run(
    {program: harn_bin, args: ["tool", "run", server_path, "ping", "--help"]},
  )
  require help.success, "installed package CLI help failed: " + help.stderr
  const called = harness.process.run(
    {program: harn_bin, args: ["tool", "run", server_path, "ping", "--harn-output", "json"]},
  )
  require called.success, "installed package CLI dispatch failed: " + called.stderr
  const called_output: PingResult = schema_expect(json_parse(called.stdout), PingResult)
  require called_output.ok == true, "installed package CLI should return typed JSON"
  const mcp = harness.tools.mcp_connect(harn_bin, ["serve", "mcp", server_path])
  const tools = harness.tools.mcp_list_tools(mcp)
  require tools.count == 1, "installed package MCP server should expose one tool"
  require tools[0].name == "ping", "CLI and MCP should expose the same tool"
  const mcp_output: PingResult = schema_expect(harness.tools.mcp_call(mcp, "ping"), PingResult)
  require mcp_output.ok == true, "installed package MCP dispatch should return typed JSON"
  harness.tools.mcp_disconnect(mcp)
  harness.fs.delete(smoke_root)
  harness.stdio.println("package_install_smoke: ok")
}
