/**
 * package_install_smoke - verify a clean consumer can install and import this
 * package.
 *
 * By default the smoke installs the current checkout as a path dependency,
 * which keeps PR CI useful before a release tag exists. Set HARN_PACKAGE_REF
 * to test a published ref such as
 * `github.com/burin-labs/harn-openapi@v0.1.1-rc.2`.
 */
fn _repo_root(fs: HarnessFs) -> string {
  return fs.source_dir() + "/.."
}

fn _sh_quote(value: string) -> string {
  return "'" + replace(value, "'", "'\"'\"'") + "'"
}

fn _harn_bin(env: HarnessEnv) -> string {
  const bin = env.get("HARN_BIN")
  if bin != nil && bin != "" {
    return bin
  }
  return "harn"
}

fn _package_ref(env: HarnessEnv, repo_root: string) -> string {
  const package_ref = env.get("HARN_PACKAGE_REF")
  if package_ref != nil && package_ref != "" {
    return package_ref
  }
  return repo_root
}

fn _scratch_root(random: HarnessRandom, repo_root: string, label: string) -> string {
  return repo_root + "/.harn/tmp/" + label + "-" + random.uuid()
}

fn _run(
  harness: {stdio: HarnessStdio, process: HarnessProcess},
  cwd: string,
  label: string,
  cmd: string,
) {
  harness.stdio.println("running: ${label}")
  const result = harness.process.shell_at(cwd, cmd)
  if result.stdout != "" {
    harness.stdio.println(result.stdout.trim())
  }
  if !result.success {
    if result.stderr != "" {
      harness.stdio.println(result.stderr.trim())
    }
    throw "package_install_smoke: " + label + " failed"
  }
}

pipeline default(harness: Harness) {
  const repo_root = _repo_root(harness.fs)
  const smoke_root = _scratch_root(harness.random, repo_root, "harn-openapi-install-smoke")
  const harn_bin = _harn_bin(harness.env)
  const package_ref = _package_ref(harness.env, repo_root)
  harness.fs.mkdir(smoke_root)
  harness.fs.write_text(
    smoke_root + "/harn.toml",
    """
[package]
name = "harn-openapi-consumer-smoke"
version = "0.0.0"
""",
  )
  _run(
    {stdio: harness.stdio, process: harness.process},
    smoke_root,
    "add harn-openapi dependency",
    _sh_quote(harn_bin) + " add --alias harn-openapi " + _sh_quote(package_ref),
  )
  _run(
    {stdio: harness.stdio, process: harness.process},
    smoke_root,
    "locked offline install",
    _sh_quote(harn_bin) + " install --locked --offline --json",
  )
  harness.fs.write_text(
    smoke_root + "/smoke.harn",
    """
import {
  AdapterJsonSchema,
  AdapterSchemaGraph,
  normalize_adapter_schema,
  normalize_adapter_schema_graph,
  operations,
  parse,
} from "harn-openapi/default"

pipeline default(harness: Harness) {
  const raw = "{\"openapi\":\"3.1.0\",\"info\":{\"title\":\"Package Smoke\",\"version\":\"0.0.0\"},\"paths\":{\"/ping\":{\"get\":{\"operationId\":\"ping\",\"responses\":{\"200\":{\"description\":\"ok\"}}}}}}"
  const doc: OpenApiDoc = parse(raw)
  const ops: list<Operation> = operations(doc)
  require len(ops) == 1, "package import should parse and walk one operation"
  const op = ops[0]
  require op != nil, "package import should expose the parsed operation"
  require op.operation_id == "ping", "operation id should round-trip"
  const graph: AdapterSchemaGraph = normalize_adapter_schema_graph(
    doc.openapi,
    {Ping: {type: "object", properties: {ok: {type: "boolean"}}, required: ["ok"]}},
    doc.jsonSchemaDialect,
  )
  const input: AdapterJsonSchema = normalize_adapter_schema(
    doc.openapi,
    {
      type: "object",
      properties: {ping: {"$ref": "#/components/schemas/Ping"}},
      required: ["ping"],
      additionalProperties: false,
    },
    graph,
    doc.jsonSchemaDialect,
  )
  require len(graph.schemas) == 1, "package import should retain one component"
  require input.properties.ping.get("$ref") == "#/components/schemas/Ping",
    "package import should preserve a component reference"
  harness.stdio.println("package_install_smoke consumer: ok")
}
""",
  )
  _run(
    {stdio: harness.stdio, process: harness.process},
    smoke_root,
    "check consumer smoke",
    _sh_quote(harn_bin) + " check smoke.harn",
  )
  _run(
    {stdio: harness.stdio, process: harness.process},
    smoke_root,
    "run consumer smoke",
    _sh_quote(harn_bin) + " run smoke.harn",
  )
  harness.fs.delete(smoke_root)
  harness.stdio.println("package_install_smoke: ok")
}
