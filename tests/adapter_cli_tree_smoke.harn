import { normalize_adapter_cli_tree } from "../src/adapter_cli_tree"

fn tags() {
  return [
    {command: "widgets", title: "Widgets", description: "Manage widgets.", display_order: 0},
    {command: "admin", title: "Administration", display_order: 1},
  ]
}

fn rejection(value: any) -> string {
  const caught = try {
    normalize_adapter_cli_tree(value, tags())
    nil
  } catch (error) {
    error
  }
  return to_string(caught)
}

@test
pipeline default(harness: Harness) {
  require harness.fs.source_dir() != "", "test must run with a real harness"
  const defaults = normalize_adapter_cli_tree(nil, tags())
  require len(defaults.commands) == 2, "every declared OpenAPI tag should project once"
  const default_widgets = defaults.commands[0]
  const default_admin = defaults.commands[1]
  require default_widgets != nil && default_admin != nil, "derived command census"
  require default_widgets.command == ["widgets"], "tag command path"
  require default_widgets.title == "Widgets", "tag title"
  require default_widgets.description == "Manage widgets.", "tag description"
  require default_admin.display_order == 1, "stable tag order"
  const overridden = normalize_adapter_cli_tree(
    {
      commands: [
        {command: ["widgets"], title: "Widget operations", aliases: ["widget"], display_order: 10},
        {command: ["admin", "users"], description: "Manage users.", hidden: true},
      ],
    },
    tags(),
  )
  require len(overridden.commands) == 3, "override should replace one path and add one path"
  const overridden_widgets = overridden.commands[0]
  const overridden_users = overridden.commands[2]
  require overridden_widgets != nil && overridden_users != nil, "overridden command census"
  require overridden_widgets.title == "Widget operations", "tag override title"
  require overridden_widgets.aliases == ["widget"], "tag override aliases"
  require overridden_widgets.description == "Manage widgets.", "tag defaults survive overlay"
  require overridden_users.command == ["admin", "users"], "nested parent metadata"
  require overridden_users.hidden == true, "nested parent hidden state"
  const cases = [
    {value: "cli", expected: "harn-openapi.codegen_module: root x-harn.cli must be an object"},
    {
      value: {arguments: {}},
      expected: "harn-openapi.codegen_module: root x-harn.cli contains unknown field 'arguments'",
    },
    {
      value: {commands: {}},
      expected: "harn-openapi.codegen_module: root x-harn.cli.commands must be a list",
    },
    {
      value: {commands: [{command: ["bad command"]}]},
      expected:
        "harn-openapi.codegen_module: root x-harn.cli.commands[0].command must contain portable command names",
    },
    {
      value: {commands: [{command: ["widgets"], aliases: ["w", "w"]}]},
      expected:
        "harn-openapi.codegen_module: root x-harn.cli.commands[0].aliases contains duplicate alias 'w'",
    },
    {
      value: {commands: [{command: ["widgets"]}, {command: ["widgets"]}]},
      expected:
        "harn-openapi.codegen_module: root x-harn.cli.commands contains duplicate declared path 'widgets'",
    },
  ]
  for case in cases {
    require rejection(case.value) == case.expected, "exact root CLI boundary diagnostic"
  }
}
