// webhook_smoke — OAS 3.1 acceptance: parse() surfaces `webhooks` and
// `components.pathItems`; `webhook_operations(doc)` flattens webhook
// path items; a handler's request-body schema resolves via schema().
//
// Tracks burin-labs/harn-openapi#2.
import { component_path_items, parse, schema, webhook_operations } from "../src/lib"

const _WEBHOOK_DOC = """
{
  "openapi": "3.1.0",
  "info": {"title": "Webhook fixture", "version": "1.0.0"},
  "paths": {},
  "webhooks": {
    "commentCreated": {
      "post": {
        "operationId": "webhook-comment-created",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {"$ref": "#/components/schemas/CommentCreated"}
            }
          }
        },
        "responses": {"200": {"description": "accepted"}}
      }
    }
  },
  "components": {
    "pathItems": {
      "ReusableWebhook": {
        "post": {
          "operationId": "reusable-webhook",
          "responses": {"200": {"description": "accepted"}}
        }
      }
    },
    "schemas": {
      "CommentCreated": {
        "type": "object",
        "properties": {
          "id": {"type": "string"},
          "type": {"type": "string"}
        }
      }
    }
  }
}
"""

pipeline test_main() {
  const doc = parse(_WEBHOOK_DOC)
  // parse() must surface the webhooks map.
  const webhooks = doc.webhooks ?? {}
  assert(type_of(webhooks) == "dict", "doc.webhooks must be a dict")
  const webhook_count = len(webhooks)
  harness.stdio.println("webhooks (raw): ${webhook_count}")
  assert(webhook_count == 1, "expected one focused webhook, got ${webhook_count}")
  // parse() must surface components.pathItems as a dict, even if empty.
  const path_items = doc.components?.pathItems ?? {}
  assert(type_of(path_items) == "dict", "doc.components.pathItems must be a dict")
  // component_path_items(doc) is the passthrough accessor.
  const comp_path_items = component_path_items(doc)
  assert(type_of(comp_path_items) == "dict", "component_path_items(doc) must return a dict")
  assert(len(comp_path_items) == 1, "component_path_items(doc) must preserve entries")
  harness.stdio.println("components.pathItems: ${len(comp_path_items)}")
  // webhook_operations(doc) flattens webhook path items into a list.
  const webhook_ops = webhook_operations(doc)
  harness.stdio.println("webhook operations: ${len(webhook_ops)}")
  assert(len(webhook_ops) == 1, "expected one webhook operation, got ${len(webhook_ops)}")
  // Every entry must have the shape { name, method, path_item, operation, ... }.
  for wop in webhook_ops {
    assert(wop.name != nil && wop.name != "", "webhook operation missing name")
    assert(wop.method != nil && wop.method != "", "webhook operation missing method")
    assert(type_of(wop.path_item) == "dict", "webhook operation path_item must be a dict")
    assert(type_of(wop.operation) == "dict", "webhook operation operation must be a dict")
  }
  // Locate the commentCreated webhook and verify its payload schema resolves.
  let comment_created = nil
  for wop in webhook_ops {
    if wop.name == "commentCreated" {
      comment_created = wop
    }
  }
  assert(comment_created != nil, "could not find commentCreated webhook")
  harness.stdio.println(
    "commentCreated: ${comment_created.method} -> ${comment_created.operation_id}",
  )
  const req_body = comment_created.operation.get("requestBody")
  assert(req_body != nil, "commentCreated webhook must declare a requestBody")
  const payload_schema_raw = req_body.content["application/json"].schema
  const resolved = schema(doc, payload_schema_raw)
  assert(type_of(resolved) == "dict", "resolved webhook schema must be a dict")
  // The focused webhook envelope should retain its resolved object shape.
  const has_props = resolved.get("properties") != nil
  const has_oneof = resolved.get("oneOf") != nil
  const has_allof = resolved.get("allOf") != nil
  const has_anyof = resolved.get("anyOf") != nil
  const has_type = resolved.get("type") != nil
  assert(
    has_props || has_oneof || has_allof || has_anyof || has_type,
    "resolved commentCreated payload schema must expose properties/oneOf/allOf/anyOf/type",
  )
  if has_props {
    const field_names = resolved.properties?.keys() ?? []
    harness.stdio.println("commentCreated payload fields: ${len(field_names)}")
  }
  harness.stdio.println("webhook_smoke: ok")
}
