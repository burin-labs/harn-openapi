import { codegen_module, parse } from "../src/lib"

const _COLLIDING_NAMES: list<string> = [
  "client",
  "harness",
  "net",
  "body",
  "operation_auth",
  "path_bindings",
  "path",
  "query_bindings",
  "url",
  "request_headers",
  "body_str",
  "body_variant",
  "resp",
  "raw",
  "url_2",
]

fn run_generated(harness: Harness, document: dict, runner: string, transport: string) -> nil {
  const root = harness.fs.mkdtemp("harn-openapi-boundary-")
  const source = codegen_module(
    harness.fs,
    parse(json_stringify(document)),
    {module_name: "boundary", transport: transport},
  )
  harness.fs.write_text("${root}/generated.harn", source)
  harness.fs.write_text("${root}/runner.harn", runner)
  const checked = harness.process.run(
    {program: harness.env.get("HARN_BIN") ?? "harn", args: ["check", "${root}/runner.harn"]},
  )
  require checked.success, "${transport}: ${checked.stdout}\n${checked.stderr}"
  const result = harness.process.run(
    {program: harness.env.get("HARN_BIN") ?? "harn", args: ["test", "${root}/runner.harn"]},
  )
  require result.success, "${transport}: ${result.stdout}\n${result.stderr}"
}

@heavy(threads: 2)
pipeline test_union_bodies_use_the_public_schema(harness: Harness) {
  const document = {
    openapi: "3.1.1",
    info: {title: "Union bodies", version: "1"},
    paths: {
      "/pets": {
        post: {
          operationId: "savePet",
          requestBody: {
            required: true,
            content: {
              "application/json": {
                schema: {
                  oneOf: [
                    {
                      title: "Cat",
                      type: "object",
                      additionalProperties: false,
                      required: ["kind", "meow"],
                      properties: {
                        kind: {const: "cat"},
                        meow: {type: "string"},
                        _variant: {type: "string"},
                      },
                    },
                    {title: "Note", type: "string"},
                  ],
                },
              },
            },
          },
          responses: {"204": {description: "Saved"}},
        },
      },
    },
  }
  for transport in ["connector_policy", "raw"] {
    const authority = if transport == "raw" {
      "harness.net"
    } else {
      "{clock: harness.clock, net: harness.net}"
    }
    const runner = """
      import { agent_dispatch_tool_call } from "std/agent/primitives"
      import { adapter_tools, new_client, save_pet, save_pet_cat, save_pet_note } from "./generated"

      pipeline test_schema_valid_body(harness: Harness) {
        const client = new_client("https://api.example.test")
        const registry = adapter_tools(AUTHORITY, client)
        assert_eq(save_pet_note("a note"), "a note")
        assert_eq(save_pet_cat("mew"), {kind: "cat", meow: "mew"})
        for body in [save_pet_cat("mew"), save_pet_note("a note")] {
          harness.testing.http_mock_clear()
          harness.testing.http_mock("POST", "https://api.example.test/pets", {status: 204, body: ""})
          const called = agent_dispatch_tool_call(
            harness.tools, {name: "save_pet", arguments: {body: body}}, registry,
          )
          assert(called.ok, json_stringify(called))
          const calls = harness.testing.http_mock_calls()
          assert_eq(len(calls), 1)
          assert_eq(json_parse(calls[0].body), body)
        }
        harness.testing.http_mock_clear()
        const rejected = agent_dispatch_tool_call(
          harness.tools, {name: "save_pet", arguments: {body: {kind: "cat"}}}, registry,
        )
        assert(!rejected.ok)
        assert_eq(len(harness.testing.http_mock_calls()), 0)
      }

      pipeline test_schema_property_is_not_an_internal_marker(harness: Harness) {
        const client = new_client("https://api.example.test")
        const body = {kind: "cat", meow: "mew", _variant: "Cat"}
        assert_eq(save_pet_cat("mew", "Cat"), body)
        harness.testing.http_mock("POST", "https://api.example.test/pets", {status: 204, body: ""})
        save_pet(AUTHORITY, client, body)
        const calls = harness.testing.http_mock_calls()
        assert_eq(len(calls), 1)
        assert_eq(json_parse(calls[0].body), body)
      }
      """
    run_generated(harness, document, replace(runner, "AUTHORITY", authority), transport)
  }
}

@heavy(threads: 2)
pipeline test_head_returns_headers_without_decoding_a_body(harness: Harness) {
  const document = {
    openapi: "3.1.1",
    info: {title: "HEAD metadata", version: "1"},
    paths: {
      "/items": {
        head: {
          operationId: "inspectItems",
          responses: {
            "200": {
              description: "Metadata for the JSON representation",
              content: {"application/json": {schema: {type: "object"}}},
            },
          },
        },
      },
    },
  }
  for transport in ["connector_policy", "raw"] {
    const authority = if transport == "raw" {
      "harness.net"
    } else {
      "{clock: harness.clock, net: harness.net}"
    }
    const runner = """
      import { adapter_tools, inspect_items, new_client } from "./generated"

      pipeline test_headers(harness: Harness) {
        const client = new_client("https://api.example.test")
        harness.testing.http_mock("HEAD", "https://api.example.test/items", {
          status: 200, body: "", headers: {etag: "version-1", "content-type": "application/json"},
        })
        const result = inspect_items(AUTHORITY, client)
        assert_eq(result.status, 200)
        assert_eq(result.headers.etag, "version-1")
        assert_eq(result.body, "")
        const tool = adapter_tools(AUTHORITY, client).tools[0]
        assert_eq(tool.get("outputSchema"), nil)
        assert_eq(tool.handler({}).data.headers.etag, "version-1")
        assert_eq(len(harness.testing.http_mock_calls()), 2)
      }
      """
    run_generated(harness, document, replace(runner, "AUTHORITY", authority), transport)
  }
}

@heavy(threads: 2)
pipeline test_nullable_schema_types(harness: Harness) {
  const document = {
    openapi: "3.1.1",
    info: {title: "Nullable values", version: "1"},
    paths: {
      "/maybe": {
        get: {
          operationId: "getMaybe",
          responses: {
            "200": {
              description: "Optional object",
              content: {
                "application/json": {
                  schema: {type: ["object", "null"], properties: {id: {type: "string"}}},
                },
              },
            },
          },
        },
      },
      "/record": {
        get: {
          operationId: "getRecord",
          responses: {
            "200": {
              description: "Record",
              content: {
                "application/json": {
                  schema: {
                    type: "object",
                    required: ["label", "items", "choice", "anything"],
                    properties: {
                      label: {"$ref": "#/components/schemas/NullableString"},
                      items: {"$ref": "#/components/schemas/Items"},
                      choice: {type: ["string", "integer"]},
                      anything: true,
                    },
                  },
                },
              },
            },
          },
        },
      },
    },
    components: {
      schemas: {
        NullableString: {type: ["string", "null"]},
        Items: {type: "array", items: {type: "integer"}},
      },
    },
  }
  for transport in ["connector_policy", "raw"] {
    const authority = if transport == "raw" {
      "harness.net"
    } else {
      "{clock: harness.clock, net: harness.net}"
    }
    const runner = """
      import { adapter_tools, get_maybe, get_record, new_client } from "./generated"

      pipeline test_values(harness: Harness) {
        const client = new_client("https://api.example.test")
        for value in [nil, {id: "found"}] {
          harness.testing.http_mock_clear()
          harness.testing.http_mock("GET", "https://api.example.test/maybe", {
            status: 200, body: json_stringify(value),
          })
          assert_eq(get_maybe(AUTHORITY, client), value)
          assert_eq(len(harness.testing.http_mock_calls()), 1)
        }
        harness.testing.http_mock_clear()
        harness.testing.http_mock("GET", "https://api.example.test/record", {
          status: 200, body: "{\"label\":null,\"items\":[1,2],\"choice\":7,\"anything\":true}",
        })
        const record = get_record(AUTHORITY, client)
        const label: string? = record.label
        const items: list = record.items
        const choice: string | int = record.choice
        assert_eq(label, nil)
        assert_eq(items, [1, 2])
        assert_eq(choice, 7)
        assert_eq(record.anything, true)
        assert_eq(len(harness.testing.http_mock_calls()), 1)
      }
      """
    run_generated(harness, document, replace(runner, "AUTHORITY", authority), transport)
  }
}

@heavy(threads: 2)
pipeline test_server_variable_defaults(harness: Harness) {
  const document = {
    openapi: "3.1.1",
    info: {title: "Server defaults", version: "1"},
    servers: [
      {
        url: "https://{tenant}.example.test:{port}/{basePath}",
        variables: {
          tenant: {default: "demo"},
          port: {default: "8443", enum: ["8443", "443"]},
          basePath: {default: "v1/sub"},
        },
      },
    ],
    paths: {"/items": {get: {operationId: "listItems", responses: {"204": {description: "Done"}}}}},
  }
  for transport in ["connector_policy", "raw"] {
    const authority = if transport == "raw" {
      "harness.net"
    } else {
      "{clock: harness.clock, net: harness.net}"
    }
    const runner = """
      import { list_items, new_client } from "./generated"

      pipeline test_default_url(harness: Harness) {
        const client = new_client()
        assert_eq(client.base_url, "https://demo.example.test:8443/v1/sub")
        harness.testing.http_mock("GET", "https://demo.example.test:8443/v1/sub/items", {
          status: 204, body: "",
        })
        list_items(AUTHORITY, client)
        const custom = new_client("https://custom.example.test/v2")
        harness.testing.http_mock("GET", "https://custom.example.test/v2/items", {
          status: 204, body: "",
        })
        list_items(AUTHORITY, custom)
        assert_eq(len(harness.testing.http_mock_calls()), 2)
      }
      """
    run_generated(harness, document, replace(runner, "AUTHORITY", authority), transport)
  }
}

@heavy(threads: 2)
pipeline test_parameter_names_preserve_every_input(harness: Harness) {
  let parameters = []
  for name in _COLLIDING_NAMES {
    parameters = parameters
      + [{name: name, in: "query", description: name, schema: {type: "string"}}]
  }
  const document = {
    openapi: "3.1.1",
    info: {title: "Parameter names", version: "1"},
    paths: {
      "/items": {
        post: {
          operationId: "createItem",
          parameters: parameters,
          requestBody: {required: true, content: {"application/json": {schema: {type: "object"}}}},
          responses: {
            "200": {description: "Created", content: {"application/json": {schema: true}}},
          },
        },
      },
    },
  }
  for transport in ["connector_policy", "raw"] {
    const authority = if transport == "raw" {
      "harness.net"
    } else {
      "{clock: harness.clock, net: harness.net}"
    }
    const runner = """
      import { adapter_tools, new_client } from "./generated"

      pipeline test_inputs(harness: Harness) {
        const client = new_client("https://api.example.test")
        const registry = adapter_tools(AUTHORITY, client)
        const tool = registry.tools[0]
        let args: dict = {body: {name: "widget"}}
        let pairs = []
        for entry in tool.parameters {
          if entry.key != "body" {
            const name = entry.value.schema.description
            args = {...args, [entry.key]: name}
            pairs = pairs + [name + "=" + name]
          }
        }
        assert_eq(len(tool.parameters), 16)
        const url = "https://api.example.test/items?" + join(pairs, "&")
        harness.testing.http_mock("POST", url, {status: 200, body: "{\"id\":1}"})
        assert_eq(tool.handler(args).data, {id: 1})
        const calls = harness.testing.http_mock_calls({include_sensitive: true})
        assert_eq(len(calls), 1)
        assert_eq(len(split(split(calls[0].url, "?")[1], "&")), 15)
        for pair in pairs { assert(contains(calls[0].url, pair)) }
        assert_eq(json_parse(calls[0].body), {name: "widget"})
      }
      """
    run_generated(harness, document, replace(runner, "AUTHORITY", authority), transport)
  }
}

@heavy(threads: 2)
pipeline test_json_without_schema_accepts_all_json_values(harness: Harness) {
  const document = {
    openapi: "3.1.1",
    info: {title: "JSON without schema", version: "1"},
    paths: {
      "/value": {
        get: {
          operationId: "getValue",
          responses: {"200": {description: "JSON", content: {"application/json": {}}}},
        },
      },
      "/empty": {
        get: {
          operationId: "getEmpty",
          responses: {"200": {description: "JSON", content: {"application/json": {schema: {}}}}},
        },
      },
    },
  }
  for transport in ["connector_policy", "raw"] {
    const authority = if transport == "raw" {
      "harness.net"
    } else {
      "{clock: harness.clock, net: harness.net}"
    }
    const runner = """
      import { adapter_tools, get_empty, get_value, new_client } from "./generated"

      pipeline test_values(harness: Harness) {
        const client = new_client("https://api.example.test")
        const tools = adapter_tools(AUTHORITY, client).tools
        assert_eq(len(tools), 2)
        for value in [[1, 2], "ready", 42, true, nil, {id: 1}] {
          harness.testing.http_mock_clear()
          harness.testing.http_mock("GET", "https://api.example.test/value", {
            status: 200, body: json_stringify(value),
          })
          harness.testing.http_mock("GET", "https://api.example.test/empty", {
            status: 200, body: json_stringify(value),
          })
          assert_eq(get_value(AUTHORITY, client), value)
          assert_eq(get_empty(AUTHORITY, client), value)
          for tool in tools { assert_eq(tool.handler({}).data, value) }
          assert_eq(len(harness.testing.http_mock_calls()), 4)
        }
      }
      """
    run_generated(harness, document, replace(runner, "AUTHORITY", authority), transport)
  }
}
