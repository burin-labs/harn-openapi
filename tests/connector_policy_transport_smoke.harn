// connector_policy_transport_smoke — issue #69 coverage for the default
// generated transport that routes SDK calls through std/connectors/shared.
import { codegen_module, parse } from "../src/lib"

fn harn_cmd(env: HarnessEnv, args: string) -> string {
  const bin = env.get("HARN_BIN")
  if bin != nil && bin != "" {
    return bin + " " + args
  }
  return "harn " + args
}

fn scratch_path(harness: {fs: HarnessFs, random: HarnessRandom}, label: string) -> string {
  const root = harness.fs.source_dir() + "/../.harn/tmp"
  harness.fs.mkdir(root)
  return root + "/" + label + "-" + harness.random.uuid()
}

fn require_contains(stdio: HarnessStdio, haystack: string, needle: string, label: string) {
  if !contains(haystack, needle) {
    stdio.println("---BEGIN GENERATED SOURCE---")
    stdio.println(haystack)
    stdio.println("---END GENERATED SOURCE---")
    require false, "${label}: expected source to contain \"${needle}\""
  }
}

fn require_not_contains(stdio: HarnessStdio, haystack: string, needle: string, label: string) {
  if contains(haystack, needle) {
    stdio.println("---BEGIN GENERATED SOURCE---")
    stdio.println(haystack)
    stdio.println("---END GENERATED SOURCE---")
    require false, "${label}: expected source NOT to contain \"${needle}\""
  }
}

fn check_generates(harness: Harness, src: string) -> string {
  const module_stem = scratch_path(
    {fs: harness.fs, random: harness.random},
    "harn-openapi-connector-policy",
  )
  const module_path = module_stem + ".harn"
  harness.fs.write_text(module_path, src)
  const check_result = harness.process.shell(harn_cmd(harness.env, "check " + module_path))
  if !check_result.success {
    harness.stdio.println("---harn check stderr---")
    harness.stdio.println(check_result.stderr)
    harness.stdio.println("---harn check stdout---")
    harness.stdio.println(check_result.stdout)
  }
  require check_result.success, "generated connector-policy SDK must pass `harn check`"
  const fmt_result = harness.process.shell(harn_cmd(harness.env, "fmt --check " + module_path))
  if !fmt_result.success {
    harness.stdio.println("---harn fmt --check stderr---")
    harness.stdio.println(fmt_result.stderr)
    harness.stdio.println("---harn fmt --check stdout---")
    harness.stdio.println(fmt_result.stdout)
  }
  require fmt_result.success, "generated connector-policy SDK must pass `harn fmt --check`"
  return module_stem
}

fn run_generated(harness: Harness, module_stem: string) {
  const runner_path = scratch_path(
    {fs: harness.fs, random: harness.random},
    "harn-openapi-connector-policy-runtime",
  )
    + ".harn"
  harness.fs.write_text(
    runner_path,
    "import {\n"
      + "  create_item,\n"
      + "  create_optional_item,\n"
      + "  create_unsafe_item,\n"
      + "  invalid_json,\n"
      + "  list_items,\n"
      + "  new_client,\n"
      + "  rate_limit_metadata,\n"
      + "} from \""
      + module_stem
      + "\"\n\n"
      + "@test\n"
      + "pipeline default(harness: Harness) {\n"
      + "  let client = new_client(\"https://api.example.com\")\n"
      + "  let rates = rate_limit_metadata()\n"
      + "  assert_eq(rates[0].operation_id, \"listItems\")\n"
      + "  assert(rates[0].remaining_headers.contains(\"RateLimit-Remaining\"), \"standard rate-limit metadata should be emitted\")\n"
      + "  harness.testing.http_mock_clear()\n"
      + "  harness.testing.http_mock(\"GET\", \"https://api.example.com/items\", {responses: [{status: 503, body: \"busy\"}, {status: 200, body: \"{\\\"results\\\":[]}\"}]})\n"
      + "  let page = list_items({clock: harness.clock, net: harness.net}, client)\n"
      + "  let list_calls = harness.testing.http_mock_calls({include_sensitive: true})\n"
      + "  assert_eq(type_of(page.results), \"list\")\n"
      + "  assert_eq(len(list_calls), 2)\n"
      + "  harness.testing.http_mock_clear()\n"
      + "  harness.testing.http_mock(\"POST\", \"https://api.example.com/items/create\", {responses: [{status: 503, body: \"busy\"}, {status: 201, body: \"{\\\"id\\\":\\\"created\\\"}\"}]})\n"
      + "  let created = create_item({clock: harness.clock, net: harness.net}, client, \"idem-1\", {name: \"thing\"})\n"
      + "  let create_calls = harness.testing.http_mock_calls({include_sensitive: true})\n"
      + "  assert_eq(created.id, \"created\")\n"
      + "  assert_eq(len(create_calls), 2)\n"
      + "  assert_eq(create_calls[0].headers[\"idempotency-key\"], \"idem-1\")\n"
      + "  harness.testing.http_mock_clear()\n"
      + "  harness.testing.http_mock(\"POST\", \"https://api.example.com/items/unsafe\", {responses: [{status: 503, body: \"busy\"}, {status: 201, body: \"{\\\"id\\\":\\\"unsafe\\\"}\"}]})\n"
      + "  let unsafe_caught = try { create_unsafe_item({clock: harness.clock, net: harness.net}, client, {name: \"unsafe\"}); nil } catch (e) { e }\n"
      + "  let unsafe_calls = harness.testing.http_mock_calls({include_sensitive: true})\n"
      + "  assert_eq(type_of(unsafe_caught), \"dict\")\n"
      + "  assert_eq(unsafe_caught.category, \"overloaded\")\n"
      + "  assert_eq(len(unsafe_calls), 1)\n"
      + "  harness.testing.http_mock_clear()\n"
      + "  harness.testing.http_mock(\"POST\", \"https://api.example.com/items/optional\", {responses: [{status: 204, body: \"\"}, {status: 204, body: \"\"}]})\n"
      + "  let no_body = create_optional_item({clock: harness.clock, net: harness.net}, client)\n"
      + "  let with_body = create_optional_item({clock: harness.clock, net: harness.net}, client, {name: \"optional\"})\n"
      + "  let optional_calls = harness.testing.http_mock_calls({include_sensitive: true})\n"
      + "  assert_eq(no_body, nil)\n"
      + "  assert_eq(with_body, nil)\n"
      + "  assert_eq(len(optional_calls), 2)\n"
      + "  assert_eq(optional_calls[0].get(\"body\"), nil)\n"
      + "  assert_eq(json_parse(optional_calls[1].body).name, \"optional\")\n"
      + "  harness.testing.http_mock_clear()\n"
      + "  harness.testing.http_mock(\"GET\", \"https://api.example.com/items/invalid-json\", {status: 200, body: \"not json\"})\n"
      + "  let invalid_caught = try { invalid_json({clock: harness.clock, net: harness.net}, client); nil } catch (e) { e }\n"
      + "  assert_eq(type_of(invalid_caught), \"dict\")\n"
      + "  assert_eq(invalid_caught.category, \"invalid_json\")\n"
      + "  assert_eq(invalid_caught.status, 200)\n"
      + "  assert_eq(invalid_caught.operation, \"invalid_json\")\n"
      + "  harness.stdio.println(\"connector_policy runtime: ok\")\n"
      + "}\n",
  )
  const result = harness.process.shell(
    harn_cmd(harness.env, "run --allow-process-network " + runner_path),
  )
  if !result.success {
    harness.stdio.println("---connector-policy runtime stderr---")
    harness.stdio.println(result.stderr)
    harness.stdio.println("---connector-policy runtime stdout---")
    harness.stdio.println(result.stdout)
  }
  require result.success, "generated connector-policy SDK runtime assertions must pass"
}

fn build_json_only_doc() -> string {
  return json_stringify(
    {
      openapi: "3.1.0",
      info: {title: "JSON-only API", version: "0.0.1"},
      servers: [{url: "https://api.example.com"}],
      paths: {
        "/items": {
          get: {
            operationId: "list-items",
            responses: {
              "200": {description: "ok", content: {"application/json": {schema: {type: "object"}}}},
            },
          },
        },
      },
    },
  )
}

@test
pipeline test_main(harness: Harness) {
  const raw = harness.fs.read_text(
    harness.fs.source_dir() + "/fixtures/connector_policy.openapi.json",
  )
  const doc = parse(raw)
  const src = codegen_module(
    harness.fs,
    doc,
    {module_name: "connector_policy", client_name: "Client"},
  )
  require_contains(
    harness.stdio,
    src,
    "import { connector_http_json, connector_http_request } from \"std/connectors/shared\"",
    "connector helper import",
  )
  require_contains(
    harness.stdio,
    src,
    "harness: {clock: HarnessClock, net: HarnessNet}",
    "connector operation capability",
  )
  require_not_contains(
    harness.stdio,
    src,
    "pub fn list_items(\n    harness: Harness",
    "connector operations should not require the root harness",
  )
  require_contains(
    harness.stdio,
    src,
    "connector_http_json(\n    harness.clock,\n    harness.net,\n    \"GET\"",
    "GET connector transport",
  )
  require_contains(
    harness.stdio,
    src,
    "connector_http_json(\n    harness.clock,\n    harness.net,\n    \"POST\"",
    "POST connector transport",
  )
  require_contains(
    harness.stdio,
    src,
    "connector_http_request(\n      harness.clock,\n      harness.net,\n      \"POST\"",
    "opaque connector transport",
  )
  require_contains(harness.stdio, src, "idempotency_key: idempotency_key", "idempotency option")
  require_contains(harness.stdio, src, "retry: {max_attempts: 3}", "bounded retry option")
  require_contains(harness.stdio, src, "retry: {max_attempts: 1}", "unsafe write no-retry option")
  require_not_contains(
    harness.stdio,
    src,
    "http_get(",
    "default GET transport should not use raw HTTP",
  )
  require_not_contains(
    harness.stdio,
    src,
    "http_post(",
    "default POST transport should not use raw HTTP",
  )
  const module_stem = check_generates(harness, src)
  run_generated(harness, module_stem)
  const raw_src = codegen_module(
    harness.fs,
    doc,
    {module_name: "raw_policy_fixture", client_name: "Client", transport: "raw"},
  )
  require_not_contains(
    harness.stdio,
    raw_src,
    "std/connectors/shared",
    "raw transport should not import connector helpers",
  )
  require_contains(harness.stdio, raw_src, "net: HarnessNet", "raw operation capability")
  require_contains(
    harness.stdio,
    raw_src,
    "net.request(\"GET\"",
    "explicit raw transport emits net GET",
  )
  require_contains(
    harness.stdio,
    raw_src,
    "if resp.status < 200 || resp.status >= 300",
    "raw transport must treat every non-2xx status as an error",
  )
  require_not_contains(
    harness.stdio,
    raw_src,
    "pub fn list_items(harness: Harness",
    "raw transport should not require unrelated harness capabilities",
  )
  check_generates(harness, raw_src)
  const json_only_src = codegen_module(
    harness.fs,
    parse(build_json_only_doc()),
    {module_name: "json_only_policy", client_name: "Client"},
  )
  require_contains(
    harness.stdio,
    json_only_src,
    "import { connector_http_json } from \"std/connectors/shared\"",
    "JSON-only connector import",
  )
  require_not_contains(
    harness.stdio,
    json_only_src,
    "connector_http_request",
    "JSON-only generated SDK should not import unused opaque connector helper",
  )
  check_generates(harness, json_only_src)
  harness.stdio.println("connector_policy_transport_smoke: ok")
}
