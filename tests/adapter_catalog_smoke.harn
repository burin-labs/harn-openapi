// Canonical OpenAPI -> ToolRegistry -> static catalog / CLI / MCP proof.
import { codegen_module, parse } from "../src/lib"

fn harn_cmd(env: HarnessEnv) -> string {
  return env.get("HARN_BIN") ?? "harn"
}

fn scratch_path(harness: {fs: HarnessFs, random: HarnessRandom}, label: string) -> string {
  const root = harness.fs.source_dir() + "/../.harn/tmp"
  harness.fs.mkdir(root)
  return root + "/" + label + "-" + harness.random.uuid()
}

fn generated_runner(module_path: string, server_path: string) -> string {
  return "import { agent_dispatch_tool_call } from \"std/agent/primitives\"\n"
    + "import { adapter_catalog, adapter_tools, new_client } from \"" + module_path + "\"\n\n"
    + "@test\n" + "pipeline default(harness: Harness) {\n"
    + "  const client = new_client(\"https://api.example.test\")\n"
    + "  const registry = adapter_tools({clock: harness.clock, net: harness.net}, client)\n"
    + "  assert_eq(len(registry.tools), 1)\n"
    + "  const catalog = adapter_catalog({clock: harness.clock, net: harness.net}, client)\n"
    + "  assert_eq(catalog.schema_version, \"harn-tools/1.0\")\n"
    + "  assert_eq(catalog.info.name, \"widgets\")\n"
    + "  assert_eq(catalog.info.version, \"2026-08-29\")\n"
    + "  assert_eq(catalog.tools[0].cli.command, [\"widgets\", \"lookup_widget\"])\n"
    + "  assert_eq(catalog.tools[0].icons[0].src, \"https://api.example.test/assets/widget.svg\")\n"
    + "  assert_eq(catalog.tools[0].icons[0].theme, \"light\")\n"
    + "  assert_eq(catalog.tools[0].execution.taskSupport, \"optional\")\n"
    + "  assert_eq(catalog.tools[0].policy.kind, \"fetch\")\n"
    + "  assert_eq(catalog.tools[0].source.binding.method, \"GET\")\n"
    + "  const registered = registry.tools[0]\n"
    + "  assert_eq(registered.name, \"lookup_widget\")\n"
    + "  assert_eq(registered.namespace, \"widgets\")\n"
    + "  assert_eq(registered.defer_loading, true)\n"
    + "  assert_eq(registered.icons[0].mimeType, \"image/svg+xml\")\n"
    + "  assert_eq(registered.execution.taskSupport, \"optional\")\n"
    + "  assert_eq(registered.parameters.widget_id.required, true)\n"
    + "  assert_eq(registered.outputSchema.required, [\"id\", \"label\"])\n"
    + "  harness.testing.http_mock_clear()\n"
    + "  harness.testing.http_mock(\"GET\", \"https://api.example.test/widgets/w%201?verbose=true\", {status: 200, body: \"{\\\"id\\\":\\\"w 1\\\",\\\"label\\\":\\\"Widget One\\\"}\"})\n"
    + "  const called = agent_dispatch_tool_call(harness.tools, {name: \"lookup_widget\", arguments: {widget_id: \"w 1\", verbose: true}}, registry)\n"
    + "  if !called.ok { harness.stdio.println(json_stringify(called)) }\n"
    + "  assert(called.ok, \"generated registry handler should dispatch\")\n"
    + "  assert(called.rendered_result.contains(\"Widget One\"), \"generated SDK result should return\")\n"
    + "  const mcp = harness.tools.mcp_connect(harness.env.get(\"HARN_BIN\") ?? \"harn\", [\"serve\", \"mcp\", \""
    + server_path + "\"])\n" + "  const discovered = harness.tools.mcp_list_tools(mcp)\n"
    + "  assert_eq(discovered.count, 1)\n" + "  assert_eq(discovered[0].name, \"lookup_widget\")\n"
    + "  assert_eq(discovered[0].inputSchema.required, [\"widget_id\"])\n"
    + "  assert_eq(discovered[0].outputSchema.required, [\"id\", \"label\"])\n"
    + "  assert_eq(discovered[0].annotations.readOnlyHint, true)\n"
    + "  assert_eq(discovered[0].annotations.openWorldHint, false)\n"
    + "  assert_eq(discovered[0].icons[0].sizes, [\"any\"])\n"
    + "  assert_eq(discovered[0]._meta[\"com.burin.harn/audience\"], \"developer\")\n"
    + "  harness.tools.mcp_disconnect(mcp)\n"
    + "  const rpc_input = json_stringify({jsonrpc: \"2.0\", id: 1, method: \"initialize\", params: {protocolVersion: \"2025-11-25\", capabilities: {}, clientInfo: {name: \"harn-openapi-test\", version: \"1\"}}}) + \"\\n\" + json_stringify({jsonrpc: \"2.0\", method: \"notifications/initialized\", params: {}}) + \"\\n\" + json_stringify({jsonrpc: \"2.0\", id: 2, method: \"tools/list\", params: {}}) + \"\\n\"\n"
    + "  const wire = harness.process.run({program: harness.env.get(\"HARN_BIN\") ?? \"harn\", args: [\"serve\", \"mcp\", \""
    + server_path + "\"], stdin: rpc_input})\n"
    + "  require wire.success, \"generated MCP server must complete a raw stdio exchange: \" + wire.stderr\n"
    + "  let wire_tools = nil\n" + "  for line in wire.stdout.lines() {\n"
    + "    const message = json_parse(line)\n"
    + "    if message.get(\"id\") == 2 { wire_tools = message.result.tools }\n" + "  }\n"
    + "  require wire_tools != nil, \"raw tools/list response must be observed\"\n"
    + "  assert_eq(wire_tools[0].icons[0].sizes, [\"any\"])\n"
    + "  assert_eq(wire_tools[0].execution.taskSupport, \"optional\")\n"
    + "  const help = harness.process.run({program: harness.env.get(\"HARN_BIN\") ?? \"harn\", args: [\"tool\", \"run\", \""
    + server_path + "\", \"--help\"]})\n"
    + "  assert(help.success, \"generated CLI help should succeed\")\n"
    + "  assert(help.stdout.contains(\"widgets\"), \"generated CLI should expose the tag group\")\n"
    + "  const cli = harness.process.run({program: harness.env.get(\"HARN_BIN\") ?? \"harn\", args: [\"tool\", \"run\", \""
    + server_path
    + "\", \"widgets\", \"lookup_widget\", \"--widget-id\", \"w 1\", \"--verbose\", \"true\", \"--harn-output\", \"json\"]})\n"
    + "  require cli.success, \"generated CLI dispatch should succeed: \" + cli.stderr\n"
    + "  const cli_result = json_parse(cli.stdout.trim())\n"
    + "  assert_eq(cli_result.id, \"w 1\")\n" + "  assert_eq(cli_result.label, \"Widget One\")\n"
    + "}\n"
}

fn generated_server(module_path: string) -> string {
  return "import { adapter_tools, new_client } from \""
    + module_path
    + "\"\n\n"
    + "pipeline main(harness: Harness) {\n"
    + "  harness.testing.http_mock_clear()\n"
    + "  harness.testing.http_mock(\"GET\", \"https://api.example.test/widgets/w%201?verbose=true\", {status: 200, body: \"{\\\"id\\\":\\\"w 1\\\",\\\"label\\\":\\\"Widget One\\\"}\"})\n"
    + "  const client = new_client(\"https://api.example.test\")\n"
    + "  harness.tools.mcp_tools(adapter_tools({clock: harness.clock, net: harness.net}, client))\n"
    + "}\n"
}

fn extension_error(fs: HarnessFs, raw: string, extension: any) -> string {
  let malformed = json_parse(raw)
  malformed.paths["/widgets/{widget-id}"].get["x-harn"] = extension
  const rejected = try {
    codegen_module(fs, parse(json_stringify(malformed)), {module_name: "widgets"})
    nil
  } catch (error) {
    error
  }
  return to_string(rejected)
}

@test
pipeline default(harness: Harness) {
  const raw = harness.fs.read_text(
    harness.fs.source_dir() + "/fixtures/adapter_catalog.openapi.json",
  )
  const doc = parse(raw)
  let malformed = json_parse(raw)
  malformed.paths["/widgets/{widget-id}"].get["x-harn"] = "not-an-object"
  const rejected = try {
    codegen_module(harness.fs, parse(json_stringify(malformed)), {module_name: "widgets"})
    nil
  } catch (error) {
    error
  }
  require to_string(rejected).contains("x-harn on 'get-widget' must be an object"),
    "malformed extensions must fail before code generation"
  const invalid_extensions = [
    {
      extension: {icons: {src: "https://example.test/icon.svg"}},
      expected: "x-harn.icons on 'get-widget' must be a list",
    },
    {
      extension: {icons: [{theme: "light"}]},
      expected: "x-harn.icons[0].src on 'get-widget' must be a non-empty string",
    },
    {
      extension: {icons: [{src: "https://example.test/icon.svg", color: "blue"}]},
      expected: "unknown x-harn.icons[0] field 'color' on 'get-widget'",
    },
    {
      extension: {icons: [{src: "https://example.test/icon.svg", sizes: ["32x32", 64]}]},
      expected: "x-harn.icons[0].sizes on 'get-widget' must be a list of non-empty strings",
    },
    {
      extension: {icons: [{src: "https://example.test/icon.svg", theme: "system"}]},
      expected: "x-harn.icons[0].theme on 'get-widget' must be 'light' or 'dark'",
    },
    {
      extension: {execution: "optional"},
      expected: "x-harn.execution on 'get-widget' must be an object",
    },
    {
      extension: {execution: {taskSupport: "sometimes"}},
      expected:
        "x-harn.execution.taskSupport on 'get-widget' must be 'forbidden', 'optional', or 'required'",
    },
    {
      extension: {execution: {taskSupport: "optional", retry: true}},
      expected: "unknown x-harn.execution field 'retry' on 'get-widget'",
    },
  ]
  for invalid in invalid_extensions {
    const message = extension_error(harness.fs, raw, invalid.extension)
    require message.contains(invalid.expected),
      "invalid extension must fail at its exact field: "
      + invalid.expected
      + "; got "
      + message
  }
  let duplicate = json_parse(raw)
  duplicate.paths["/internal/reindex"].post["x-harn"] = {
    expose: true,
    name: "lookup_widget",
    cli: {command: ["widgets", "get"]},
  }
  const duplicate_rejected = try {
    codegen_module(harness.fs, parse(json_stringify(duplicate)), {module_name: "widgets"})
    nil
  } catch (error) {
    error
  }
  require to_string(duplicate_rejected).contains("duplicate generated tool name 'lookup_widget'"),
    "adapter collisions must fail while the OpenAPI source is still identifiable"
  const module_path = scratch_path(
    {fs: harness.fs, random: harness.random},
    "harn-openapi-adapter-module",
  )
    + ".harn"
  const server_path = scratch_path(
    {fs: harness.fs, random: harness.random},
    "harn-openapi-adapter-server",
  )
    + ".harn"
  const runner_path = scratch_path(
    {fs: harness.fs, random: harness.random},
    "harn-openapi-adapter-runner",
  )
    + ".harn"
  harness.fs.write_text(
    module_path,
    codegen_module(harness.fs, doc, {module_name: "widgets", client_name: "WidgetClient"}),
  )
  harness.fs.write_text(server_path, generated_server(module_path))
  harness.fs.write_text(runner_path, generated_runner(module_path, server_path))
  const result = harness.process.shell(harn_cmd(harness.env) + " test " + runner_path)
  if !result.success {
    harness.stdio.println(result.stderr)
    harness.stdio.println(result.stdout)
  }
  require result.success, "generated adapter and MCP discovery path must pass"
}
