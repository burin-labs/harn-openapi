import { codegen_harn_toml, codegen_module, parse } from "../src/lib"

type LiteralDependency = {
  path: string,
  git: string,
  rev: string,
  branch: string,
  tag: string,
  version: string,
}

type LiteralManifest = {
  package: {description: string},
  exports: {default: string, types: string, entrypoint: string},
  dependencies: dict<string, LiteralDependency>,
}

pipeline test_generated_headers_preserve_literal_data(harness: Harness) {
  const document = parse(
    json_stringify(
      {
        openapi: "3.1.1",
        info: {title: "Literal data", version: "1"},
        paths: {
          "/echo": {
            post: {
              operationId: "send",
              requestBody: {
                required: true,
                content: {
                  "application/json": {
                    schema: {
                      type: "object",
                      properties: {value: {type: "string"}},
                      required: ["value"],
                    },
                  },
                },
              },
              responses: {"204": {description: "accepted"}},
            },
          },
        },
      },
    ),
  )
  const directory = harness.fs.mkdtemp_in_workspace("openapi-literals")
  const headers = {
    "X-Literal": "\${1 + 1}",
    "X-Quoted": "a \"quote\" and \\backslash",
    "X-Unicode": "plain Δ text",
  }
  harness.fs.write_text("${directory}/expected.json", json_stringify(headers))
  for transport in ["raw", "connector_policy"] {
    const source = codegen_module(
      harness.fs,
      document,
      {
        module_name: "literal_fixture",
        client_name: "LiteralClient",
        default_base_url: "https://literal.example.test",
        transport: transport,
        header_overrides: headers,
      },
    )
    harness.fs.write_text("${directory}/generated.harn", source)
    const authority = if transport == "raw" {
      "harness.net"
    } else {
      "{clock: harness.clock, net: harness.net}"
    }
    harness.fs.write_text(
      "${directory}/runner.harn",
      """
      import { adapter_registry, new_client, send } from "./generated"

      pipeline test_actual_request(harness: Harness) {
        const expected = json_parse(harness.fs.read_text(harness.fs.source_dir() + "/expected.json"))
        harness.testing.http_mock("POST", "https://literal.example.test/echo", {status: 204, headers: {}, body: ""})
        send(${authority}, new_client(), {value: "positive"})
        const calls = harness.testing.http_mock_calls({include_sensitive: true})
        assert_eq(len(calls), 1)
        assert_eq(calls[0].body, "{\"value\":\"positive\"}")
        assert_eq(calls[0].headers.get("x-literal"), expected["X-Literal"])
        assert_eq(calls[0].headers.get("x-quoted"), expected["X-Quoted"])
        assert_eq(calls[0].headers.get("x-unicode"), expected["X-Unicode"])
        send(${authority}, new_client("https://literal.example.test", {}, {}), {value: "explicit-empty"})
        const registry = adapter_registry({clock: harness.clock, net: harness.net}, {
          base_url: "https://literal.example.test", credentials: {}, extra_headers: {},
        })
        registry.tools[0].handler({body: {value: "registry"}})
        const inherited = harness.testing.http_mock_calls({include_sensitive: true})
        assert_eq(len(inherited), 3)
        for index in [1, 2] {
          assert_eq(inherited[index].headers.get("x-literal"), expected["X-Literal"])
          assert_eq(inherited[index].headers.get("x-quoted"), expected["X-Quoted"])
          assert_eq(inherited[index].headers.get("x-unicode"), expected["X-Unicode"])
        }
        send(${authority}, new_client("https://literal.example.test", {}, {"X-Literal": "caller", "X-Added": "new"}), {value: "override"})
        const overridden = harness.testing.http_mock_calls({include_sensitive: true})
        assert_eq(len(overridden), 4)
        assert_eq(overridden[3].headers.get("x-literal"), "caller")
        assert_eq(overridden[3].headers.get("x-added"), "new")
        assert_eq(overridden[3].headers.get("x-quoted"), expected["X-Quoted"])
        assert_eq(overridden[3].headers.get("x-unicode"), expected["X-Unicode"])
      }
      """,
    )
    const result = harness.process.run(
      {program: harness.env.get("HARN_BIN") ?? "harn", args: ["test", "${directory}/runner.harn"]},
    )
    assert(
      result.success,
      "${transport} must preserve literal source data: ${result.stdout} ${result.stderr}",
    )
  }
}

pipeline test_generated_manifest_preserves_literal_data() {
  const literal = "literal \${1 + 1} with \"quotes\" and \\backslash"
  const path = "src/\${name}.harn"
  const source = codegen_harn_toml(
    {
      package_name: "literal-fixture",
      description: literal,
      default_export: path,
      types_export: path,
      entrypoint_export: path,
      dependencies: {
        "dependency\${name}": {
          path: literal,
          git: literal,
          rev: literal,
          branch: literal,
          tag: literal,
          version: literal,
        },
      },
    },
  )
  const manifest = schema_expect(toml_parse(source), LiteralManifest)
  assert_eq(manifest.package.description, literal)
  assert_eq(manifest.exports.default, path)
  assert_eq(manifest.exports.types, path)
  assert_eq(manifest.exports.entrypoint, path)
  const dependency = schema_expect(manifest.dependencies["dependency\${name}"], LiteralDependency)
  assert_eq(dependency.path, literal)
  assert_eq(dependency.git, literal)
  assert_eq(dependency.rev, literal)
  assert_eq(dependency.branch, literal)
  assert_eq(dependency.tag, literal)
  assert_eq(dependency.version, literal)
}
