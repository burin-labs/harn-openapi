import { codegen_module, parse } from "../src/lib"

@test
pipeline multipart_header_contracts_refuse_unsupported_serialization_before_generation(
  harness: Harness,
) {
  for control in [
    {header: {schema: {type: "array", items: {type: "integer"}}}, reason: "declared scalar schema"},
    {header: {schema: {type: "object"}}, reason: "declared scalar schema"},
    {
      header: {content: {"application/json": {schema: {type: "string"}}}},
      reason: "header content requires an unsupported value adapter",
    },
    {header: {schema: {type: "string"}, style: "form"}, reason: "simple serialization"},
    {header: {schema: {type: "string"}, explode: "true"}, reason: "explode must be a boolean"},
  ] {
    const document = parse(
      json_stringify(
        {
          openapi: "3.1.1",
          info: {title: "Unsupported headers", version: "1"},
          paths: {
            "/send": {
              post: {
                operationId: "send",
                requestBody: {
                  required: true,
                  content: {
                    "multipart/form-data": {
                      schema: {type: "object", properties: {file: {type: "string"}}},
                      encoding: {file: {headers: {"X-Trace": control.header}}},
                    },
                  },
                },
                responses: {"204": {description: "Saved"}},
              },
            },
          },
        },
      ),
    )
    const rejected = try {
      codegen_module(harness.fs, document, {module_name: "unsupported"})
    }
    assert(is_err(rejected))
    assert(to_string(rejected).contains("operation 'send' media 'multipart/form-data'"))
    assert(to_string(rejected).contains(control.reason), to_string(rejected))
  }
}

@test
pipeline multipart_header_references_keep_required_and_value_constraints(harness: Harness) {
  const root = harness.fs.mkdtemp_in_workspace("media-header-references")
  const word = {type: "string", minLength: 2, pattern: "^[a-z]+$"}
  for variant in [
    {name: "simple", schema: {allOf: [word, {maxLength: 4}]}},
    {
      name: "local",
      schema: {"$defs": {Word: word}, allOf: [{"$ref": "#/$defs/Word"}, {maxLength: 4}]},
    },
    {name: "component", schema: {allOf: [{"$ref": "#/components/schemas/Word"}, {maxLength: 4}]}},
  ] {
    const header = {required: true, schema: variant.schema}
    for reference in [false, true] {
      const mode = reference ? "reference" : "inline"
      const kind = "${variant.name}_${mode}"
      const selected = reference ? {"$ref": "#/components/headers/Trace"} : header
      const document = parse(
        json_stringify(
          {
            openapi: "3.1.1",
            info: {title: "Multipart header reference", version: "1"},
            servers: [{url: "https://header.test"}],
            components: {schemas: {Word: word}, headers: {Trace: header}},
            paths: {
              "/send": {
                post: {
                  operationId: "send",
                  requestBody: {
                    required: true,
                    content: {
                      "multipart/form-data": {
                        schema: {
                          "$defs": {Word: {type: "integer"}, File: {type: "string"}},
                          type: "object",
                          properties: {file: {"$ref": "#/$defs/File"}},
                          required: ["file"],
                          additionalProperties: false,
                        },
                        encoding: {
                          file: {
                            headers: {
                              "X-Trace": selected,
                              "X-Other": {
                                required: true,
                                schema: {
                                  "$defs": {Word: {type: "integer", minimum: 1}},
                                  "$ref": "#/$defs/Word",
                                },
                              },
                            },
                          },
                        },
                      },
                    },
                  },
                  responses: {"204": {description: "Saved"}},
                },
              },
            },
          },
        ),
      )
      const module = "${root}/${kind}.harn"
      harness.fs.write_text(
        module,
        codegen_module(harness.fs, document, {module_name: kind, transport: "raw"}),
      )
      const server = "${root}/${kind}-server.harn"
      harness.fs.write_text(
        server,
        """
      import { adapter_catalog, new_client } from "./${kind}"

      fn main(harness: Harness) {
        const catalog = adapter_catalog(harness.net, new_client())
        assert_eq(len(catalog.tools), 1)
        const generated = catalog.tools[0]
        require generated != nil, "the generated operation must be present"
        let registry = tool_registry()
        registry = tool_define(registry, "check", "Validate the generated multipart contract", {
          input_schema: generated.inputSchema,
          handler: { args -> {reached: true} },
        })
        harness.tools.mcp_tools(registry)
      }
      """,
      )
      for control in [
        {name: "present", headers: {"X-Trace": "ok", "X-Other": 7}, accepted: true},
        {name: "missing", headers: {"X-Other": 7}, accepted: false},
        {name: "short", headers: {"X-Trace": "x", "X-Other": 7}, accepted: false},
        {name: "pattern", headers: {"X-Trace": "LONG", "X-Other": 7}, accepted: false},
        {name: "long", headers: {"X-Trace": "longer", "X-Other": 7}, accepted: false},
        {name: "other_root", headers: {"X-Trace": "ok", "X-Other": "wrong"}, accepted: false},
      ] {
        const input = "${root}/${kind}-${control.name}.json"
        harness.fs.write_text(
          input,
          json_stringify({body: {file: {value: "payload", headers: control.headers}}}),
        )
        const result = harness.process.run(
          {
            program: harness.env.get("HARN_BIN") ?? "harn",
            args: ["tool", "run", server, "check", "--harn-input", "@${input}", "--json"],
          },
        )
        assert_eq(
          result.success,
          control.accepted,
          "${kind}/${control.name}: ${result.stdout}${result.stderr}",
        )
        if control.accepted {
          assert_eq(json_parse(result.stdout), {reached: true})
        }
      }
    }
  }
}
