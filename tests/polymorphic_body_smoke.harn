// Variant constructors produce the declared wire fields without private tags.
import { codegen_module, parse } from "../src/lib"

fn harn_cmd(env: HarnessEnv, args: string) -> string {
  const bin = env.get("HARN_BIN")
  if bin != nil && bin != "" {
    return bin + " " + args
  }
  return "harn " + args
}

fn scratch_path(harness: {fs: HarnessFs, random: HarnessRandom}, label: string) -> string {
  const root = harness.fs.source_dir() + "/../.harn/tmp"
  harness.fs.mkdir(root)
  return root + "/" + label + "-" + harness.random.uuid()
}

const _POLY_DOC = """
  {
    "openapi": "3.1.0",
    "info": { "title": "Polymorphic API", "version": "1.0.0" },
    "servers": [{"url": "https://api.example.com"}],
    "paths": {
      "/pets/{pet_id}": {
        "patch": {
          "operationId": "update-pet",
          "parameters": [
            {"name": "pet_id", "in": "path", "required": true,
             "schema": {"type": "string"}}
          ],
          "requestBody": {
            "required": true,
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {"$ref": "#/components/schemas/CatUpdate"},
                    {"$ref": "#/components/schemas/DogUpdate"}
                  ],
                  "discriminator": {
                    "propertyName": "kind",
                    "mapping": {
                      "cat": "#/components/schemas/CatUpdate",
                      "dog": "#/components/schemas/DogUpdate"
                    }
                  }
                }
              }
            }
          },
          "responses": {
            "200": {
              "description": "ok",
              "content": {"application/json": {"schema": {"type": "object"}}}
            }
          }
        }
      },
      "/shape": {
        "post": {
          "operationId": "submit-shape",
          "requestBody": {
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "title": "Circle Shape",
                      "type": "object",
                      "required": ["radius"],
                      "properties": {"radius": {"type": "number"}}
                    },
                    {
                      "title": "Square Shape",
                      "type": "object",
                      "required": ["side"],
                      "properties": {"side": {"type": "number"}}
                    }
                  ]
                }
              }
            }
          },
          "responses": {"204": {"description": "accepted"}}
        }
      }
    },
    "components": {
      "schemas": {
        "CatUpdate": {
          "type": "object",
          "required": ["kind", "meow"],
          "properties": {
            "kind": {"type": "string", "const": "cat"},
            "meow": {"type": "string"},
            "lives": {"type": "integer"}
          }
        },
        "DogUpdate": {
          "type": "object",
          "required": ["kind", "bark"],
          "properties": {
            "kind": {"type": "string", "const": "dog"},
            "bark": {"type": "boolean"}
          }
        }
      }
    }
  }
  """

fn check_file(harness: Harness, path: string, label: string) {
  const result = harness.process.shell(harn_cmd(harness.env, "check " + path))
  if !result.success {
    harness.stdio.println("---${label} harn check stderr---")
    harness.stdio.println(result.stderr)
    harness.stdio.println("---${label} harn check stdout---")
    harness.stdio.println(result.stdout)
  }
  require result.success, "${label}: generated module must pass harn check"
}

fn run_file(harness: Harness, path: string, label: string) {
  const result = harness.process.shell(harn_cmd(harness.env, "run --allow-process-network " + path))
  if !result.success {
    harness.stdio.println("---${label} harn run stderr---")
    harness.stdio.println(result.stderr)
    harness.stdio.println("---${label} harn run stdout---")
    harness.stdio.println(result.stdout)
  }
  require result.success, "${label}: generated module runtime smoke must pass"
}

pipeline test_main(harness: Harness) {
  const doc = parse(_POLY_DOC)
  const src = codegen_module(
    harness.fs,
    doc,
    {
      module_name: "poly",
      client_name: "PolyClient",
      default_base_url: "https://api.example.com",
      header_overrides: {},
    },
  )
  const module_stem = scratch_path(
    pick(harness, ["fs", "random"]),
    "harn-openapi-polymorphic-generated",
  )
  const out_path = module_stem + ".harn"
  harness.fs.write_text(out_path, src)
  check_file(harness, out_path, "poly")
  const runner_path = scratch_path(
    pick(harness, ["fs", "random"]),
    "harn-openapi-polymorphic-runner",
  )
    + ".harn"
  harness.fs.write_text(
    runner_path,
    "import { new_client, update_pet, update_pet_cat_update, update_pet_dog_update, submit_shape_circle_shape, submit_shape_square_shape } from \""
      + module_stem
      + "\"\n"
      + """

    pipeline default(harness: Harness) {
      harness.testing.http_mock_clear()
      harness.testing.http_mock("PATCH", "https://api.example.com/pets/p1", {
        status: 200,
        body: "{}",
        headers: {},
      })
      let client = new_client()
      let body = update_pet_cat_update("mew", 9)
      assert(body == {kind: "cat", meow: "mew", lives: 9}, "constructor returns wire fields")
      assert(update_pet_dog_update(true) == {kind: "dog", bark: true})
      assert(submit_shape_circle_shape(2.5) == {radius: 2.5})
      assert(submit_shape_square_shape(3.0) == {side: 3.0})
      update_pet({clock: harness.clock, net: harness.net}, client, "p1", body)
      let calls = harness.testing.http_mock_calls()
      assert(len(calls) == 1, "expected one mocked call")
      let sent = json_parse(calls[0].body)
      assert(sent.kind == "cat", "outbound body keeps discriminator")
      assert(sent.meow == "mew", "outbound body keeps required field")
      assert(sent.lives == 9, "outbound body keeps optional field")
      assert(sent == body, "outbound body matches constructor value")
    }
    """,
  )
  run_file(harness, runner_path, "poly")
  harness.stdio.println("polymorphic_body_smoke: ok")
}
