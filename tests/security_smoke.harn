// security_smoke — exercise per-scheme auth helpers emitted by
// codegen_module against synthetic OpenAPI docs. Each sub-scenario
// asserts the generated Harn source contains the correct auth-dispatch
// wiring and that the corresponding helper functions produce the
// expected Authorization / header / query bindings at runtime.
import { codegen_module, parse } from "../src/lib"

fn harn_cmd(env: HarnessEnv, args: string) -> string {
  const bin = env.get("HARN_BIN")
  if bin != nil && bin != "" {
    return bin + " " + args
  }
  return "harn " + args
}

fn scratch_path(harness: {fs: HarnessFs, random: HarnessRandom}, label: string) -> string {
  const root = harness.fs.source_dir() + "/../.harn/tmp"
  harness.fs.mkdir(root)
  return root + "/" + label + "-" + harness.random.uuid()
}

fn build_doc(sec_schemes: dict, doc_security: any, ops: list) -> string {
  let paths = {}
  for op in ops {
    let method_entry = {operationId: op.operation_id, responses: {"200": {description: "ok"}}}
    if op.get("security") != nil {
      method_entry = {...method_entry, security: op.security}
    }
    paths = {...paths, [op.path]: {[op.method]: method_entry}}
  }
  let root = {
    openapi: "3.1.0",
    info: {title: "Test", version: "0.0.1"},
    servers: [{url: "https://api.example.com"}],
    paths: paths,
    components: {securitySchemes: sec_schemes},
  }
  if doc_security != nil {
    root = {...root, security: doc_security}
  }
  return json_stringify(root)
}

fn require_contains(stdio: HarnessStdio, haystack: string, needle: string, label: string) {
  if !contains(haystack, needle) {
    stdio.println("---BEGIN GENERATED SOURCE---")
    stdio.println(haystack)
    stdio.println("---END GENERATED SOURCE---")
    require false, "${label}: expected source to contain \"${needle}\""
  }
}

fn require_not_contains(stdio: HarnessStdio, haystack: string, needle: string, label: string) {
  if contains(haystack, needle) {
    stdio.println("---BEGIN GENERATED SOURCE---")
    stdio.println(haystack)
    stdio.println("---END GENERATED SOURCE---")
    require false, "${label}: expected source NOT to contain \"${needle}\""
  }
}

fn check_generates(harness: Harness, src: string, label: string) {
  const tmp_path = scratch_path(
    {fs: harness.fs, random: harness.random},
    "harn-openapi-security-smoke-${label}",
  )
    + ".harn"
  harness.fs.write_text(tmp_path, src)
  const result = harness.process.shell(harn_cmd(harness.env, "check " + tmp_path))
  if !result.success {
    harness.stdio.println("---harn check stderr---")
    harness.stdio.println(result.stderr)
    harness.stdio.println("---harn check stdout---")
    harness.stdio.println(result.stdout)
  }
  require result.success, "${label}: generated SDK must pass \\`harn check\\`"
  const fmt_result = harness.process.shell(harn_cmd(harness.env, "fmt --check " + tmp_path))
  if !fmt_result.success {
    harness.stdio.println("---harn fmt --check stderr---")
    harness.stdio.println(fmt_result.stderr)
    harness.stdio.println("---harn fmt --check stdout---")
    harness.stdio.println(fmt_result.stdout)
  }
  require fmt_result.success, "${label}: generated SDK must pass \\`harn fmt --check\\`"
}

fn run_generated(harness: Harness, src: string, label: string, imports: string, body: string) {
  const module_stem = scratch_path(
    {fs: harness.fs, random: harness.random},
    "harn-openapi-security-smoke-${label}",
  )
  const module_path = module_stem + ".harn"
  const runner_path = scratch_path(
    {fs: harness.fs, random: harness.random},
    "harn-openapi-security-runtime-${label}",
  )
    + ".harn"
  harness.fs.write_text(module_path, src)
  harness.fs.write_text(
    runner_path,
    "import { "
      + imports
      + " } from \""
      + module_stem
      + "\"\n\npipeline default(harness: Harness) {\n"
      + body
      + "\n}\n",
  )
  const result = harness.process.shell(
    harn_cmd(harness.env, "run --allow-process-network " + runner_path),
  )
  if !result.success {
    harness.stdio.println("---${label} runtime stderr---")
    harness.stdio.println(result.stderr)
    harness.stdio.println("---${label} runtime stdout---")
    harness.stdio.println(result.stdout)
  }
  require result.success, "${label}: generated SDK runtime auth assertions must pass"
}

@test
pipeline test_main(harness: Harness) {
  // ------------------------------------------------------------------
  // Scenario A: http bearer at the doc level, inherited by all ops.
  // ------------------------------------------------------------------
  const doc_a = build_doc(
    {bearerAuth: {type: "http", scheme: "bearer"}},
    [{bearerAuth: []}],
    [{operation_id: "get-self", method: "get", path: "/v1/users/me"}],
  )
  const src_a = codegen_module(harness.fs, parse(doc_a), {module_name: "a", client_name: "A"})
  require_contains(harness.stdio, src_a, "_headers_bearer_auth(client)", "A/dispatch")
  require_contains(harness.stdio, src_a, "Authorization: \"Bearer \" + token", "A/bearer-helper")
  require_contains(
    harness.stdio,
    src_a,
    "credentials: dict<string, AdapterCredential> = {}",
    "A/client-has-scheme-credentials",
  )
  check_generates(harness, src_a, "A")
  run_generated(
    harness,
    src_a,
    "A",
    "new_client, get_self",
    """
      harness.testing.http_mock_clear()
      harness.testing.http_mock("GET", "https://api.example.com/v1/users/me", {status: 200, body: "{}", headers: {}})
      let client = new_client("https://api.example.com", {
        bearerAuth: {token_provider: fn() { return "bearer-token" }},
      })
      get_self({clock: harness.clock, net: harness.net}, client)
      let call = harness.testing.http_mock_calls({include_sensitive: true})[0]
      assert_eq(call.headers.authorization, "Bearer bearer-token")
    """,
  )
  run_generated(
    harness,
    src_a,
    "A-missing-token",
    "new_client, get_self",
    """
      harness.testing.http_mock_clear()
      let client = new_client("https://api.example.com")
      const rejected = try {
        get_self({clock: harness.clock, net: harness.net}, client)
        nil
      } catch (error) {
        error
      }
      assert_eq(
        to_string(rejected),
        "harn-openapi.generated: operation 'get-self' requires one of [bearerAuth]",
      )
      assert_eq(len(harness.testing.http_mock_calls({include_sensitive: true})), 0)
    """,
  )
  // ------------------------------------------------------------------
  // Scenario B: explicit security: [] on one op overrides doc default.
  // ------------------------------------------------------------------
  const doc_b = build_doc(
    {bearerAuth: {type: "http", scheme: "bearer"}},
    [{bearerAuth: []}],
    [
      {operation_id: "get-self", method: "get", path: "/v1/users/me"},
      {operation_id: "public-ping", method: "get", path: "/health", security: []},
    ],
  )
  const src_b = codegen_module(harness.fs, parse(doc_b), {module_name: "b", client_name: "B"})
  require_contains(harness.stdio, src_b, "let hs: dict =", "B/dynamic-header-map-is-typed")
  // Authed op still uses the bearer helper.
  require_contains(harness.stdio, src_b, "_headers_bearer_auth(client)", "B/authed-dispatch")
  // The no-auth selector must return before inspecting any credentials.
  require_contains(
    harness.stdio,
    src_b,
    "fn _security_public_ping(client: AdapterClient) -> dict {\n  return {headers: _no_auth_headers(client), query: {}}\n}",
    "B/public-op-must-use-no-auth-headers",
  )
  check_generates(harness, src_b, "B")
  run_generated(
    harness,
    src_b,
    "B",
    "new_client, get_self, public_ping",
    """
      harness.testing.http_mock_clear()
      harness.testing.http_mock("GET", "https://api.example.com/v1/users/me", {status: 200, body: "{}", headers: {}})
      harness.testing.http_mock("GET", "https://api.example.com/health", {status: 200, body: "{}", headers: {}})
      let client = new_client("https://api.example.com", {bearerAuth: {token: "bearer-token"}})
      get_self({clock: harness.clock, net: harness.net}, client)
      public_ping({clock: harness.clock, net: harness.net}, client)
      let calls = harness.testing.http_mock_calls({include_sensitive: true})
      assert_eq(calls[0].headers.authorization, "Bearer bearer-token")
      assert_eq(calls[1].headers.get("authorization"), nil)
    """,
  )
  // ------------------------------------------------------------------
  // Scenario C: http basic only.
  // ------------------------------------------------------------------
  const doc_c = build_doc(
    {basicAuth: {type: "http", scheme: "basic"}},
    [{basicAuth: []}],
    [{operation_id: "login", method: "post", path: "/login"}],
  )
  const src_c = codegen_module(harness.fs, parse(doc_c), {module_name: "c", client_name: "C"})
  require_contains(harness.stdio, src_c, "_headers_basic_auth(client)", "C/dispatch")
  require_contains(harness.stdio, src_c, "base64_encode", "C/basic-uses-base64")
  require_contains(harness.stdio, src_c, "Authorization: \"Basic \" + encoded", "C/basic-header")
  require_contains(harness.stdio, src_c, "username?: string", "C/client-has-basic-user")
  require_contains(harness.stdio, src_c, "password?: string", "C/client-has-basic-password")
  check_generates(harness, src_c, "C")
  run_generated(
    harness,
    src_c,
    "C",
    "new_client, login",
    """
      harness.testing.http_mock_clear()
      harness.testing.http_mock("POST", "https://api.example.com/login", {status: 200, body: "{}", headers: {}})
      let client = new_client("https://api.example.com", {basicAuth: {username: "basic-user", password: "basic-pass"}})
      login({clock: harness.clock, net: harness.net}, client)
      let call = harness.testing.http_mock_calls({include_sensitive: true})[0]
      assert_eq(call.headers.authorization, "Basic YmFzaWMtdXNlcjpiYXNpYy1wYXNz")
    """,
  )
  // ------------------------------------------------------------------
  // Scenario D: apiKey in header.
  // ------------------------------------------------------------------
  const doc_d = build_doc(
    {xApiKey: {type: "apiKey", in: "header", name: "X-Api-Key"}},
    [{xApiKey: []}],
    [{operation_id: "get-thing", method: "get", path: "/thing"}],
  )
  const src_d = codegen_module(harness.fs, parse(doc_d), {module_name: "d", client_name: "D"})
  require_contains(harness.stdio, src_d, "_headers_x_api_key(client)", "D/dispatch")
  require_contains(harness.stdio, src_d, "\"X-Api-Key\":", "D/header-name-emitted")
  require_contains(
    harness.stdio,
    src_d,
    "_client_api_key(client, \"xApiKey\")",
    "D/reads-from-api-keys",
  )
  require_contains(harness.stdio, src_d, "value?: string", "D/client-has-api-key-value")
  require_contains(
    harness.stdio,
    src_d,
    "value_provider?: fn() -> string",
    "D/client-has-provider-hook",
  )
  check_generates(harness, src_d, "D")
  run_generated(
    harness,
    src_d,
    "D",
    "new_client, get_thing",
    """
      harness.testing.http_mock_clear()
      harness.testing.http_mock("GET", "https://api.example.com/thing", {status: 200, body: "{}", headers: {}})
      let client = new_client("https://api.example.com", {xApiKey: {value: "header-key"}})
      get_thing({clock: harness.clock, net: harness.net}, client)
      let call = harness.testing.http_mock_calls({include_sensitive: true})[0]
      assert_eq(call.headers["x-api-key"], "header-key")
    """,
  )
  // ------------------------------------------------------------------
  // Scenario E: apiKey in query.
  // ------------------------------------------------------------------
  const doc_e = build_doc(
    {qKey: {type: "apiKey", in: "query", name: "api_key"}},
    [{qKey: []}],
    [{operation_id: "list-things", method: "get", path: "/things"}],
  )
  const src_e = codegen_module(harness.fs, parse(doc_e), {module_name: "e", client_name: "E"})
  require_contains(harness.stdio, src_e, "_headers_q_key(client)", "E/headers-dispatch")
  require_contains(harness.stdio, src_e, "_query_q_key_dict(client)", "E/query-spread-in-op")
  require_contains(harness.stdio, src_e, "api_key: v", "E/query-name-emitted")
  require_contains(harness.stdio, src_e, "_query_string", "E/op-has-query-string-call")
  check_generates(harness, src_e, "E")
  run_generated(
    harness,
    src_e,
    "E",
    "new_client, list_things",
    """
      harness.testing.http_mock_clear()
      harness.testing.http_mock("GET", "https://api.example.com/things?api_key=query-key", {status: 200, body: "{}", headers: {}})
      let client = new_client("https://api.example.com", {qKey: {value: "query-key"}})
      list_things({clock: harness.clock, net: harness.net}, client)
      let call = harness.testing.http_mock_calls({include_sensitive: true})[0]
      assert_eq(call.url, "https://api.example.com/things?api_key=query-key")
    """,
  )
  // ------------------------------------------------------------------
  // Scenario F: apiKey in cookie.
  // ------------------------------------------------------------------
  const doc_f = build_doc(
    {sessId: {type: "apiKey", in: "cookie", name: "sid"}},
    [{sessId: []}],
    [{operation_id: "me", method: "get", path: "/me"}],
  )
  const src_f = codegen_module(harness.fs, parse(doc_f), {module_name: "f", client_name: "F"})
  require_contains(harness.stdio, src_f, "_headers_sess_id(client)", "F/dispatch")
  require_contains(
    harness.stdio,
    src_f,
    "_append_cookie_header(hs, \"sid\", api_key)",
    "F/cookie-header",
  )
  require_contains(
    harness.stdio,
    src_f,
    "_client_api_key(client, \"sessId\")",
    "F/reads-from-api-keys",
  )
  check_generates(harness, src_f, "F")
  run_generated(
    harness,
    src_f,
    "F",
    "new_client, me",
    """
      harness.testing.http_mock_clear()
      harness.testing.http_mock("GET", "https://api.example.com/me", {status: 200, body: "{}", headers: {}})
      let client = new_client("https://api.example.com", {sessId: {value: "cookie key;admin=true"}})
      me({clock: harness.clock, net: harness.net}, client)
      let call = harness.testing.http_mock_calls({include_sensitive: true})[0]
      assert_eq(call.headers.cookie, "sid=cookie%20key%3Badmin%3Dtrue")
    """,
  )
  // ------------------------------------------------------------------
  // Scenario G: oauth2 — treated as bearer for v0 (client already holds token).
  // ------------------------------------------------------------------
  const doc_g = build_doc(
    {
      oauth2Auth: {
        type: "oauth2",
        flows: {clientCredentials: {tokenUrl: "https://api.example.com/oauth/token", scopes: {}}},
      },
    },
    [{oauth2Auth: []}],
    [{operation_id: "do-thing", method: "get", path: "/thing"}],
  )
  const src_g = codegen_module(harness.fs, parse(doc_g), {module_name: "g", client_name: "G"})
  require_contains(harness.stdio, src_g, "_headers_oauth2_auth(client)", "G/dispatch")
  require_contains(harness.stdio, src_g, "Authorization: \"Bearer \" + token", "G/bearer-shape")
  require_contains(harness.stdio, src_g, "token?: string", "G/client-has-token")
  require_contains(harness.stdio, src_g, "token_provider?: fn() -> string", "G/client-has-provider")
  check_generates(harness, src_g, "G")
  run_generated(
    harness,
    src_g,
    "G",
    "new_client, do_thing",
    """
      harness.testing.http_mock_clear()
      harness.testing.http_mock("GET", "https://api.example.com/thing", {status: 200, body: "{}", headers: {}})
      let client = new_client("https://api.example.com", {oauth2Auth: {token: "oauth-token"}})
      do_thing({clock: harness.clock, net: harness.net}, client)
      let call = harness.testing.http_mock_calls({include_sensitive: true})[0]
      assert_eq(call.headers.authorization, "Bearer oauth-token")
    """,
  )
  // ------------------------------------------------------------------
  // Scenario H: mixed schemes (bearer + basic) with per-op overrides,
  // mirroring the real-world Notion shape.
  // ------------------------------------------------------------------
  const doc_h = build_doc(
    {bearerAuth: {type: "http", scheme: "bearer"}, basicAuth: {type: "http", scheme: "basic"}},
    [{bearerAuth: []}],
    [
      {operation_id: "get-me", method: "get", path: "/v1/users/me"},
      {
        operation_id: "create-a-token",
        method: "post",
        path: "/v1/oauth/token",
        security: [{basicAuth: []}],
      },
    ],
  )
  const src_h = codegen_module(harness.fs, parse(doc_h), {module_name: "h", client_name: "H"})
  // Bearer helper defined and used by the default op.
  require_contains(harness.stdio, src_h, "fn _headers_bearer_auth(", "H/bearer-helper-defined")
  require_contains(harness.stdio, src_h, "fn _headers_basic_auth(", "H/basic-helper-defined")
  check_generates(harness, src_h, "H")
  run_generated(
    harness,
    src_h,
    "H",
    "new_client, get_me, create_a_token",
    """
      harness.testing.http_mock_clear()
      harness.testing.http_mock("GET", "https://api.example.com/v1/users/me", {status: 200, body: "{}", headers: {}})
      harness.testing.http_mock("POST", "https://api.example.com/v1/oauth/token", {status: 200, body: "{}", headers: {}})
      let client = new_client("https://api.example.com", {
        bearerAuth: {token: "bearer-token"},
        basicAuth: {username: "basic-user", password: "basic-pass"},
      })
      get_me({clock: harness.clock, net: harness.net}, client)
      create_a_token({clock: harness.clock, net: harness.net}, client)
      let calls = harness.testing.http_mock_calls({include_sensitive: true})
      assert_eq(calls[0].headers.authorization, "Bearer bearer-token")
      assert_eq(calls[1].headers.authorization, "Basic YmFzaWMtdXNlcjpiYXNpYy1wYXNz")
    """,
  )
  // ------------------------------------------------------------------
  // Scenario I: mutualTLS remains host-owned and requires an explicit
  // readiness signal instead of silently degrading to no authentication.
  // ------------------------------------------------------------------
  const doc_i = build_doc(
    {mtls: {type: "mutualTLS"}},
    [{mtls: []}],
    [{operation_id: "mtls-op", method: "get", path: "/secure"}],
  )
  const src_i = codegen_module(harness.fs, parse(doc_i), {module_name: "i", client_name: "I"})
  require_contains(
    harness.stdio,
    src_i,
    "_credential_available(client, \"mtls\", \"mutual_tls\")",
    "I/host-readiness-is-required",
  )
  check_generates(harness, src_i, "I")
  run_generated(
    harness,
    src_i,
    "I",
    "new_client, mtls_op",
    """
      harness.testing.http_mock_clear()
      let missing_client = new_client("https://api.example.com")
      const missing = try {
        mtls_op({clock: harness.clock, net: harness.net}, missing_client)
        nil
      } catch (error) {
        error
      }
      assert_eq(
        to_string(missing),
        "harn-openapi.generated: operation 'mtls-op' requires one of [mtls]",
      )
      assert_eq(len(harness.testing.http_mock_calls({include_sensitive: true})), 0)
      harness.testing.http_mock("GET", "https://api.example.com/secure", {status: 200, body: "{}", headers: {}})
      let ready_client = new_client("https://api.example.com", {mtls: {host_configured: true}})
      mtls_op({clock: harness.clock, net: harness.net}, ready_client)
      assert_eq(len(harness.testing.http_mock_calls({include_sensitive: true})), 1)
    """,
  )
  // ------------------------------------------------------------------
  // Scenario J: multiple security alternatives remain executable OR branches.
  // ------------------------------------------------------------------
  const doc_j = build_doc(
    {bearerAuth: {type: "http", scheme: "bearer"}, basicAuth: {type: "http", scheme: "basic"}},
    [{bearerAuth: []}, {basicAuth: []}],
    [{operation_id: "either-auth", method: "get", path: "/either"}],
  )
  const src_j = codegen_module(harness.fs, parse(doc_j), {module_name: "j", client_name: "J"})
  require_contains(harness.stdio, src_j, "_headers_bearer_auth(client)", "J/bearer-branch")
  require_contains(harness.stdio, src_j, "_headers_basic_auth(client)", "J/basic-branch")
  require_not_contains(harness.stdio, src_j, "TODO", "J/generated-source-has-no-todos")
  check_generates(harness, src_j, "J")
  run_generated(
    harness,
    src_j,
    "J-basic",
    "new_client, either_auth",
    """
      harness.testing.http_mock_clear()
      harness.testing.http_mock("GET", "https://api.example.com/either", {status: 200, body: "{}", headers: {}})
      let client = new_client("https://api.example.com", {
        basicAuth: {
          basic_provider: fn() { return {username: "basic-user", password: "basic-pass"} },
        },
      })
      either_auth({clock: harness.clock, net: harness.net}, client)
      let call = harness.testing.http_mock_calls({include_sensitive: true})[0]
      assert_eq(call.headers.authorization, "Basic YmFzaWMtdXNlcjpiYXNpYy1wYXNz")
    """,
  )
  run_generated(
    harness,
    src_j,
    "J-bearer",
    "new_client, either_auth",
    """
      harness.testing.http_mock_clear()
      harness.testing.http_mock("GET", "https://api.example.com/either", {status: 200, body: "{}", headers: {}})
      let client = new_client("https://api.example.com", {bearerAuth: {token: "bearer-token"}})
      either_auth({clock: harness.clock, net: harness.net}, client)
      let call = harness.testing.http_mock_calls({include_sensitive: true})[0]
      assert_eq(call.headers.authorization, "Bearer bearer-token")
    """,
  )
  harness.stdio.println("security_smoke: ok")
}
