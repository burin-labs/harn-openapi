import { AdapterJsonSchema, embed_adapter_schema } from "./adapter_schema_graph"

/** One OpenAPI response offered to the application-error model. */
pub type AdapterErrorResponseInput = {status_key: string, body_schema?: AdapterJsonSchema}

/** Deterministic HTTP status matcher retained for generated dispatch. */
pub type AdapterErrorResponse = {
  status_key: string,
  match_kind: "exact" | "range" | "default",
  exact_status?: int,
  status_min?: int,
  status_max?: int,
  discriminant: string,
  type_suffix: string,
  body_schema?: AdapterJsonSchema,
}

/** One operation's semantic owner for generated error projections. */
pub type AdapterOperationErrorModel = {
  operation_id: string,
  error_type_name: string,
  responses: list<AdapterErrorResponse>,
  error_schema: AdapterJsonSchema,
}

fn error_message(operation_id: string, detail: string) -> string {
  return "harn-openapi.codegen_module: responses on '" + operation_id + "' " + detail
}

fn reject_response(operation_id: string, detail: string) -> AdapterErrorResponse {
  throw error_message(operation_id, detail)
}

fn reject_model(operation_id: string, detail: string) -> AdapterOperationErrorModel {
  throw error_message(operation_id, detail)
}

fn exact_response(operation_id: string, input: AdapterErrorResponseInput) -> AdapterErrorResponse {
  const status = to_int(input.status_key)
  if status >= 200 && status <= 299 {
    return reject_response(
      operation_id,
      "must not pass successful status '" + input.status_key + "' to the error model",
    )
  }
  return schema_expect(
    {
      status_key: input.status_key,
      match_kind: "exact",
      exact_status: status,
      discriminant: "http_" + input.status_key,
      type_suffix: "Http" + input.status_key,
      body_schema: input.body_schema,
    },
    AdapterErrorResponse,
  )
}

fn range_response(operation_id: string, input: AdapterErrorResponseInput) -> AdapterErrorResponse {
  const status_class = to_int(substring(input.status_key, 0, 1))
  if status_class == 2 {
    return reject_response(
      operation_id,
      "must not pass successful range '" + input.status_key + "' to the error model",
    )
  }
  return schema_expect(
    {
      status_key: input.status_key,
      match_kind: "range",
      status_min: status_class * 100,
      status_max: status_class * 100 + 99,
      discriminant: "http_" + input.status_key.lower(),
      type_suffix: "Http" + input.status_key,
      body_schema: input.body_schema,
    },
    AdapterErrorResponse,
  )
}

fn normalize_response(
  operation_id: string,
  input: AdapterErrorResponseInput,
) -> AdapterErrorResponse {
  if input.status_key == "default" {
    return schema_expect(
      {
        status_key: "default",
        match_kind: "default",
        discriminant: "http_default",
        type_suffix: "HttpDefault",
        body_schema: input.body_schema,
      },
      AdapterErrorResponse,
    )
  }
  if regex_match("^[1-5][0-9][0-9]$", input.status_key) != nil {
    return exact_response(operation_id, input)
  }
  if regex_match("^[1-5]XX$", input.status_key) != nil {
    return range_response(operation_id, input)
  }
  return reject_response(operation_id, "contains invalid status key '" + input.status_key + "'")
}

fn status_schema(response: AdapterErrorResponse) -> AdapterJsonSchema {
  if response.match_kind == "exact" {
    return {const: response.exact_status, type: "integer"}
  }
  if response.match_kind == "range" {
    return {type: "integer", minimum: response.status_min, maximum: response.status_max}
  }
  return {type: "integer", minimum: 100, maximum: 599}
}

fn typed_variant_schema(
  response: AdapterErrorResponse,
  body_schema: AdapterJsonSchema,
) -> AdapterJsonSchema {
  return {
    type: "object",
    properties: {
      kind: {const: response.discriminant, type: "string"},
      status: status_schema(response),
      body: body_schema,
    },
    required: ["kind", "status", "body"],
    additionalProperties: false,
  }
}

fn fallback_schema() -> AdapterJsonSchema {
  return {
    type: "object",
    properties: {
      kind: {const: "upstream_error", type: "string"},
      status: {type: "integer", minimum: 100, maximum: 599},
      reason: {type: "string", enum: ["malformed_body", "unsupported_body", "undocumented_status"]},
    },
    required: ["kind", "status", "reason"],
    additionalProperties: false,
  }
}

fn operation_error_schema(responses: list<AdapterErrorResponse>) -> AdapterJsonSchema {
  let variants: list<AdapterJsonSchema> = []
  let definitions: dict<string, AdapterJsonSchema> = {}
  for response in responses {
    if response.body_schema != nil {
      const embedded = embed_adapter_schema(response.body_schema, response.discriminant + "_body")
      variants = variants + [typed_variant_schema(response, embedded.schema)]
      definitions = {...definitions, ...embedded.definitions}
    }
  }
  variants = variants + [fallback_schema()]
  if len(variants) == 1 {
    return variants[0]!
  }
  return {oneOf: variants, "$defs": definitions}
}

/**
 * Normalize one operation's non-success responses. Exact status codes outrank
 * status-class ranges, ranges outrank `default`, and input order is irrelevant.
 */
pub fn prepare_adapter_error_model(
  operation_id: string,
  error_type_name: string,
  inputs: list<AdapterErrorResponseInput>,
) -> AdapterOperationErrorModel {
  if operation_id.trim() == "" {
    return reject_model(operation_id, "requires a non-empty operation id")
  }
  if regex_match("^[A-Z][A-Za-z0-9_]*$", error_type_name) == nil {
    return reject_model(operation_id, "requires a valid generated error type name")
  }
  let by_key: dict<string, AdapterErrorResponseInput> = {}
  for input in inputs {
    if by_key.get(input.status_key) != nil {
      return reject_model(operation_id, "contains duplicate status key '" + input.status_key + "'")
    }
    by_key = {...by_key, [input.status_key]: input}
  }
  let exact: list<AdapterErrorResponse> = []
  let ranges: list<AdapterErrorResponse> = []
  let fallback: list<AdapterErrorResponse> = []
  for key in by_key.keys().sort() {
    const response = normalize_response(operation_id, by_key[key]!)
    if response.match_kind == "exact" {
      exact = exact + [response]
    } else if response.match_kind == "range" {
      ranges = ranges + [response]
    } else {
      fallback = fallback + [response]
    }
  }
  const responses = exact + ranges + fallback
  return {
    operation_id: operation_id,
    error_type_name: error_type_name,
    responses: responses,
    error_schema: operation_error_schema(responses),
  }
}

/** Return the documented response selected for one non-success HTTP status. */
pub fn adapter_error_response_for_status(
  model: AdapterOperationErrorModel,
  status: int,
) -> AdapterErrorResponse? {
  let range_match: AdapterErrorResponse? = nil
  let default_match: AdapterErrorResponse? = nil
  for response in model.responses {
    if response.match_kind == "exact" && response.exact_status == status {
      return response
    }
    if response.match_kind == "range"
      && status >= response.status_min
      && status <= response.status_max {
      range_match = response
    }
    if response.match_kind == "default" {
      default_match = response
    }
  }
  return range_match ?? default_match
}
