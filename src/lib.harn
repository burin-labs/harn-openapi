// harn-openapi — Pure-Harn OpenAPI 3.1 parser and SDK codegen helpers.
//
// Exported surface:
//
//   parse(json_string)           -> OpenApiDoc
//       Parse an OpenAPI 3.1 JSON document into a normalized OpenApiDoc with
//       shape { openapi, info, servers, paths, webhooks, components,
//       security_schemes, security, tags }. OAS 3.1 makes `paths`
//       optional and introduces first-class `webhooks` plus
//       `components.pathItems` — all three are surfaced here. The
//       doc-level `security` is also surfaced so operation-level
//       security falls back cleanly. Throws on non-3.1.x docs.
//
//   operations(doc)              -> list<Operation>
//       Flatten path-itemed operations in `doc.paths` into a list of
//       { method, path, operation_id, summary, parameters,
//       request_body, responses, security } dicts. Each operation's
//       `security` is resolved as `op.security ?? doc.security ?? []`,
//       so an explicit `security: []` at either level survives as a
//       signal to emit an unauthenticated call.
//
//   webhook_operations(doc)      -> list<WebhookOperation>
//       Flatten OAS 3.1 `doc.webhooks` into a list of
//       { name, method, path_item, operation } dicts. `name` is the
//       webhook key (e.g. "commentCreated"); `method` is the HTTP
//       verb declared on the path item; `operation` is the Operation
//       object. Analogous to `operations()` for inbound payloads.
//
//   component_path_items(doc)    -> dict<string, RefOr<PathItem>>
//       Passthrough accessor for `doc.components.pathItems` (new in
//       OAS 3.1). Returns `{}` when absent.
//
//   schema(doc, ref_or_inline)   -> Schema
//       Resolve a `$ref` like "#/components/schemas/Foo" against the
//       parsed doc, or return an inline schema unchanged. Preserves
//       `$ref` siblings, merges one level of `allOf`, and leaves
//       `oneOf`/`anyOf` un-merged.
//
//   enum_values(schema)          -> list | nil
//       Return the enum variant list on a schema, or nil if absent.
//
//   normalize_adapter_schema_graph(openapi_version, schemas)
//       Preserve reusable OpenAPI components as one validated, self-contained
//       Draft 2020-12 graph for CLI, MCP, catalog, and typed-client projections.
//
//   normalize_adapter_schema(openapi_version, schema, graph)
//       Normalize one tool schema against the same reusable component graph.
//
//   is_openapi_doc(value) / is_reference(value) / is_schema(value) -> bool
//       Guard helpers for common dynamic boundaries.
//
//   auth_helpers(doc)           -> list<AuthHelper>
//       Classify reusable auth helper metadata for each declared security
//       scheme without choosing provider-specific credential policy.
//
//   adapter_security_plan(doc, environment_prefix) -> AdapterSecurityPlan
//       Normalize OpenAPI security into one typed OR-of-AND plan shared by
//       generated clients, environment configuration, CLI, MCP, and catalogs.
//
//   pagination_plans(doc)       -> list<PaginationPlan>
//       Detect simple cursor, page-number, and next-link list patterns from
//       operation parameters and success-response schemas.
//
//   rate_limit_metadata(doc)    -> list<RateLimitMetadata>
//       Surface per-operation 429 / Retry-After / X-RateLimit-* response
//       header conventions for connector retry and backoff code.
//
//   codegen_module(fs, doc, options) -> string
//       Emit a complete typed Harn SDK module source string. Options:
//       { module_name, client_name, default_base_url?, header_overrides?,
//       transport? }. The default `connector_policy` transport emits calls
//       through std/connectors/shared. `transport: "raw"` keeps a minimal
//       direct `harness.net.request(...)` path for generated packages that
//       have not moved to the shared HTTP policy envelope yet.
//       Uses Harn's stdlib `render_string` template engine so generated-code
//       rendering stays aligned with the runtime instead of a local template
//       parser.
//       The generated AdapterClient keys credentials by the original OpenAPI
//       scheme name. Each operation selects the first configured security
//       alternative, requires every scheme in that alternative, and preserves
//       explicit anonymous access. Provider closures support request-time
//       secret lookup without embedding values in generated source.
//
//   codegen_entrypoint(fs, doc, options) -> string
//       Emit one executable registry entrypoint. It reads only generated
//       environment names and feeds the same ToolRegistry to CLI and MCP hosts.
//
//   codegen_harn_toml(options) -> string
//       Emit package metadata for generated SDK repos. Options:
//       { package_name, version?, description?, default_export?,
//       types_export?, entrypoint_export?, dependencies? }.
//
// See README.md for end-to-end usage; scripts/regen_demo.harn runs a
// full parse -> codegen -> write loop against the bundled Notion
// fixture.
import { filter_nil } from "std/collections"
import { normalize_adapter_governance } from "./adapter_governance"
pub import {
  AdapterJsonSchema,
  AdapterSchemaGraph,
  normalize_adapter_schema,
  normalize_adapter_schema_graph,
} from "./adapter_schema_graph"
pub import {
  AdapterOperationSecurityPlan,
  AdapterSecurityAlternative,
  AdapterSecurityEnvironment,
  AdapterSecurityPlan,
  AdapterSecuritySchemeKind,
  AdapterSecuritySchemePlan,
  normalize_adapter_security_plan,
  select_adapter_security_alternative,
} from "./adapter_security"

// -------------------------------------------------------------------------------------------------
// Types
// -------------------------------------------------------------------------------------------------

type JsonSchemaType = "null" | "boolean" | "object" | "array" | "number" | "string" | "integer"

/**
 * Harn shape fields cannot currently spell "$ref", so Reference is open and
 * callers should read the reference target with value.get("$ref").
 */
type Reference = {summary?: string, description?: string}

type RefOr<T> = Reference | T

type Contact = {name?: string, url?: string, email?: string}

type License = {name: string, identifier?: string, url?: string}

type Info = {
  title: string,
  summary?: string,
  description?: string,
  termsOfService?: string,
  contact?: Contact,
  license?: License,
  version: string,
}

type ServerVariable = {enum?: list<string>, default: string, description?: string}

type Server = {url: string, description?: string, variables?: dict<string, ServerVariable>}

type ExternalDocumentation = {description?: string, url: string}

type Tag = {name: string, description?: string, externalDocs?: ExternalDocumentation}

type SecurityRequirement = dict<string, list<string>>

type Discriminator = {propertyName: string, mapping?: dict<string, string>}

/**
 * Schema is open-shaped by design. JSON Schema 2020-12 permits "$ref"
 * siblings, so schema(doc, value) merges referenced content with any sibling
 * keywords instead of treating "$ref" as an exclusive replacement.
 * exclusiveMinimum / exclusiveMaximum are numeric in OAS 3.1, and oneOf /
 * anyOf are first-class so polymorphic request bodies remain representable.
 */
type Schema = {
  title?: string,
  multipleOf?: float,
  maximum?: float,
  exclusiveMaximum?: float,
  minimum?: float,
  exclusiveMinimum?: float,
  maxLength?: int,
  minLength?: int,
  pattern?: string,
  maxItems?: int,
  minItems?: int,
  uniqueItems?: bool,
  maxProperties?: int,
  minProperties?: int,
  required?: list<string>,
  enum?: list,
  const?: any,
  type?: JsonSchemaType | list<JsonSchemaType>,
  allOf?: list<dict>,
  oneOf?: list<dict>,
  anyOf?: list<dict>,
  not?: dict,
  items?: dict | list<dict>,
  properties?: dict<string, dict>,
  additionalProperties?: bool | dict,
  description?: string,
  format?: string,
  default?: any,
  nullable?: bool,
  discriminator?: Discriminator,
  readOnly?: bool,
  writeOnly?: bool,
  xml?: dict,
  externalDocs?: ExternalDocumentation,
  example?: any,
  examples?: list<any>,
  deprecated?: bool,
}

type Example = {summary?: string, description?: string, value?: any, externalValue?: string}

type Encoding = {
  contentType?: string,
  headers?: dict,
  style?: string,
  explode?: bool,
  allowReserved?: bool,
}

type MediaType = {
  schema?: Schema,
  example?: any,
  examples?: dict<string, RefOr<Example>>,
  encoding?: dict<string, Encoding>,
}

type ParameterLocation = "query" | "header" | "path" | "cookie"

type Parameter = {
  name: string,
  in: ParameterLocation,
  description?: string,
  required?: bool,
  deprecated?: bool,
  allowEmptyValue?: bool,
  style?: string,
  explode?: bool,
  allowReserved?: bool,
  schema?: Schema,
  example?: any,
  examples?: dict<string, RefOr<Example>>,
  content?: dict<string, MediaType>,
}

type Header = {
  description?: string,
  required?: bool,
  deprecated?: bool,
  allowEmptyValue?: bool,
  style?: string,
  explode?: bool,
  allowReserved?: bool,
  schema?: Schema,
  example?: any,
  examples?: dict<string, RefOr<Example>>,
  content?: dict<string, MediaType>,
}

type RequestBody = {description?: string, content: dict<string, MediaType>, required?: bool}

type Link = {
  operationRef?: string,
  operationId?: string,
  parameters?: dict<string, any>,
  requestBody?: any,
  description?: string,
  server?: Server,
}

type Response = {
  description: string,
  headers?: dict<string, RefOr<Header>>,
  content?: dict<string, MediaType>,
  links?: dict<string, RefOr<Link>>,
}

type Responses = dict<string, RefOr<Response>>

type Callback = dict<string, dict>

type Operation = {
  method?: string,
  path?: string,
  operation_id?: string,
  tags?: list<string>,
  summary?: string,
  description?: string,
  externalDocs?: ExternalDocumentation,
  operationId?: string,
  parameters?: list<RefOr<Parameter>>,
  requestBody?: RefOr<RequestBody>,
  request_body?: RefOr<RequestBody>,
  responses?: Responses,
  callbacks?: dict<string, RefOr<Callback>>,
  deprecated?: bool,
  security?: list<SecurityRequirement>,
  servers?: list<Server>,
  x_harn?: dict,
}

type PathItem = {
  summary?: string,
  description?: string,
  get?: Operation,
  put?: Operation,
  post?: Operation,
  delete?: Operation,
  options?: Operation,
  head?: Operation,
  patch?: Operation,
  trace?: Operation,
  servers?: list<Server>,
  parameters?: list<RefOr<Parameter>>,
}

type ApiKeySecurityScheme = {
  type: "apiKey",
  description?: string,
  name: string,
  in: "query" | "header" | "cookie",
}

type HttpSecurityScheme = {
  type: "http",
  description?: string,
  scheme: string,
  bearerFormat?: string,
}

type OAuthFlow = {
  authorizationUrl?: string,
  tokenUrl?: string,
  refreshUrl?: string,
  scopes: dict<string, string>,
}

type OAuthFlows = {
  implicit?: OAuthFlow,
  password?: OAuthFlow,
  clientCredentials?: OAuthFlow,
  authorizationCode?: OAuthFlow,
}

type OAuth2SecurityScheme = {type: "oauth2", description?: string, flows: OAuthFlows}

type OpenIdConnectSecurityScheme = {
  type: "openIdConnect",
  description?: string,
  openIdConnectUrl: string,
}

type MutualTLSSecurityScheme = {type: "mutualTLS", description?: string}

type SecurityScheme = ApiKeySecurityScheme \
  | HttpSecurityScheme \
  | OAuth2SecurityScheme \
  | OpenIdConnectSecurityScheme \
  | MutualTLSSecurityScheme

type Components = {
  schemas?: dict<string, Schema>,
  responses?: dict<string, RefOr<Response>>,
  parameters?: dict<string, RefOr<Parameter>>,
  examples?: dict<string, RefOr<Example>>,
  requestBodies?: dict<string, RefOr<RequestBody>>,
  headers?: dict<string, RefOr<Header>>,
  securitySchemes?: dict<string, RefOr<SecurityScheme>>,
  links?: dict<string, RefOr<Link>>,
  callbacks?: dict<string, RefOr<Callback>>,
  pathItems?: dict<string, RefOr<PathItem>>,
}

type OpenApiDoc = {
  openapi: string,
  info: Info,
  jsonSchemaDialect?: string,
  servers?: list<Server>,
  paths?: dict<string, PathItem>,
  webhooks?: dict<string, RefOr<PathItem>>,
  components?: Components,
  security?: list<SecurityRequirement>,
  tags?: list<Tag>,
  externalDocs?: ExternalDocumentation,
  security_schemes?: dict<string, RefOr<SecurityScheme>>,
}

type WebhookOperation = {
  name: string,
  method: string,
  path_item: PathItem,
  operation: Operation,
  operation_id: string,
  summary?: string,
  description?: string,
  parameters?: list<RefOr<Parameter>>,
  request_body?: RefOr<RequestBody>,
  responses?: Responses,
  security?: list<SecurityRequirement>,
  tags?: list<string>,
}

type AuthHelper = {
  scheme_name: string,
  kind: string,
  credential_fields: list<string>,
  location?: string,
  parameter_name?: string,
  scopes?: list<string>,
}

/** Inputs required to generate an executable registry entrypoint. */
pub type AdapterEntrypointOptions = {module_import: string, environment_prefix: string}

type PaginationPlan = {
  operation_id: string,
  method: string,
  path: string,
  kind: string,
  items_field?: string,
  cursor_param?: string,
  cursor_location?: string,
  cursor_response_field?: string,
  has_more_field?: string,
  page_param?: string,
  page_location?: string,
  page_size_param?: string,
  page_size_location?: string,
  next_link_field?: string,
  link_header?: string,
}

type RateLimitMetadata = {
  operation_id: string,
  method: string,
  path: string,
  status?: string,
  retry_after_header?: string,
  limit_headers: list<string>,
  remaining_headers: list<string>,
  reset_headers: list<string>,
}

// -------------------------------------------------------------------------------------------------
// Parsing
// -------------------------------------------------------------------------------------------------

/** Parse an OpenAPI 3.1 JSON document into a normalized OpenApiDoc. */
pub fn parse(json_string: string) -> OpenApiDoc {
  const raw = json_parse(json_string)
  const raw_version = raw.get("openapi")
  if raw_version == nil {
    throw "harn-openapi.parse: missing top-level 'openapi' field"
  }
  if type_of(raw_version) != "string" {
    throw "harn-openapi.parse: expected openapi to be a string, got " + type_of(raw_version)
  }
  const version = raw_version
  if regex_match("^3\\.1\\.[0-9]+$", version) == nil {
    throw "harn-openapi.parse: expected openapi 3.1.x, got " + version
  }
  const components = raw.get("components") ?? {}
  const components_with_path_items = {...components, pathItems: components.get("pathItems") ?? {}}
  const doc = {
    openapi: version,
    info: raw.get("info") ?? {},
    jsonSchemaDialect: raw.get("jsonSchemaDialect"),
    servers: raw.get("servers") ?? [],
    paths: raw.get("paths") ?? {},
    webhooks: raw.get("webhooks") ?? {},
    components: components_with_path_items,
    security_schemes: components.get("securitySchemes") ?? {},
    security: raw.get("security") ?? [],
    tags: raw.get("tags") ?? [],
    externalDocs: raw.get("externalDocs"),
  }
  return schema_expect(filter_nil(doc), OpenApiDoc)
}

// -------------------------------------------------------------------------------------------------
// Walking helpers
// -------------------------------------------------------------------------------------------------

const _HTTP_METHODS = ["get", "put", "post", "delete", "options", "head", "patch", "trace"]

/** Flatten every operation in the doc's `paths` dict. */
pub fn operations(doc: OpenApiDoc) -> list<Operation> {
  return _operations(doc)
}

/**
 * Call this after a public function validates the document. It avoids
 * validating a large document again for each derived view.
 */
fn _operations(doc: any) {
  return _flatten_path_item_map(doc.get("paths") ?? {}, doc, "path")
}

/** Flatten every operation in the doc's `webhooks` dict (OAS 3.1). */
pub fn webhook_operations(doc: OpenApiDoc) -> list<WebhookOperation> {
  return _flatten_path_item_map(doc.get("webhooks") ?? {}, doc, "webhook")
}

/** Passthrough accessor for `components.pathItems` (OAS 3.1). */
pub fn component_path_items(doc: OpenApiDoc) -> dict<string, RefOr<PathItem>> {
  const components = doc.get("components") ?? {}
  return components.get("pathItems") ?? {}
}

fn _flatten_path_item_map(items: any, doc: any, mode: any) {
  let out = []
  for entry in items {
    const key = entry.key
    const item = _resolve_ref(doc, entry.value)
    for method in _HTTP_METHODS {
      const op = item.get(method)
      if op != nil {
        const raw_params = _merge_parameters(
          item.get("parameters") ?? [],
          op.get("parameters") ?? [],
          doc,
        )
        const effective_security = op.get("security") ?? doc.get("security") ?? []
        const effective_servers = op.get("servers") ?? item.get("servers") ?? doc.get("servers")
          ?? []
        if mode == "webhook" {
          const normalized = {
            name: key,
            method: method,
            path_item: item,
            operation: op,
            operation_id: op.get("operationId") ?? _synth_operation_id(method, key),
            summary: op.get("summary") ?? "",
            description: op.get("description") ?? "",
            parameters: raw_params,
            request_body: op.get("requestBody"),
            responses: op.get("responses") ?? {},
            security: effective_security,
            servers: effective_servers,
            tags: op.get("tags") ?? [],
            x_harn: op.get("x-harn"),
          }
          out = out + [_merge_shallow(op, normalized)]
        } else {
          const normalized = {
            method: method,
            path: key,
            operation_id: op.get("operationId") ?? _synth_operation_id(method, key),
            summary: op.get("summary") ?? "",
            description: op.get("description") ?? "",
            parameters: raw_params,
            request_body: op.get("requestBody"),
            responses: op.get("responses") ?? {},
            security: effective_security,
            servers: effective_servers,
            tags: op.get("tags") ?? [],
            x_harn: op.get("x-harn"),
          }
          out = out + [_merge_shallow(op, normalized)]
        }
      }
    }
  }
  return out
}

fn _merge_parameters(path_params: any, op_params: any, doc: any) {
  const resolved_path = _resolve_param_list(path_params, doc)
  const resolved_op = _resolve_param_list(op_params, doc)
  if len(resolved_path) == 0 {
    return resolved_op
  }
  if len(resolved_op) == 0 {
    return resolved_path
  }
  let combined = []
  let taken = []
  for p in resolved_op {
    const key = to_string(p.get("name")) + "::" + to_string(p.get("in") ?? "query")
    taken = taken + [key]
    combined = combined + [p]
  }
  for p in resolved_path {
    const key = to_string(p.get("name")) + "::" + to_string(p.get("in") ?? "query")
    if !taken.contains(key) {
      combined = combined + [p]
    }
  }
  return combined
}

fn _resolve_param_list(params: any, doc: any) {
  let out = []
  for p in params {
    if type_of(p) == "dict" && p.get("$ref") != nil {
      out = out + [_resolve_ref(doc, p)]
    } else {
      out = out + [p]
    }
  }
  return out
}

fn _synth_operation_id(method: any, path: any) {
  const cleaned = regex_replace("[^a-zA-Z0-9]+", "_", path)
  const trimmed = regex_replace("^_+|_+$", "", cleaned)
  return method + "_" + trimmed
}

// Hard backstop for $ref resolution depth. Per-chain cycle detection in
// `_resolve_ref_inner` catches A -> B -> A, but a malicious spec can spread a
// long ref chain across allOf branches; this cap prevents pathological recursion
// (or accidental fan-out) from exhausting the stack during codegen.
const _MAX_REF_DEPTH = 32

/** Resolve a `$ref` against `doc`, merge one level of `allOf`. */
pub fn schema(doc: OpenApiDoc, ref_or_inline: RefOr<Schema>) -> Schema {
  return _schema(doc, ref_or_inline)
}

fn _schema(doc: any, ref_or_inline: any) {
  return _schema_inner(doc, ref_or_inline, [])
}

fn _schema_inner(doc: any, ref_or_inline: any, seen_refs: any) {
  const resolved = _resolve_ref_inner(doc, ref_or_inline, seen_refs)
  const all_of = resolved.get("allOf")
  if all_of == nil {
    return resolved
  }
  if type_of(all_of) == "list" && len(all_of) > _MAX_ALL_OF {
    throw "harn-openapi.schema: allOf branch count " + to_string(len(all_of))
      + " exceeds limit "
      + to_string(_MAX_ALL_OF)
  }
  const next_seen = _ref_chain_for(ref_or_inline, seen_refs)
  let merged = {}
  for part in all_of {
    const piece = _resolve_ref_inner(doc, part, next_seen)
    merged = _merge_schema(merged, piece)
  }
  const own = _omit_key(resolved, "allOf")
  return _merge_schema(merged, own)
}

fn _ref_chain_for(node: any, seen_refs: any) {
  if type_of(node) != "dict" {
    return seen_refs
  }
  const ref = node.get("$ref")
  if ref == nil || type_of(ref) != "string" {
    return seen_refs
  }
  if seen_refs.contains(ref) {
    return seen_refs
  }
  return seen_refs + [ref]
}

fn _resolve_ref(doc: any, node: any) {
  return _resolve_ref_inner(doc, node, [])
}

fn _resolve_ref_inner(doc: any, node: any, seen_refs: any) {
  if type_of(node) != "dict" {
    return {}
  }
  const ref = node.get("$ref")
  if ref == nil {
    return node
  }
  if type_of(ref) != "string" {
    throw "harn-openapi.schema: expected string $ref, got " + type_of(ref)
  }
  if seen_refs.contains(ref) {
    throw "harn-openapi.schema: circular $ref detected: " + ref
  }
  if len(seen_refs) >= _MAX_REF_DEPTH {
    throw "harn-openapi.schema: $ref depth exceeded " + to_string(_MAX_REF_DEPTH) + " at " + ref
  }
  const target = _lookup_ref(doc, ref)
  const resolved_target = _resolve_ref_inner(doc, target, seen_refs + [ref])
  const siblings = _omit_key(node, "$ref")
  return _merge_schema(resolved_target, siblings)
}

fn _lookup_ref(doc: any, ref: any) {
  if !starts_with(ref, "#/") {
    throw "harn-openapi.schema: only local JSON Pointer refs are supported, got " + ref
  }
  const parts = split(substring(ref, 2, len(ref)), "/")
  let node = doc
  for raw_seg in parts {
    const seg = _unescape_pointer(raw_seg)
    if seg == "components" {
      node = doc.components ?? {}
    } else {
      if node == nil {
        throw "harn-openapi.schema: broken ref " + ref
      }
      node = node.get(seg)
    }
    if node == nil {
      throw "harn-openapi.schema: broken ref " + ref
    }
  }
  return node
}

fn _unescape_pointer(seg: any) {
  return replace(replace(seg, "~1", "/"), "~0", "~")
}

// DoS backstops for malicious specs: a deeply chained allOf or a schema
// declaring thousands of properties can spike CPU/memory during codegen.
const _MAX_ALL_OF = 64

const _MAX_PROPERTIES = 1024

fn _merge_schema(base: any, overlay: any) {
  if type_of(overlay) != "dict" {
    return base
  }
  let merged = base
  for entry in overlay {
    const k = entry.key
    const v = entry.value
    if k == "properties" {
      const existing = merged.get("properties") ?? {}
      const combined = existing + v
      if type_of(combined) == "dict" && len(combined) > _MAX_PROPERTIES {
        throw "harn-openapi.schema: properties count " + to_string(len(combined))
          + " exceeds limit "
          + to_string(_MAX_PROPERTIES)
      }
      merged = {...merged, properties: combined}
    } else if k == "required" {
      const existing = merged.get("required") ?? []
      merged = {...merged, required: _dedupe(existing + v)}
    } else if k == "allOf" {
      const existing = merged.get("allOf") ?? []
      const combined = existing + v
      if type_of(combined) == "list" && len(combined) > _MAX_ALL_OF {
        throw "harn-openapi.schema: allOf chain length " + to_string(len(combined))
          + " exceeds limit "
          + to_string(_MAX_ALL_OF)
      }
      merged = {...merged, allOf: combined}
    } else {
      merged = {...merged, [k]: v}
    }
  }
  return merged
}

fn _merge_shallow(base: any, overlay: any) {
  if type_of(base) != "dict" {
    return overlay
  }
  if type_of(overlay) != "dict" {
    return base
  }
  let merged = base
  for entry in overlay {
    merged = {...merged, [entry.key]: entry.value}
  }
  return merged
}

fn _omit_key(d: any, k: any) {
  let out = {}
  for entry in d {
    if entry.key != k {
      out = {...out, [entry.key]: entry.value}
    }
  }
  return out
}

fn _dedupe(xs: any) {
  let seen = []
  let out = []
  for x in xs {
    if !seen.contains(x) {
      seen = seen + [x]
      out = out + [x]
    }
  }
  return out
}

/** Return the enum variant list on a schema, or nil. */
pub fn enum_values(sch: Schema) -> list? {
  if type_of(sch) != "dict" {
    return nil
  }
  const vs = sch.get("enum")
  if vs == nil {
    return nil
  }
  if type_of(vs) != "list" {
    return nil
  }
  return vs
}

/** True when a value satisfies the complete normalized OpenApiDoc contract. */
pub fn is_openapi_doc(value: unknown) -> bool {
  return schema_is(value, OpenApiDoc)
}

/** True when a value is a local or remote OpenAPI Reference Object. */
pub fn is_reference(value: unknown) -> bool {
  if type_of(value) != "dict" {
    return false
  }
  return type_of(value.get("$ref")) == "string"
}

/** True when a value is object-like enough to be used as an OAS Schema. */
pub fn is_schema(value: unknown) -> bool {
  return schema_is(value, {type: "dict"})
}

/** Classify reusable auth helper metadata for declared security schemes. */
pub fn auth_helpers(doc: OpenApiDoc) -> list<AuthHelper> {
  const schemes = doc.get("security_schemes") ?? {}
  let out = []
  for entry in schemes {
    const name = entry.key
    const def = entry.value
    const kind = _scheme_kind(def)
    let helper = {
      scheme_name: name,
      kind: kind,
      credential_fields: _credential_fields_for_scheme_kind(kind),
    }
    if starts_with(kind, "apiKey-") {
      helper = {
        ...helper,
        location: def.get("in") ?? "header",
        parameter_name: def.get("name") ?? name,
      }
    }
    if kind == "oauth2" {
      helper = {...helper, scopes: _oauth_scope_names(def)}
    }
    out = out + [helper]
  }
  return out
}

/** Build the shared authentication plan for every generated projection. */
pub fn adapter_security_plan(doc: OpenApiDoc, environment_prefix: string) -> AdapterSecurityPlan {
  let security_operations = []
  for op in _operations(doc) {
    security_operations = security_operations
      + [{operation_id: op.operation_id, security: op.security ?? []}]
  }
  return normalize_adapter_security_plan(
    doc.get("security_schemes") ?? {},
    security_operations,
    environment_prefix,
  )
}

fn _credential_fields_for_scheme_kind(kind: any) {
  if kind == "bearer" || kind == "oauth2" || kind == "openIdConnect" {
    return ["token", "token_provider"]
  }
  if kind == "basic" {
    return ["username", "password", "basic_provider"]
  }
  if kind == "apiKey-header" || kind == "apiKey-query" || kind == "apiKey-cookie" {
    return ["value", "value_provider"]
  }
  if kind == "mutualTLS" {
    return ["host_configured"]
  }
  return []
}

fn _oauth_scope_names(def: any) {
  const flows = def.get("flows") ?? {}
  let scopes = []
  for flow_name in ["implicit", "password", "clientCredentials", "authorizationCode"] {
    const flow = flows.get(flow_name)
    if type_of(flow) == "dict" {
      const flow_scopes = flow.get("scopes") ?? {}
      for entry in flow_scopes {
        if !scopes.contains(entry.key) {
          scopes = scopes + [entry.key]
        }
      }
    }
  }
  scopes = scopes.sort()
  return scopes
}

/** Detect reusable pagination patterns from operation params and responses. */
pub fn pagination_plans(doc: OpenApiDoc) -> list<PaginationPlan> {
  return _pagination_plans(doc)
}

fn _pagination_plans(doc: any) {
  let out = []
  for op in _operations(doc) {
    const plan = _pagination_plan_for_op(doc, op)
    if plan != nil {
      out = out + [plan]
    }
  }
  return out
}

fn _pagination_plan_for_op(doc: any, op: any) {
  const params = op.parameters ?? []
  const body_props = _request_body_json_properties(doc, op)
  const cursor = _pagination_request_field(
    params,
    body_props,
    ["start_cursor", "cursor", "after", "page_token", "next_page_token"],
  )
  const page = _pagination_request_field(
    params,
    body_props,
    ["page", "page_number", "page_index", "offset"],
  )
  const page_size = _pagination_request_field(
    params,
    body_props,
    ["page_size", "per_page", "limit", "size"],
  )
  const picked = _pick_success_response(doc, op)
  if picked == nil || picked.kind != "json" {
    return nil
  }
  const full = _schema(doc, picked.schema)
  const props = full.get("properties") ?? {}
  const items_field = _first_present_key(
    props,
    ["results", "templates", "data", "items", "records", "objects"],
  )
  const next_cursor = _first_present_key(
    props,
    ["next_cursor", "next_page_token", "cursor", "after"],
  )
  const has_more = _first_present_key(props, ["has_more", "hasMore", "more"])
  const next_link = _first_present_key(props, ["next", "next_url", "next_link", "nextPageUrl"])
  const link_header = _success_response_header(doc, op, "Link")
  if cursor.name != nil && next_cursor != nil {
    return {
      operation_id: op.operation_id,
      method: op.method,
      path: op.path,
      kind: "cursor",
      items_field: items_field,
      cursor_param: cursor.name,
      cursor_location: cursor.location,
      cursor_response_field: next_cursor,
      has_more_field: has_more,
      page_size_param: page_size.name,
      page_size_location: page_size.location,
    }
  }
  if page.name != nil {
    return {
      operation_id: op.operation_id,
      method: op.method,
      path: op.path,
      kind: "page",
      items_field: items_field,
      page_param: page.name,
      page_location: page.location,
      page_size_param: page_size.name,
      page_size_location: page_size.location,
    }
  }
  if next_link != nil || link_header != nil {
    return {
      operation_id: op.operation_id,
      method: op.method,
      path: op.path,
      kind: "next_link",
      items_field: items_field,
      next_link_field: next_link,
      link_header: link_header,
    }
  }
  return nil
}

fn _request_body_json_properties(doc: any, op: any) -> dict {
  const request_schema = _request_json_schema(doc, op.request_body)
  if request_schema == nil {
    return {}
  }
  const full = _schema(doc, request_schema)
  const props = full.get("properties")
  if type_of(props) == "dict" {
    return props
  }
  return {}
}

fn _pagination_request_field(params: any, body_props: any, names: any) -> dict {
  const query_field = _first_param_named(params, names)
  if query_field != nil {
    return {name: query_field, location: "query"}
  }
  const body_field = _first_present_key(body_props, names)
  if body_field != nil {
    return {name: body_field, location: "body"}
  }
  return {name: nil, location: nil}
}

fn _first_param_named(params: any, names: any) {
  for wanted in names {
    for p in params {
      if p.get("in") == "query" && p.get("name") == wanted {
        return wanted
      }
    }
  }
  return nil
}

fn _first_present_key(d: any, names: any) {
  if type_of(d) != "dict" {
    return nil
  }
  for name in names {
    if d.get(name) != nil {
      return name
    }
  }
  return nil
}

fn _success_response_header(doc: any, op: any, header_name: any) {
  for entry in op.responses {
    if _is_success_code(entry.key) {
      const response = _resolve_ref(doc, entry.value)
      const headers = response.get("headers") ?? {}
      const found = _header_name_case_insensitive(headers, header_name)
      if found != nil {
        return found
      }
    }
  }
  return nil
}

fn _header_name_case_insensitive(headers: any, wanted: any) {
  if type_of(headers) != "dict" {
    return nil
  }
  for entry in headers {
    if entry.key.lower() == wanted.lower() {
      return entry.key
    }
  }
  return nil
}

/** Surface response header conventions used by retry/backoff code. */
pub fn rate_limit_metadata(doc: OpenApiDoc) -> list<RateLimitMetadata> {
  return _rate_limit_metadata(doc)
}

fn _rate_limit_metadata(doc: any) {
  let out = []
  for op in _operations(doc) {
    const meta = _rate_limit_metadata_for_op(doc, op)
    if meta != nil {
      out = out + [meta]
    }
  }
  return out
}

fn _rate_limit_metadata_for_op(doc: any, op: any) {
  let status = nil
  let retry_after = nil
  let limit_headers = []
  let remaining_headers = []
  let reset_headers = []
  for response_entry in op.responses {
    const code = response_entry.key
    const response = _resolve_ref(doc, response_entry.value)
    const headers = response.get("headers") ?? {}
    if code == "429" {
      status = "429"
    }
    const retry_header = _header_name_case_insensitive(headers, "Retry-After")
    if retry_header != nil {
      retry_after = retry_header
    }
    for header_entry in headers {
      const header = header_entry.key
      const normalized = header.lower()
      if contains(normalized, "ratelimit-limit") || contains(normalized, "rate-limit-limit") {
        if !limit_headers.contains(header) {
          limit_headers = limit_headers + [header]
        }
      } else if contains(normalized, "ratelimit-remaining")
        || contains(normalized, "rate-limit-remaining") {
        if !remaining_headers.contains(header) {
          remaining_headers = remaining_headers + [header]
        }
      } else if contains(normalized, "ratelimit-reset") || contains(normalized, "rate-limit-reset") {
        if !reset_headers.contains(header) {
          reset_headers = reset_headers + [header]
        }
      }
    }
  }
  if status == nil && retry_after == nil && len(limit_headers) == 0 && len(remaining_headers) == 0
    && len(reset_headers)
      == 0 {
    return nil
  }
  return {
    operation_id: op.operation_id,
    method: op.method,
    path: op.path,
    status: status,
    retry_after_header: retry_after,
    limit_headers: limit_headers,
    remaining_headers: remaining_headers,
    reset_headers: reset_headers,
  }
}

// -------------------------------------------------------------------------------------------------
// Codegen
// -------------------------------------------------------------------------------------------------

fn _adapter_operations(doc: OpenApiDoc, options: dict = {}) -> list {
  const header_overrides = options.get("header_overrides") ?? {}
  let adapter_operations = []
  let taken_names = []
  let exposed_names = []
  let exposed_cli_commands = []
  for op in _operations(doc) {
    const function_name = _unique_fn_name(_sanitize_ident(op.operation_id), taken_names)
    taken_names = taken_names + [function_name]
    const adapter = _adapter_operation(doc, op, function_name, header_overrides)
    if adapter.expose {
      if exposed_names.contains(adapter.name) {
        throw "harn-openapi.codegen_module: duplicate generated tool name '" + adapter.name + "'"
      }
      if adapter.governance.audiences.contains("cli") {
        for command in exposed_cli_commands {
          if _cli_commands_conflict(command, adapter.cli.command) {
            throw "harn-openapi.codegen_module: conflicting generated CLI commands '"
              + join(command, " ")
              + "' and '"
              + join(adapter.cli.command, " ")
              + "'"
          }
        }
        exposed_cli_commands = exposed_cli_commands + [adapter.cli.command]
      }
      exposed_names = exposed_names + [adapter.name]
    }
    adapter_operations = adapter_operations + [adapter]
  }
  return adapter_operations
}

fn _cli_commands_conflict(left: list<string>, right: list<string>) -> bool {
  const shared_length = if len(left) < len(right) {
    len(left)
  } else {
    len(right)
  }
  let index = 0
  while index < shared_length {
    if left[index] != right[index] {
      return false
    }
    index = index + 1
  }
  return true
}

const _MODULE_TEMPLATE = """
  {{ if has_connector_imports }}import { {{ connector_imports }} } from "std/connectors/shared"
  {{ end }}import { ToolCatalog, ToolRegistry } from "std/tools"

  /*
   * Auto-generated by harn-openapi codegen — do not edit by hand.
   * Source doc: {{ doc_title }} (OpenAPI {{ openapi_version }})
   * Module:     {{ module_name }}
   */
  /** Complete HTTP Basic material returned by a request-time provider. */
  pub type AdapterBasicCredential = {username: string, password: string}

  /** One OpenAPI scheme's host-owned credential material. */
  pub type AdapterCredential = {
    token?: string,
    username?: string,
    password?: string,
    value?: string,
    token_provider?: fn() -> string,
    basic_provider?: fn() -> AdapterBasicCredential,
    value_provider?: fn() -> string,
    host_configured?: bool,
  }

  /** Extra HTTP headers supplied by the host. */
  pub type AdapterHeaders = dict<string, string>

  pub type AdapterClient = {
    base_url: string,
    credentials: dict<string, AdapterCredential>,
    extra_headers: AdapterHeaders,
  }

  /** Host-owned runtime configuration; secret values never enter the static catalog. */
  pub type AdapterRuntimeConfig = {
    base_url: string,
    credentials: dict<string, AdapterCredential>,
    extra_headers: AdapterHeaders,
  }

  {{ for alias in response_aliases }}
  {{ alias.source }}
  {{ end }}

  /**
   * Build executable tools backed by the generated typed SDK functions.
   * This registry is the single source for MCP, CLI, and static catalog adapters.
   */
  pub fn {{ adapter_tools_decl }} {
    validate_client(client)
    let tools = tool_registry({{ registry_info }})
    {{ for op in adapter_operations }}{{ if op.adapter_expose }}tools = tool_define(
      tools,
      "{{ op.adapter_name }}",
      "{{ op.adapter_description }}",
      {
        parameters: {{ op.adapter_parameters }},{{ if op.adapter_output_schema }}
        returns: {{ op.adapter_output_schema }},{{ end }}
        {{ op.adapter_handler }},
        title: "{{ op.adapter_title }}",
        annotations: {{ op.adapter_annotations }},
        {{ if op.adapter_icons }}icons: {{ op.adapter_icons }},
        {{ end }}{{ if op.adapter_execution }}execution: {{ op.adapter_execution }},
        {{ end }}execution_policy: {{ op.adapter_policy }},
        governance: {{ op.adapter_governance }},
        cli: {{ op.adapter_cli }},
        source: {{ op.adapter_source }},
        defer_loading: {{ op.adapter_defer_loading }},{{ if op.adapter_namespace }}
        namespace: "{{ op.adapter_namespace }}",{{ end }}
        meta: {{ op.adapter_meta }},
      },
    )
    {{ end }}{{ end }}return tools
  }

  /** Return the versioned static catalog projected from `adapter_tools`. */
  pub fn {{ adapter_catalog_decl }} {
    return tool_schema({{ adapter_tools_call }})
  }

  /** Create a new {{ client_name }} handle. */
  pub fn {{ new_client_decl }} {
    {{ new_client_return }}
  }

  /** Read the generated portable environment projection. */
  pub fn adapter_environment_config(env: HarnessEnv) -> AdapterRuntimeConfig {
    let credentials: dict<string, AdapterCredential> = {}
    {{ for scheme in environment_schemes }}{{ scheme.read_lines }}
    {{ end }}const configured_base_url = env.get("{{ base_url_environment }}")
    const base_url = if configured_base_url != nil && configured_base_url != "" {
      configured_base_url
    } else {
      "{{ default_base_url }}"
    }
    return {base_url: base_url, credentials: credentials, extra_headers: {}}
  }

  /** Construct the one registry projected by CLI, MCP, and static schema commands. */
  pub fn adapter_registry(
    harness: {clock: HarnessClock, net: HarnessNet},
    config: AdapterRuntimeConfig,
  ) -> ToolRegistry {
    const client = new_client(config.base_url, config.credentials, config.extra_headers)
    return adapter_tools({{ adapter_authority }}, client)
  }

  /** Validate runtime configuration before publishing any generated tool. */
  pub fn validate_client(client: AdapterClient) -> nil {
    if client.base_url.trim() == "" {
      throw "harn-openapi.generated: base URL configuration is required"
    }
    {{ for op in published_operations }}_validate_{{ op.fn_name }}_client(client)
    {{ end }}return nil
  }

  {{ for op in published_operations }}fn _validate_{{ op.fn_name }}_client(client: AdapterClient) -> nil {
    if !{{ op.security_available_call }}(client) {
      throw "{{ op.security_error }}"
    }
    return nil
  }

  {{ end }}

  fn _no_auth_headers(client: AdapterClient) -> AdapterHeaders {
    let hs: AdapterHeaders = {"Content-Type": "application/json"}
    for entry in client.extra_headers {
      hs = {...hs, [entry.key]: entry.value}
    }
    return hs
  }

  fn _merge_header_dicts(header_sets: list<AdapterHeaders>) -> AdapterHeaders {
    let out: AdapterHeaders = {}
    for hs in header_sets {
      for entry in hs {
        out = {...out, [entry.key]: entry.value}
      }
    }
    return out
  }

  fn _with_extra_headers(headers: AdapterHeaders, client: AdapterClient) -> AdapterHeaders {
    let hs = headers
    for entry in client.extra_headers {
      hs = {...hs, [entry.key]: entry.value}
    }
    return hs
  }

  fn _append_cookie_header(headers: AdapterHeaders, name: string, value: any) -> AdapterHeaders {
    if value == nil {
      return headers
    }
    let pair = url_encode(name) + "=" + url_encode(to_string(value))
    let existing = headers.get("Cookie") ?? headers.get("cookie")
    if existing == nil || existing == "" {
      return {...headers, Cookie: pair}
    }
    return {...headers, Cookie: to_string(existing) + "; " + pair}
  }

  /** Build a token-provider hook backed by the active connector SecretProvider. */
  pub fn token_from_secret(secrets: HarnessSecrets, secret_id: string) -> fn() -> string {
    return fn() {
      let value = secrets.read(secret_id)
      if value == nil {
        return ""
      }
      return to_string(value)
    }
  }

  /** Build an api-key-provider hook backed by the active connector SecretProvider. */
  pub fn api_key_from_secret(secrets: HarnessSecrets, secret_id: string) -> fn() -> string {
    return fn() {
      let value = secrets.read(secret_id)
      if value == nil {
        return ""
      }
      return to_string(value)
    }
  }

  fn _client_credential(client: AdapterClient, scheme_name: string) -> dict {
    return client.credentials.get(scheme_name) ?? {}
  }

  fn _credential_available(client: AdapterClient, scheme_name: string, kind: string) -> bool {
    const credential = _client_credential(client, scheme_name)
    if kind == "bearer" {
      return credential.get("token_provider") != nil
        || to_string(credential.get("token") ?? "") != ""
    }
    if starts_with(kind, "api_key_") {
      return credential.get("value_provider") != nil
        || to_string(credential.get("value") ?? "") != ""
    }
    if kind == "basic" {
      return credential.get("basic_provider") != nil
        || (to_string(credential.get("username") ?? "") != ""
          && to_string(credential.get("password") ?? "") != "")
    }
    if kind == "mutual_tls" {
      return credential.get("host_configured") == true
    }
    return false
  }

  fn _client_token(client: AdapterClient, scheme_name: string) -> string {
    const credential = _client_credential(client, scheme_name)
    let provider = credential.get("token_provider")
    if provider != nil {
      return to_string(provider())
    }
    return to_string(credential.get("token") ?? "")
  }

  fn _client_api_key(client: AdapterClient, scheme_name: string) -> string {
    const credential = _client_credential(client, scheme_name)
    let provider = credential.get("value_provider")
    if provider != nil {
      return to_string(provider())
    }
    return to_string(credential.get("value") ?? "")
  }

  fn _client_basic(client: AdapterClient, scheme_name: string) -> dict {
    const credential = _client_credential(client, scheme_name)
    let provider = credential.get("basic_provider")
    if provider != nil {
      const provided = provider()
      return {user: provided.username, password: provided.password}
    }
    return {user: credential.get("username") ?? "", password: credential.get("password") ?? ""}
  }

  {{ for helper in auth_helpers }}
  {{ helper.body }}
  {{ end }}
  /** Pagination plans detected from the OpenAPI operation shapes. */
  pub fn pagination_plans() -> list {
    return {{ pagination_plan_literal }}
  }

  /** Look up the pagination plan for a given operation id, or nil if none. */
  pub fn pagination_plan(operation_id: string) -> dict? {
    for plan in pagination_plans() {
      if plan.operation_id == operation_id {
        return plan
      }
    }
    return nil
  }

  /** Extract the items list from `response` according to `plan`. */
  pub fn pagination_items(response: dict, plan: dict) -> list {
    let field = plan.get("items_field")
    if field == nil {
      return []
    }
    let value = response.get(field)
    if type_of(value) == "list" {
      return value
    }
    return []
  }

  /**
   * Compute the next-page directive from `response` according to `plan`.
   * Returns a dict with `done: bool` plus a `query` or `body` dict to merge
   * into the next call, or a `url` to follow (next-link style).
   */
  pub fn pagination_next(response: dict, plan: dict) -> dict {
    let kind = plan.get("kind")
    if kind == "cursor" {
      let cursor_field = plan.get("cursor_response_field")
      let cursor = if cursor_field == nil {
        nil
      } else {
        response.get(cursor_field)
      }
      let has_more_field = plan.get("has_more_field")
      let has_more = if has_more_field == nil {
        cursor != nil
      } else {
        response.get(has_more_field)
      }
      let field = plan.get("cursor_param")
      if plan.get("cursor_location") == "body" {
        return {done: cursor == nil || !has_more, body: {[field]: cursor}}
      }
      return {done: cursor == nil || !has_more, query: {[field]: cursor}}
    }
    if kind == "page" {
      return {done: false, query: {}}
    }
    if kind == "next_link" {
      let field = plan.get("next_link_field")
      let url = if field == nil {
        nil
      } else {
        response.get(field)
      }
      return {done: url == nil || url == "", url: url}
    }
    return {done: true, query: {}}
  }

  /** Rate-limit response/header conventions detected from OpenAPI responses. */
  pub fn rate_limit_metadata() -> list {
    return {{ rate_limit_metadata_literal }}
  }

  fn _header_ci(headers: dict, wanted: string) {
    for entry in headers {
      if entry.key.lower() == wanted.lower() {
        return entry.value
      }
    }
    return nil
  }

  /** Extract status + standard rate-limit headers from a raw HTTP response. */
  pub fn rate_limit_from_response(resp: dict) -> dict {
    let headers = resp.get("headers") ?? {}
    return {
      status: resp.get("status"),
      retry_after: _header_ci(headers, "Retry-After"),
      limit: _header_ci(headers, "RateLimit-Limit")
        ?? _header_ci(headers, "X-RateLimit-Limit"),
      remaining: _header_ci(headers, "RateLimit-Remaining")
        ?? _header_ci(headers, "X-RateLimit-Remaining"),
      reset: _header_ci(headers, "RateLimit-Reset")
        ?? _header_ci(headers, "X-RateLimit-Reset"),
    }
  }

  /** True if the response looks rate-limited (HTTP 429 or Retry-After set). */
  pub fn is_rate_limited_response(resp: dict) -> bool {
    let headers = resp.get("headers") ?? {}
    return resp.get("status") == 429 || _header_ci(headers, "Retry-After") != nil
  }

  fn _interpolate(template: string, bindings: dict) -> string {
    let out = template
    for entry in bindings {
      out = replace(out, "{" + entry.key + "}", url_encode(to_string(entry.value)))
    }
    return out
  }

  fn _join_url(base_url: string, path: string) -> string {
    if base_url == "" {
      return path
    }
    if path == "" {
      return base_url
    }
    let base_has_slash = substring(base_url, len(base_url) - 1, len(base_url)) == "/"
    let path_has_slash = starts_with(path, "/")
    if base_has_slash && path_has_slash {
      return substring(base_url, 0, len(base_url) - 1) + path
    }
    if !base_has_slash && !path_has_slash {
      return base_url + "/" + path
    }
    return base_url + path
  }

  fn _query_string(params: dict) -> string {
    let parts = []
    for entry in params {
      if entry.value != nil {
        parts = parts + [url_encode(entry.key) + "=" + url_encode(to_string(entry.value))]
      }
    }
    if len(parts) == 0 {
      return ""
    }
    return "?" + join(parts, "&")
  }

  fn _strip_codegen_variant(body: any) -> dict {
    if type_of(body) != "dict" {
      throw "polymorphic request body must be a dict with a _variant marker"
    }
    let out = {}
    for entry in body {
      if entry.key != "_variant" {
        out = {...out, [entry.key]: entry.value}
      }
    }
    return out
  }

  {{ for op in operations }}
  {{ op.security_available_helper }}

  {{ op.security_helper }}

  {{ op.doc_comment }}
  {{ op.fn_decl }} {
    const operation_auth = {{ op.security_call }}(client)
    let path_bindings = {{ op.path_bindings }}
    let path = _interpolate("{{ op.path }}", path_bindings)
    {{ if op.has_query }}let query_bindings = {{ op.query_bindings }}
    let url = _join_url(client.base_url, path)
    url = url + _query_string(query_bindings){{ else }}let url = _join_url(client.base_url, path){{ end }}
    let request_headers = {{ op.headers_call }}{{ if op.header_cookie_lines }}
    {{ op.header_cookie_lines }}{{ end }}
    {{ op.request_lines }}
    {{ op.error_lines }}
    {{ op.return_lines }}
  }
  {{ op.body_variant_constructors }}
  {{ end }}
  """

const _ENTRYPOINT_TEMPLATE = """
  import {
    adapter_environment_config,
    adapter_registry,
  } from "{{ module_import }}"

  pipeline main(harness: Harness) {
    const registry = adapter_registry(
      {clock: harness.clock, net: harness.net},
      adapter_environment_config(harness.env),
    )
    harness.tools.mcp_tools(registry)
  }
  """

/** Emit a Harn SDK module as source code. */
pub fn codegen_module(fs: HarnessFs, doc: OpenApiDoc, options: dict) -> string {
  const module_name = options.get("module_name") ?? "generated_sdk"
  const client_name = options.get("client_name") ?? "Client"
  const default_base_url = options.get("default_base_url") ?? _default_server_url(doc)
  const header_overrides = options.get("header_overrides") ?? {}
  const transport = _transport_kind(options.get("transport") ?? "connector_policy")
  const schemes = doc.get("security_schemes") ?? {}
  const ops_raw = _operations(doc)
  const adapters = _adapter_operations(doc, options)
  const environment_prefix = options.get("environment_prefix")
    ?? _default_environment_prefix(module_name)
  const security_plan = adapter_security_plan(doc, environment_prefix)
  const environment_schemes = _entrypoint_environment_bindings(security_plan)
  let used_schemes = []
  for entry in security_plan.schemes {
    used_schemes = used_schemes + [entry.key]
  }
  const new_client_decl = _render_new_client_decl(default_base_url, header_overrides)
  const helper_names = _allocate_auth_helper_names(used_schemes, security_plan.schemes)
  // Emit per-scheme header/query helpers.
  let auth_helpers = []
  for scheme_name in used_schemes {
    const scheme = security_plan.schemes.get(scheme_name)
    if scheme != nil {
      auth_helpers = auth_helpers
        + [
          {
            body: _render_auth_helper(
              scheme,
              helper_names.headers.get(scheme_name),
              helper_names.queries.get(scheme_name),
            ),
          },
        ]
    }
  }
  // Second pass (response types): collect response-type aliases, keyed so
  // refs to the same component schema are emitted once and reused by every
  // operation that returns it.
  let alias_cache = {by_ref: {}, by_name: {}, order: []}
  let op_return_types = []
  for op in ops_raw {
    const rt = _resolve_response_type(doc, op, alias_cache)
    alias_cache = rt.cache
    op_return_types = op_return_types + [rt.info]
  }
  // Third pass: build operation models with per-op security dispatch and
  // typed return wired up.
  let ops = []
  let seen_names = []
  for entry in ops_raw.enumerate() {
    const op = entry.value
    const adapter = adapters[entry.index]
    const ret = op_return_types[entry.index]
    const choice = security_plan.operations.get(op.operation_id)
    if choice == nil {
      throw "harn-openapi.codegen_module: security plan lost operation '" + op.operation_id + "'"
    }
    const model = _build_op_model(
      doc,
      op,
      seen_names,
      choice,
      security_plan.schemes,
      ret,
      helper_names,
      header_overrides,
      transport,
      module_name,
      adapter,
    )
    seen_names = seen_names + [model.fn_name] + model.body_variant_fn_names
    ops = ops + [model]
  }
  let alias_entries = []
  for name in alias_cache.order {
    alias_entries = alias_entries + [{source: alias_cache.by_name.get(name)}]
  }
  const connector_imports = _connector_imports(op_return_types, transport)
  const adapter_authority_decl = if transport == "connector_policy" {
    "harness: {clock: HarnessClock, net: HarnessNet}"
  } else {
    "net: HarnessNet"
  }
  const adapter_authority_name = if transport == "connector_policy" {
    "harness"
  } else {
    "net"
  }
  const registry_info = filter_nil(
    {name: module_name, version: doc.info.version, description: doc.info.description},
  )
  let published_operations = []
  for op in ops {
    if op.adapter_expose {
      published_operations = published_operations + [op]
    }
  }
  const bindings = {
    doc_title: (doc.get("info") ?? {}).get("title") ?? module_name,
    openapi_version: doc.openapi,
    module_name: module_name,
    client_name: client_name,
    default_base_url: default_base_url,
    new_client_decl: new_client_decl,
    new_client_return: _render_new_client_return(),
    has_connector_imports: connector_imports != "",
    connector_imports: connector_imports,
    auth_helpers: auth_helpers,
    environment_schemes: environment_schemes,
    base_url_environment: _escape_string(security_plan.base_url_environment),
    adapter_authority: if transport == "connector_policy" {
      "{clock: harness.clock, net: harness.net}"
    } else {
      "harness.net"
    },
    operations: ops,
    published_operations: published_operations,
    adapter_operations: ops,
    adapter_tools_decl: _render_fn_decl_suffix(
      "adapter_tools",
      [adapter_authority_decl, "client: AdapterClient"],
      "ToolRegistry",
    ),
    adapter_catalog_decl: _render_fn_decl_suffix(
      "adapter_catalog",
      [adapter_authority_decl, "client: AdapterClient"],
      "ToolCatalog",
    ),
    adapter_tools_call: "adapter_tools(" + adapter_authority_name + ", client)",
    // The generated line has 43 fixed columns around the encoded JSON.
    // Match the formatter's 100-column boundary so short identities stay
    // inline and longer descriptions use the stable multiline form.
    registry_info: _render_json_parse_expr_at(registry_info, "    ", 57),
    response_aliases: alias_entries,
    pagination_plan_literal: _render_json_parse_expr(_pagination_plans(doc)),
    rate_limit_metadata_literal: _render_json_parse_expr(_rate_limit_metadata(doc)),
  }
  return _normalize_generated_source(fs.render_template(_MODULE_TEMPLATE, bindings), module_name)
}

fn _render_entrypoint_environment_read(scheme: AdapterSecuritySchemePlan, ident: string) -> string {
  if scheme.kind == "bearer" {
    const variable = ident + "_token"
    return "const "
      + variable
      + " = env.get(\""
      + _escape_string(scheme.environment.token)
      + "\")\n"
      + "  if "
      + variable
      + " != nil && "
      + variable
      + " != \"\" {\n"
      + "    credentials = {...credentials, "
      + _harn_dict_entry(scheme.name, "{token: " + variable + "}")
      + "}\n"
      + "  }"
  }
  if scheme.kind == "basic" {
    const username = ident + "_username"
    const password = ident + "_password"
    return "const "
      + username
      + " = env.get(\""
      + _escape_string(scheme.environment.username)
      + "\")\n"
      + "  const "
      + password
      + " = env.get(\""
      + _escape_string(scheme.environment.password)
      + "\")\n"
      + "  if "
      + username
      + " != nil && "
      + username
      + " != \"\"\n"
      + "    && "
      + password
      + " != nil\n"
      + "    && "
      + password
      + " != \"\" {\n"
      + "    credentials = {\n"
      + "      ...credentials,\n"
      + "      "
      + _harn_dict_key(scheme.name)
      + ": {\n"
      + "        username: "
      + username
      + ",\n"
      + "        password: "
      + password
      + ",\n"
      + "      },\n"
      + "    }\n"
      + "  }"
  }
  if starts_with(scheme.kind, "api_key_") {
    const variable = ident + "_value"
    return "const "
      + variable
      + " = env.get(\""
      + _escape_string(scheme.environment.value)
      + "\")\n"
      + "  if "
      + variable
      + " != nil && "
      + variable
      + " != \"\" {\n"
      + "    credentials = {...credentials, "
      + _harn_dict_entry(scheme.name, "{value: " + variable + "}")
      + "}\n"
      + "  }"
  }
  return ""
}

fn _entrypoint_environment_bindings(plan: AdapterSecurityPlan) -> list {
  let schemes = []
  let taken_idents = []
  for entry in plan.schemes {
    const ident = _unique_fn_name("credential_" + _sanitize_ident(entry.key), taken_idents)
    taken_idents = taken_idents + [ident]
    const read_lines = _render_entrypoint_environment_read(entry.value, ident)
    if read_lines != "" {
      schemes = schemes + [{read_lines: read_lines}]
    }
  }
  return schemes
}

/** Emit one executable registry entrypoint shared by CLI and MCP hosts. */
pub fn codegen_entrypoint(
  fs: HarnessFs,
  doc: OpenApiDoc,
  options: AdapterEntrypointOptions,
) -> string {
  if options.module_import.trim() == "" {
    throw "harn-openapi.codegen_entrypoint: module_import must be a non-empty package export"
  }
  const _ = adapter_security_plan(doc, options.environment_prefix)
  const bindings = {module_import: _escape_string(options.module_import)}
  return _normalize_generated_source(
    fs.render_template(_ENTRYPOINT_TEMPLATE, bindings),
    "adapter_entrypoint",
  )
}

/** Emit a harn.toml manifest for a generated SDK package. */
pub fn codegen_harn_toml(options: dict) -> string {
  const package_name = options.get("package_name") ?? options.get("module_name") ?? "generated-sdk"
  const version = options.get("version") ?? "0.0.0"
  const description = options.get("description") ?? "Generated Harn SDK package."
  const default_export = options.get("default_export") ?? "src/lib.harn"
  const types_export = options.get("types_export")
  const entrypoint_export = options.get("entrypoint_export")
  const dependencies = options.get("dependencies") ?? {}
  let out = "[package]\n"
  out = out + "name = \"" + _escape_toml_string(package_name) + "\"\n"
  out = out + "version = \"" + _escape_toml_string(version) + "\"\n"
  out = out + "description = \"" + _escape_toml_string(description) + "\"\n\n"
  out = out + "[exports]\n"
  out = out + "default = \"" + _escape_toml_string(default_export) + "\"\n"
  if types_export != nil {
    out = out + "types = \"" + _escape_toml_string(types_export) + "\"\n"
  }
  if entrypoint_export != nil {
    out = out + "entrypoint = \"" + _escape_toml_string(entrypoint_export) + "\"\n"
  }
  out = out + "\n[dependencies]\n"
  for entry in dependencies {
    out = out + _render_manifest_dependency(entry.key, entry.value)
  }
  return out
}

fn _allocate_auth_helper_names(used_schemes: any, schemes: any) {
  let header_names = {}
  let query_names = {}
  let taken = []
  for scheme_name in used_schemes {
    const header_base = "_headers_" + _sanitize_ident(scheme_name)
    const header_name = _unique_fn_name(header_base, taken)
    taken = taken + [header_name]
    header_names = {...header_names, [scheme_name]: header_name}
    const scheme = schemes.get(scheme_name)
    if scheme != nil && scheme.kind == "api_key_query" {
      const query_base = "_query_" + _sanitize_ident(scheme_name) + "_dict"
      const query_name = _unique_fn_name(query_base, taken)
      taken = taken + [query_name]
      query_names = {...query_names, [scheme_name]: query_name}
    }
  }
  return {headers: header_names, queries: query_names}
}

/**
 * Classify a security scheme into one of our supported kinds.
 *
 * Returns: "bearer" | "basic" | "apiKey-header" | "apiKey-query" |
 *          "apiKey-cookie" | "oauth2" | "openIdConnect" | "mutualTLS" |
 *          "unknown".
 */
fn _scheme_kind(def: any) {
  const ty = def.get("type")
  if ty == "http" {
    const scheme = def.get("scheme")
    if scheme == "bearer" {
      return "bearer"
    }
    if scheme == "basic" {
      return "basic"
    }
    return "unknown"
  }
  if ty == "apiKey" {
    const loc = def.get("in") ?? "header"
    if loc == "header" {
      return "apiKey-header"
    }
    if loc == "query" {
      return "apiKey-query"
    }
    if loc == "cookie" {
      return "apiKey-cookie"
    }
    return "unknown"
  }
  if ty == "oauth2" {
    return "oauth2"
  }
  if ty == "openIdConnect" {
    return "openIdConnect"
  }
  if ty == "mutualTLS" {
    return "mutualTLS"
  }
  return "unknown"
}

fn _render_new_client_decl(default_base_url: any, header_overrides: any) {
  const parts = [
    "base_url: string = \"" + _escape_string(default_base_url) + "\"",
    "credentials: dict<string, AdapterCredential> = {}",
    "extra_headers: AdapterHeaders = " + _render_dict_literal(header_overrides),
  ]
  return _render_fn_decl_suffix("new_client", parts, "AdapterClient")
}

fn _render_new_client_return() {
  const parts = ["base_url: base_url", "credentials: credentials", "extra_headers: extra_headers"]
  const inline = "{" + join(parts, ", ") + "}"
  if len("  return " + inline) <= 100 {
    return "return " + inline
  }
  let out = "return {\n"
  for part in parts {
    out = out + "    " + part + ",\n"
  }
  out = out + "  }"
  return out
}

fn _render_pub_fn_decl(name: any, params: any, return_type: any) {
  return "pub fn " + _render_fn_decl_suffix(name, params, return_type)
}

fn _render_fn_decl_suffix(name: any, params: any, return_type: any) {
  const inline = name + "(" + join(params, ", ") + ") -> " + return_type
  if len("pub fn " + inline + " {") <= 100 {
    return inline
  }
  let out = name + "(\n"
  for p in params {
    out = out + "  " + p + ",\n"
  }
  out = out + ") -> " + return_type
  return out
}

fn _normalize_generated_source(src: any, module_name: any) {
  let out = src
  while contains(out, "\n\n\n") {
    out = replace(out, "\n\n\n", "\n\n")
  }
  out = replace(
    out,
    " * Module:     " + module_name + "\n */\n\n",
    " * Module:     " + module_name + "\n */\n",
  )
  return out.trim() + "\n"
}

fn _transport_kind(value: any) {
  const transport = to_string(value ?? "raw")
  if transport == "raw" {
    return "raw"
  }
  if transport == "connector_policy" {
    return "connector_policy"
  }
  throw "harn-openapi.codegen_module: unsupported transport '" + transport
    + "' (expected 'raw' or 'connector_policy')"
}

fn _render_auth_helper(scheme: any, fn_name: any, query_fn_name: any) {
  const scheme_name = scheme.name
  const kind = scheme.kind
  if kind == "bearer" {
    return "fn " + fn_name + "(client: AdapterClient) -> dict {\n"
      + "  const token = _client_token(client, \""
      + _escape_string(scheme_name)
      + "\")\n"
      + "  if token == \"\" {\n"
      + "    throw \"harn-openapi.generated: security scheme '"
      + _escape_string(scheme_name)
      + "' produced no credential\"\n"
      + "  }\n"
      + "  let hs: dict = "
      + _render_binding_dict([_harn_dict_entry("Content-Type", "\"application/json\"")])
      + "\n"
      + "  if token != \"\" {\n"
      + "    hs = {...hs, Authorization: \"Bearer \" + token}\n"
      + "  }\n"
      + "  return _with_extra_headers(hs, client)\n"
      + "}"
  }
  if kind == "basic" {
    return "fn " + fn_name + "(client: AdapterClient) -> dict {\n"
      + "  const basic = _client_basic(client, \""
      + _escape_string(scheme_name)
      + "\")\n"
      + "  if basic.get(\"user\") == \"\" || basic.get(\"password\") == \"\" {\n"
      + "    throw \"harn-openapi.generated: security scheme '"
      + _escape_string(scheme_name)
      + "' requires both username and password\"\n"
      + "  }\n"
      + "  let hs: dict = "
      + _render_binding_dict([_harn_dict_entry("Content-Type", "\"application/json\"")])
      + "\n"
      + "  const encoded = base64_encode(to_string(basic.user) + \":\" + to_string(basic.password))\n"
      + "  hs = {...hs, Authorization: \"Basic \" + encoded}\n"
      + "  return _with_extra_headers(hs, client)\n"
      + "}"
  }
  if kind == "api_key_header" {
    const header_name = scheme.parameter_name
    return "fn " + fn_name + "(client: AdapterClient) -> dict {\n"
      + "  const api_key = _client_api_key(client, \""
      + _escape_string(scheme_name)
      + "\")\n"
      + "  if api_key == \"\" {\n"
      + "    throw \"harn-openapi.generated: security scheme '"
      + _escape_string(scheme_name)
      + "' produced no credential\"\n"
      + "  }\n"
      + "  let hs: dict = "
      + _render_binding_dict([_harn_dict_entry("Content-Type", "\"application/json\"")])
      + "\n"
      + "  hs = {...hs, "
      + _harn_dict_entry(header_name, "api_key")
      + "}\n"
      + "  return _with_extra_headers(hs, client)\n"
      + "}"
  }
  if kind == "api_key_cookie" {
    const cookie_name = scheme.parameter_name
    return "fn " + fn_name + "(client: AdapterClient) -> dict {\n"
      + "  const api_key = _client_api_key(client, \""
      + _escape_string(scheme_name)
      + "\")\n"
      + "  if api_key == \"\" {\n"
      + "    throw \"harn-openapi.generated: security scheme '"
      + _escape_string(scheme_name)
      + "' produced no credential\"\n"
      + "  }\n"
      + "  let hs: dict = "
      + _render_binding_dict([_harn_dict_entry("Content-Type", "\"application/json\"")])
      + "\n"
      + "  hs = _append_cookie_header(hs, \""
      + _escape_string(cookie_name)
      + "\", api_key)\n"
      + "  return _with_extra_headers(hs, client)\n"
      + "}"
  }
  if kind == "api_key_query" {
    // Headers helper adds nothing beyond Content-Type; a parallel
    // _query_<scheme>_dict helper contributes the auth parameter dict
    // which is spread into each operation's query bindings.
    const query_name = scheme.parameter_name
    return "fn " + fn_name + "(client: AdapterClient) -> dict {\n"
      + "  let hs: dict = "
      + _render_binding_dict([_harn_dict_entry("Content-Type", "\"application/json\"")])
      + "\n"
      + "  return _with_extra_headers(hs, client)\n"
      + "}\n"
      + "\n"
      + "fn "
      + query_fn_name
      + "(client: AdapterClient) -> dict {\n"
      + "  const v = _client_api_key(client, \""
      + _escape_string(scheme_name)
      + "\")\n"
      + "  if v == \"\" {\n"
      + "    throw \"harn-openapi.generated: security scheme '"
      + _escape_string(scheme_name)
      + "' produced no credential\"\n"
      + "  }\n"
      + "  return {"
      + _harn_dict_entry(query_name, "v")
      + "}\n"
      + "}"
  }
  return "fn " + fn_name + "(client: AdapterClient) -> dict {\n"
    + "  return _no_auth_headers(client)\n"
    + "}"
}

fn _default_server_url(doc: any) {
  const servers = doc.get("servers") ?? []
  if len(servers) == 0 {
    return ""
  }
  return servers[0].get("url") ?? ""
}

fn _default_environment_prefix(module_name: string) -> string {
  const stem =
    regex_replace("^_+|_+$", "", regex_replace("[^A-Za-z0-9]+", "_", module_name)).upper()
  if stem == "" {
    throw "harn-openapi.codegen_module: module_name must produce a portable environment prefix"
  }
  return "HARN_" + stem
}

fn _operation_param_models(params: any) {
  let path_params = []
  let query_params = []
  let header_params = []
  let cookie_params = []
  let taken_param_idents = []
  for p in params {
    if p.get("name") != nil {
      const ident = _unique_fn_name(_sanitize_ident(p.get("name")), taken_param_idents)
      taken_param_idents = taken_param_idents + [ident]
      const modeled = _merge_shallow(p, {ident: ident})
      const loc = p.get("in") ?? "query"
      if loc == "path" {
        path_params = path_params + [modeled]
      } else if loc == "query" {
        query_params = query_params + [modeled]
      } else if loc == "header" {
        header_params = header_params + [modeled]
      } else if loc == "cookie" {
        cookie_params = cookie_params + [modeled]
      }
    }
  }
  return {path: path_params, query: query_params, header: header_params, cookie: cookie_params}
}

fn _x_harn_config(op: any) -> dict {
  const value = op.get("x_harn") ?? {}
  if type_of(value) != "dict" {
    throw "harn-openapi.codegen_module: x-harn on '" + op.operation_id
      + "' must be an object"
  }
  const allowed = [
    "expose",
    "name",
    "title",
    "namespace",
    "defer_loading",
    "annotations",
    "icons",
    "execution",
    "governance",
    "cli",
    "meta",
  ]
  for entry in value {
    if !allowed.contains(entry.key) {
      throw "harn-openapi.codegen_module: unknown x-harn field '" + entry.key + "' on '"
        + op.operation_id
        + "'"
    }
  }
  for bool_key in ["expose", "defer_loading"] {
    const bool_value = value.get(bool_key)
    if bool_value != nil && type_of(bool_value) != "bool" {
      throw "harn-openapi.codegen_module: x-harn." + bool_key + " on '" + op.operation_id
        + "' must be a bool"
    }
  }
  for string_key in ["name", "title", "namespace"] {
    const string_value = value.get(string_key)
    if string_value != nil && (type_of(string_value) != "string" || string_value == "") {
      throw "harn-openapi.codegen_module: x-harn." + string_key + " on '" + op.operation_id
        + "' must be a non-empty string"
    }
  }
  const adapter_name = value.get("name")
  if adapter_name != nil
    && (len(adapter_name) > 128 || regex_match("^[A-Za-z0-9_.-]+$", adapter_name) == nil) {
    throw "harn-openapi.codegen_module: x-harn.name on '" + op.operation_id
      + "' must be at most 128 letters, digits, underscores, dots, or hyphens"
  }
  for dict_key in ["annotations", "cli", "meta"] {
    const dict_value = value.get(dict_key)
    if dict_value != nil && type_of(dict_value) != "dict" {
      throw "harn-openapi.codegen_module: x-harn." + dict_key + " on '" + op.operation_id
        + "' must be an object"
    }
  }
  const cli = value.get("cli") ?? {}
  for entry in cli {
    if !["command", "hidden"].contains(entry.key) {
      throw "harn-openapi.codegen_module: unknown x-harn.cli field '" + entry.key + "' on '"
        + op.operation_id
        + "'"
    }
  }
  if cli.get("hidden") != nil && type_of(cli.get("hidden")) != "bool" {
    throw "harn-openapi.codegen_module: x-harn.cli.hidden on '" + op.operation_id
      + "' must be a bool"
  }
  return {
    ...value,
    governance: normalize_adapter_governance(value.get("governance"), op.operation_id),
  }
}

fn _adapter_icons(op: any, extension: any) {
  const icons = extension.get("icons")
  if icons == nil {
    return nil
  }
  if type_of(icons) != "list" {
    throw "harn-openapi.codegen_module: x-harn.icons on '" + op.operation_id
      + "' must be a list"
  }
  let normalized = []
  for {index, value} in icons.enumerate() {
    const field = "x-harn.icons[" + to_string(index) + "]"
    if type_of(value) != "dict" {
      throw "harn-openapi.codegen_module: " + field + " on '" + op.operation_id
        + "' must be an object"
    }
    for entry in value {
      if !["src", "mimeType", "sizes", "theme"].contains(entry.key) {
        throw "harn-openapi.codegen_module: unknown " + field + " field '" + entry.key
          + "' on '"
          + op.operation_id
          + "'"
      }
    }
    const src = value.get("src")
    if type_of(src) != "string" || src == "" {
      throw "harn-openapi.codegen_module: " + field + ".src on '" + op.operation_id
        + "' must be a non-empty string"
    }
    const mime_type = value.get("mimeType")
    if mime_type != nil && (type_of(mime_type) != "string" || mime_type == "") {
      throw "harn-openapi.codegen_module: " + field + ".mimeType on '" + op.operation_id
        + "' must be a non-empty string"
    }
    const sizes = value.get("sizes")
    if sizes != nil {
      if type_of(sizes) != "list" {
        throw "harn-openapi.codegen_module: " + field + ".sizes on '" + op.operation_id
          + "' must be a list of non-empty strings"
      }
      for size in sizes {
        if type_of(size) != "string" || size == "" {
          throw "harn-openapi.codegen_module: " + field + ".sizes on '" + op.operation_id
            + "' must be a list of non-empty strings"
        }
      }
    }
    const theme = value.get("theme")
    if theme != nil && !["light", "dark"].contains(theme) {
      throw "harn-openapi.codegen_module: " + field + ".theme on '" + op.operation_id
        + "' must be 'light' or 'dark'"
    }
    normalized = normalized + [value]
  }
  return normalized
}

fn _adapter_execution(op: any, extension: any) {
  const execution = extension.get("execution")
  if execution == nil {
    return nil
  }
  if type_of(execution) != "dict" {
    throw "harn-openapi.codegen_module: x-harn.execution on '" + op.operation_id
      + "' must be an object"
  }
  for entry in execution {
    if entry.key != "taskSupport" {
      throw "harn-openapi.codegen_module: unknown x-harn.execution field '" + entry.key
        + "' on '"
        + op.operation_id
        + "'"
    }
  }
  const task_support = execution.get("taskSupport")
  if !["forbidden", "optional", "required"].contains(task_support) {
    throw "harn-openapi.codegen_module: x-harn.execution.taskSupport on '" + op.operation_id
      + "' must be 'forbidden', 'optional', or 'required'"
  }
  return {taskSupport: task_support}
}

fn _adapter_annotations(op: any, extension: any) -> dict {
  const method = op.method.upper()
  const read_only = ["GET", "HEAD", "OPTIONS"].contains(method)
  let annotations: dict = {
    readOnlyHint: read_only,
    destructiveHint: !read_only,
    idempotentHint: ["GET", "HEAD", "OPTIONS", "PUT", "DELETE"].contains(method),
    openWorldHint: true,
  }
  for entry in extension.get("annotations") ?? {} {
    if !["readOnlyHint", "destructiveHint", "idempotentHint", "openWorldHint"].contains(entry.key) {
      throw "harn-openapi.codegen_module: unknown x-harn.annotations field '" + entry.key
        + "' on '"
        + op.operation_id
        + "'"
    }
    if type_of(entry.value) != "bool" {
      throw "harn-openapi.codegen_module: x-harn.annotations." + entry.key + " on '"
        + op.operation_id
        + "' must be a bool"
    }
    annotations = {...annotations, [entry.key]: entry.value}
  }
  if annotations.readOnlyHint && annotations.destructiveHint {
    throw "harn-openapi.codegen_module: x-harn.annotations on '" + op.operation_id
      + "' cannot be both read-only and destructive"
  }
  return annotations
}

fn _adapter_policy(op: any) -> dict {
  const method = op.method.upper()
  return {
    kind: if ["GET", "HEAD", "OPTIONS"].contains(method) {
      "fetch"
    } else {
      "execute"
    },
    side_effect_level: "network",
  }
}

fn _adapter_parameter_schema(doc: any, parameter: any) -> dict {
  const raw = parameter.get("schema")
  if raw == nil {
    return {}
  }
  return _schema(doc, raw)
}

fn _adapter_input_schema(doc: any, op: any, header_overrides: any) -> dict {
  const params = _operation_param_models(op.parameters)
  let properties = {}
  let required = []
  for parameter in params.path + params.query + params.header + params.cookie {
    if parameter.get("in") == "header" && header_overrides.get(parameter.name) != nil {
      continue
    }
    let property_schema = _adapter_parameter_schema(doc, parameter)
    const description = parameter.get("description")
    if description != nil && property_schema.get("description") == nil {
      property_schema = {...property_schema, description: description}
    }
    properties = {...properties, [parameter.ident]: property_schema}
    if parameter.get("in") == "path" || parameter.get("required") {
      required = required + [parameter.ident]
    }
  }
  if op.request_body != nil {
    const request_schema = _request_json_schema(doc, op.request_body)
    properties = {
      ...properties,
      body: if request_schema == nil {
        {}
      } else {
        _schema(doc, request_schema)
      },
    }
    if _request_body_required(doc, op.request_body) {
      required = required + ["body"]
    }
  }
  return {type: "object", properties: properties, required: required, additionalProperties: false}
}

fn _adapter_output_schema(doc: any, op: any) {
  const picked = _pick_success_response(doc, op)
  if picked == nil || picked.kind != "json" || picked.schema == nil {
    return nil
  }
  return _schema(doc, picked.schema)
}

fn _adapter_tool_parameters(input_schema: any) -> dict {
  const properties = input_schema.get("properties") ?? {}
  const required = input_schema.get("required") ?? []
  let parameters = {}
  for entry in properties {
    parameters = {
      ...parameters,
      [entry.key]: {schema: entry.value, required: required.contains(entry.key)},
    }
  }
  return parameters
}

fn _adapter_cli(op: any, extension: any, name: any) -> dict {
  const explicit = extension.get("cli") ?? {}
  const command = explicit.get("command")
  let command_path = []
  if type_of(command) == "string" {
    command_path = [command]
  } else if type_of(command) == "list" {
    if len(command) == 0 {
      throw "harn-openapi.codegen_module: x-harn.cli.command on '" + op.operation_id
        + "' must contain at least one portable command name"
    }
    for segment in command {
      if type_of(segment) != "string" || segment == "" {
        throw "harn-openapi.codegen_module: x-harn.cli.command on '" + op.operation_id
          + "' must contain portable command names"
      }
    }
    command_path = command
  } else if command != nil {
    throw "harn-openapi.codegen_module: x-harn.cli.command on '" + op.operation_id
      + "' must be a string or list of strings"
  } else {
    let default_parts = []
    const namespace = extension.get("namespace")
    if namespace != nil {
      default_parts = default_parts + namespace.split(".")
    } else {
      const tags = op.tags ?? []
      if len(tags) > 0 {
        default_parts = default_parts + [_sanitize_ident(tags[0])]
      }
    }
    command_path = default_parts + name.split(".")
  }
  for segment in command_path {
    if regex_match("^[A-Za-z0-9_][A-Za-z0-9_-]*$", segment) == nil {
      throw "harn-openapi.codegen_module: x-harn.cli.command on '" + op.operation_id
        + "' must contain portable command names"
    }
  }
  return {...explicit, command: command_path}
}

fn _adapter_operation(doc: any, op: any, function_name: any, header_overrides: any) {
  const extension = _x_harn_config(op)
  const name = extension.get("name") ?? function_name
  const extension_title = extension.get("title")
  const title = if type_of(extension_title) == "string" && extension_title != "" {
    extension_title
  } else if op.summary != "" {
    op.summary
  } else {
    op.operation_id
  }
  const description = if op.description != "" {
    op.description
  } else if op.summary != "" {
    op.summary
  } else {
    op.operation_id
  }
  return {
    name: name,
    title: title,
    description: description,
    input_schema: _adapter_input_schema(doc, op, header_overrides),
    output_schema: _adapter_output_schema(doc, op),
    annotations: _adapter_annotations(op, extension),
    icons: _adapter_icons(op, extension),
    execution: _adapter_execution(op, extension),
    governance: extension.governance,
    policy: _adapter_policy(op),
    source: {
      kind: "openapi",
      id: op.operation_id,
      binding: {method: op.method.upper(), path: op.path},
    },
    cli: _adapter_cli(op, extension, name),
    expose: extension.get("expose") ?? true,
    defer_loading: extension.get("defer_loading") ?? false,
    namespace: extension.get("namespace"),
    meta: extension.get("meta") ?? {},
  }
}

fn _signature_model(
  doc: any,
  op: any,
  path_params: any,
  query_params: any,
  header_params: any,
  cookie_params: any,
  header_overrides: any,
) {
  let required_sig = ["client: AdapterClient"]
  let optional_sig = []
  let required_arg_names = []
  let optional_arg_names = []
  let path_bindings_parts = []
  for p in path_params {
    const name = p.get("name")
    const nm = p.ident
    required_sig = required_sig + [nm + ": any"]
    required_arg_names = required_arg_names + [nm]
    path_bindings_parts = path_bindings_parts + [_harn_dict_entry(name, nm)]
  }
  let query_bindings_parts = []
  for p in query_params {
    const name = p.get("name")
    const nm = p.ident
    if p.get("required") {
      required_sig = required_sig + [nm + ": any"]
      required_arg_names = required_arg_names + [nm]
    } else {
      optional_sig = optional_sig + [nm + ": any = nil"]
      optional_arg_names = optional_arg_names + [nm]
    }
    query_bindings_parts = query_bindings_parts + [_harn_dict_entry(name, nm)]
  }
  for p in header_params {
    const nm = p.ident
    if p.get("required") && header_overrides.get(p.name) == nil {
      required_sig = required_sig + [nm + ": any"]
      required_arg_names = required_arg_names + [nm]
    } else {
      optional_sig = optional_sig + [nm + ": any = nil"]
      optional_arg_names = optional_arg_names + [nm]
    }
  }
  for p in cookie_params {
    const nm = p.ident
    if p.get("required") {
      required_sig = required_sig + [nm + ": any"]
      required_arg_names = required_arg_names + [nm]
    } else {
      optional_sig = optional_sig + [nm + ": any = nil"]
      optional_arg_names = optional_arg_names + [nm]
    }
  }
  const has_body = op.request_body != nil
  const body_required = has_body && _request_body_required(doc, op.request_body)
  if has_body {
    if body_required {
      required_sig = required_sig + ["body: any"]
      required_arg_names = required_arg_names + ["body"]
    } else {
      optional_sig = optional_sig + ["body: any = nil"]
      optional_arg_names = optional_arg_names + ["body"]
    }
  }
  return {
    required: required_sig,
    optional: optional_sig,
    path_bindings_parts: path_bindings_parts,
    query_bindings_parts: query_bindings_parts,
    has_body: has_body,
    body_required: body_required,
    required_arg_names: required_arg_names,
    optional_arg_names: optional_arg_names,
  }
}

fn _build_op_model(
  doc: any,
  op: any,
  taken_names: any,
  choice: any,
  schemes: any,
  ret: any,
  helper_names: any,
  header_overrides: any,
  transport: any,
  module_name: any,
  adapter: any,
) {
  const fn_name = _unique_fn_name(_sanitize_ident(op.operation_id), taken_names)
  const param_model = _operation_param_models(op.parameters)
  const path_params = param_model.path
  const query_params = param_model.query
  const header_params = param_model.header
  const cookie_params = param_model.cookie
  const sig = _signature_model(
    doc,
    op,
    path_params,
    query_params,
    header_params,
    cookie_params,
    header_overrides,
  )
  // Every operation leads with exactly the capability surface its selected
  // transport needs. Connector policy needs a clock for retry timing plus
  // network access; raw transport only needs network access.
  const capability_param = if transport == "connector_policy" {
    "harness: {clock: HarnessClock, net: HarnessNet}"
  } else {
    "net: HarnessNet"
  }
  const sig_parts = [capability_param] + sig.required + sig.optional
  const has_body = sig.has_body
  const body_required = sig.body_required
  const path_bindings_parts = sig.path_bindings_parts
  const query_bindings_parts = sig.query_bindings_parts
  const security_helper = _render_operation_security_helper(
    fn_name,
    op.operation_id,
    choice,
    schemes,
    helper_names,
  )
  const security_available_helper = _render_operation_security_available_helper(
    fn_name,
    choice,
    schemes,
  )
  const doc_lines = split(op.summary, "\n")
  const first = if len(doc_lines) > 0 {
    doc_lines[0]
  } else {
    ""
  }
  const safe_summary = if first == "" {
    op.operation_id
  } else {
    first
  }
  const doc_comment = "/** " + _escape_comment(safe_summary) + " */"
  const body_variants = _body_variants_for_op(doc, op, fn_name, taken_names)
  const body_prepare = _render_body_prepare(fn_name, body_variants)
  const idempotency_key_param = _idempotency_key_param(header_params)
  return {
    fn_name: fn_name,
    method: op.method,
    path: op.path,
    fn_decl: _render_pub_fn_decl(fn_name, sig_parts, ret.type_name),
    path_bindings: path_bindings_parts_render(path_bindings_parts),
    query_bindings: _render_binding_dict(query_bindings_parts + ["...operation_auth.query"]),
    has_query: true,
    has_body: has_body,
    body_prepare: body_prepare,
    header_cookie_lines: _render_header_cookie_lines(header_params, cookie_params),
    request_lines: _render_request_lines(
      op.method,
      has_body,
      body_required,
      body_prepare,
      transport,
      ret,
      fn_name,
      module_name,
      idempotency_key_param,
    ),
    body_variant_constructors: _render_body_variant_constructors(body_variants),
    body_variant_fn_names: _body_variant_fn_names(body_variants),
    doc_comment: doc_comment,
    headers_call: "operation_auth.headers",
    security_available_helper: security_available_helper,
    security_available_call: "_security_available_" + fn_name,
    security_error: _escape_string(_operation_security_error(op.operation_id, choice)),
    security_helper: security_helper,
    security_call: "_security_" + fn_name,
    return_type: ret.type_name,
    returns_nil: ret.returns_nil,
    return_lines: _render_return_lines(fn_name, ret, transport),
    error_lines: _render_error_lines(fn_name, transport),
    adapter_expose: adapter.expose,
    adapter_name: _escape_string(adapter.name),
    adapter_title: _escape_string(adapter.title),
    adapter_description: _escape_string(adapter.description),
    adapter_parameters: _render_json_parse_expr_at(
      _adapter_tool_parameters(adapter.input_schema),
      "      ",
      67,
    ),
    adapter_output_schema: if adapter.output_schema == nil {
      ""
    } else {
      _render_json_parse_expr_at(adapter.output_schema, "      ", 70)
    },
    adapter_handler: _render_adapter_handler(
      fn_name,
      sig.required_arg_names + sig.optional_arg_names,
      transport,
    ),
    adapter_annotations: _render_json_parse_expr_at(adapter.annotations, "      ", 66),
    adapter_icons: if adapter.icons == nil {
      ""
    } else {
      _render_json_parse_expr_at(adapter.icons, "      ", 66)
    },
    adapter_execution: if adapter.execution == nil {
      ""
    } else {
      _render_json_parse_expr_at(adapter.execution, "      ", 66)
    },
    adapter_policy: _render_json_parse_expr_at(adapter.policy, "      ", 66),
    adapter_governance: _render_json_parse_expr_at(adapter.governance, "      ", 66),
    adapter_cli: _render_json_parse_expr_at(adapter.cli, "      ", 66),
    adapter_source: _render_json_parse_expr_at(adapter.source, "      ", 66),
    adapter_defer_loading: to_string(adapter.defer_loading),
    adapter_namespace: if adapter.namespace == nil {
      ""
    } else {
      _escape_string(adapter.namespace)
    },
    adapter_meta: _render_json_parse_expr_at(adapter.meta, "      ", 73),
  }
}

fn _render_adapter_handler(function_name: any, argument_names: any, transport: any) {
  const authority = if transport == "connector_policy" {
    "harness"
  } else {
    "net"
  }
  let args = [authority, "client"]
  for name in argument_names {
    args = args + ["args.get(\"" + _escape_string(name) + "\")"]
  }
  const inline = function_name + "(" + join(args, ", ") + ")"
  if len("      handler: { args -> " + inline + " },") <= 100 {
    return "handler: { args -> " + inline + " }"
  }
  if 8 + len(inline) <= 100 {
    return "handler: { args ->\n        " + inline + "\n      }"
  }
  let out = "handler: { args ->\n        " + function_name + "(\n"
  for arg in args {
    out = out + "          " + arg + ",\n"
  }
  return out + "        )\n      }"
}

/**
 * Build the `throw { ... }` statement for non-2xx responses, matching
 * `harn fmt` width logic so the generated source is already canonical.
 * Include the operation-body and `throw` indentation in the line-width
 * calculation so raw-transport output is canonical without a formatter pass.
 */
fn _render_error_throw(fn_name: any) {
  const dict_inline = "operation: \""
    + fn_name
    + "\", status: resp.status, body: resp.body, headers: resp.headers"
  if 12 + len(dict_inline) <= 100 {
    return "throw {" + dict_inline + "}"
  }
  return "throw {\n"
    + "      operation: \""
    + fn_name
    + "\",\n"
    + "      status: resp.status,\n"
    + "      body: resp.body,\n"
    + "      headers: resp.headers,\n"
    + "    }"
}

fn _render_error_lines(fn_name: any, transport: any) {
  if transport == "connector_policy" {
    return "if !(resp.ok ?? false) {\n"
      + "    throw resp\n"
      + "  }"
  }
  return "if resp.status >= 400 {\n"
    + "    "
    + _render_error_throw(fn_name)
    + "\n"
    + "  }"
}

fn path_bindings_parts_render(parts: any) {
  return _render_binding_dict(parts)
}

fn _render_headers_call(scheme_names: any, helper_names: any) {
  if len(scheme_names) == 0 {
    return "_no_auth_headers(client)"
  }
  let calls = []
  for scheme_name in scheme_names {
    const helper = helper_names.headers.get(scheme_name)
    if helper != nil {
      calls = calls + [helper + "(client)"]
    }
  }
  if len(calls) == 0 {
    return "_no_auth_headers(client)"
  }
  if len(calls) == 1 {
    return calls[0]
  }
  return "_merge_header_dicts([" + join(calls, ", ") + "])"
}

fn _render_operation_security_helper(
  function_name: string,
  operation_id: string,
  operation: any,
  schemes: any,
  helper_names: any,
) -> string {
  const helper_name = "_security_" + function_name
  let out = "fn " + helper_name + "(client: AdapterClient) -> dict {\n"
  let unconditionally_satisfied = false
  for alternative in operation.alternatives {
    if len(alternative.schemes) == 0 {
      out = out + "  return {headers: _no_auth_headers(client), query: {}}\n"
      unconditionally_satisfied = true
      break
    } else {
      let query_schemes = []
      for scheme_name in alternative.schemes {
        const scheme = schemes.get(scheme_name)
        if scheme.kind == "api_key_query" {
          query_schemes = query_schemes + [scheme_name]
        }
      }
      out = out + "  if " + _render_security_condition(alternative, schemes) + " {\n"
      out = out
        + _render_security_result(
          _render_headers_call(alternative.schemes, helper_names),
          _render_query_bindings([], query_schemes, helper_names),
        )
      out = out + "  }\n"
    }
  }
  if unconditionally_satisfied {
    return out + "}"
  }
  out = out + "  throw \"" + _escape_string(_operation_security_error(operation_id, operation))
    + "\"\n"
  return out + "}"
}

fn _render_security_result(headers: string, query: string) -> string {
  const inline = "{headers: " + headers + ", query: " + query + "}"
  if 11 + len(inline) <= 100 {
    return "    return " + inline + "\n"
  }
  return "    return {\n"
    + "      headers: "
    + headers
    + ",\n"
    + "      query: "
    + query
    + ",\n"
    + "    }\n"
}

fn _operation_security_error(operation_id: string, operation: any) -> string {
  let rendered_alternatives = []
  for alternative in operation.alternatives {
    rendered_alternatives = rendered_alternatives
      + [
        if len(alternative.schemes) == 0 {
          "anonymous"
        } else {
          join(alternative.schemes, "+")
        },
      ]
  }
  return "harn-openapi.generated: operation '" + operation_id + "' requires one of ["
    + join(rendered_alternatives, ", ")
    + "]"
}

fn _render_security_condition(alternative: any, schemes: any) -> string {
  if len(alternative.schemes) == 0 {
    return "true"
  }
  let checks = []
  for scheme_name in alternative.schemes {
    const scheme = schemes.get(scheme_name)
    checks = checks
      + [
        "_credential_available(client, \""
          + _escape_string(scheme_name)
          + "\", \""
          + scheme.kind
          + "\")",
      ]
  }
  return join(checks, "\n    && ")
}

fn _render_operation_security_available_helper(
  function_name: string,
  operation: any,
  schemes: any,
) -> string {
  const helper_name = "_security_available_" + function_name
  let out = "fn " + helper_name + "(client: AdapterClient) -> bool {\n"
  for alternative in operation.alternatives {
    if len(alternative.schemes) == 0 {
      return out + "  return true\n}"
    }
    out = out + "  if " + _render_security_condition(alternative, schemes) + " {\n"
    out = out + "    return true\n  }\n"
  }
  return out + "  return false\n}"
}

fn _render_query_bindings(parts: any, query_scheme_names: any, helper_names: any) {
  let all_parts = parts
  for scheme_name in query_scheme_names {
    const helper = helper_names.queries.get(scheme_name)
    if helper != nil {
      all_parts = all_parts + ["..." + helper + "(client)"]
    }
  }
  return _render_binding_dict(all_parts)
}

fn _render_header_cookie_lines(header_params: any, cookie_params: any) {
  let lines = []
  for p in header_params {
    lines = lines
      + [
        "if "
          + p.ident
          + " != nil {\n"
          + "    request_headers = {...request_headers, "
          + _harn_dict_entry(p.name, "to_string(" + p.ident + ")")
          + "}\n"
          + "  }",
      ]
  }
  for p in cookie_params {
    lines = lines
      + [
        "request_headers = _append_cookie_header(request_headers, \""
          + _escape_string(p.name)
          + "\", "
          + p.ident
          + ")",
      ]
  }
  return join(lines, "\n  ")
}

fn _idempotency_key_param(header_params: any) {
  for p in header_params {
    if to_string(p.get("name") ?? "").lower() == "idempotency-key" {
      return p.ident
    }
  }
  return nil
}

fn _connector_http_function(ret: any) {
  if ret.response_mode == "json_any" || ret.response_mode == "json_dict" {
    return "connector_http_json"
  }
  return "connector_http_request"
}

fn _connector_imports(return_types: any, transport: string) -> string {
  if transport != "connector_policy" {
    return ""
  }
  let needs_json = false
  let needs_request = false
  for ret in return_types {
    const helper = _connector_http_function(ret)
    if helper == "connector_http_json" {
      needs_json = true
    } else if helper == "connector_http_request" {
      needs_request = true
    }
  }
  let imports = []
  if needs_json {
    imports = imports + ["connector_http_json"]
  }
  if needs_request {
    imports = imports + ["connector_http_request"]
  }
  return join(imports, ", ")
}

fn _connector_retry_attempts(method: any, idempotency_key_param: any) {
  const normalized = to_string(method ?? "").lower()
  if ["get", "head", "put", "delete", "options"].contains(normalized) {
    return 3
  }
  if (normalized == "post" || normalized == "patch") && idempotency_key_param != nil {
    return 3
  }
  return 1
}

fn _render_connector_options(
  method: any,
  fn_name: any,
  module_name: any,
  has_body: any,
  idempotency_key_param: any,
) {
  let parts = [
    _harn_dict_entry("headers", "request_headers"),
    _harn_dict_entry("provider", "\"" + _escape_string(module_name) + "\""),
    _harn_dict_entry("operation", "\"" + _escape_string(fn_name) + "\""),
    _harn_dict_entry(
      "retry",
      "{max_attempts: " + to_string(_connector_retry_attempts(method, idempotency_key_param)) + "}",
    ),
  ]
  if has_body {
    parts = parts + [_harn_dict_entry("body", "body_str")]
  }
  if idempotency_key_param != nil {
    parts = parts + [_harn_dict_entry("idempotency_key", idempotency_key_param)]
  }
  return parts
}

fn _render_connector_call(method: any, ret: any, option_parts: any, indent: any) {
  const options_expr = _render_binding_dict_for_column(option_parts, len(indent) + 2)
  return _connector_http_function(ret)
    + "(\n"
    + indent
    + "  harness.clock,\n"
    + indent
    + "  harness.net,\n"
    + indent
    + "  \""
    + to_string(method ?? "get").upper()
    + "\",\n"
    + indent
    + "  url,\n"
    + indent
    + "  "
    + _indent_after_first(options_expr, indent)
    + ",\n"
    + indent
    + ")"
}

fn _render_request_lines(
  method: any,
  has_body: any,
  body_required: any,
  body_prepare: any,
  transport: any,
  ret: any,
  fn_name: any,
  module_name: any,
  idempotency_key_param: any,
) {
  if transport == "connector_policy" {
    if !has_body {
      const options = _render_connector_options(
        method,
        fn_name,
        module_name,
        false,
        idempotency_key_param,
      )
      return "const resp = " + _render_connector_call(method, ret, options, "  ")
    }
    if body_required {
      const options = _render_connector_options(
        method,
        fn_name,
        module_name,
        true,
        idempotency_key_param,
      )
      return body_prepare + "\n  const resp = " + _render_connector_call(method, ret, options, "  ")
    }
    const no_body_options = _render_connector_options(
      method,
      fn_name,
      module_name,
      false,
      idempotency_key_param,
    )
    const body_options = _render_connector_options(
      method,
      fn_name,
      module_name,
      true,
      idempotency_key_param,
    )
    return "let resp = nil\n"
      + "  if body == nil {\n"
      + "    resp = "
      + _render_connector_call(method, ret, no_body_options, "    ")
      + "\n"
      + "  } else {\n"
      + "    "
      + _indent_after_first(body_prepare, "    ")
      + "\n"
      + "    resp = "
      + _render_connector_call(method, ret, body_options, "    ")
      + "\n"
      + "  }"
  }
  const raw_method = to_string(method ?? "get").upper()
  if !has_body {
    return "const resp = net.request(\""
      + raw_method
      + "\", url, {headers: request_headers})"
  }
  if body_required {
    return body_prepare
      + "\n  const resp = net.request(\""
      + raw_method
      + "\", url, {body: body_str, headers: request_headers})"
  }
  return "let resp = nil\n"
    + "  if body == nil {\n"
    + "    resp = net.request(\""
    + raw_method
    + "\", url, {headers: request_headers})\n"
    + "  } else {\n"
    + "    "
    + _indent_after_first(body_prepare, "    ")
    + "\n"
    + "    resp = net.request(\""
    + raw_method
    + "\", url, {body: body_str, headers: request_headers})\n"
    + "  }"
}

fn _render_return_lines(fn_name: any, ret: any, transport: any) {
  if ret.returns_nil {
    return "return nil"
  }
  if ret.response_mode == "opaque" {
    return "return {status: resp.status, headers: resp.headers, body: resp.body}"
  }
  if transport == "connector_policy" {
    if ret.response_mode == "json_any" {
      return "return resp.json"
    }
    return "const raw = resp.json\n"
      + "  if type_of(raw) != \"dict\" {\n"
      + "    throw \""
      + fn_name
      + ": expected dict response, got \" + type_of(raw)\n"
      + "  }\n"
      + "  return raw"
  }
  if ret.response_mode == "json_any" {
    return "return json_parse(resp.body)"
  }
  return "const raw = json_parse(resp.body)\n"
    + "  if type_of(raw) != \"dict\" {\n"
    + "    throw \""
    + fn_name
    + ": expected dict response, got \" + type_of(raw)\n"
    + "  }\n"
    + "  return raw"
}

fn _render_binding_dict(parts: any) {
  const inline = "{" + join(parts, ", ") + "}"
  if len(parts) == 0 || len(inline) <= 100 {
    return inline
  }
  let out = "{\n"
  for part in parts {
    out = out + "    " + part + ",\n"
  }
  out = out + "  }"
  return out
}

fn _render_binding_dict_for_column(parts: any, column: any) {
  const inline = "{" + join(parts, ", ") + "}"
  if column + len(inline) + 1 <= 100 {
    return inline
  }
  let out = "{\n"
  for part in parts {
    out = out + "    " + part + ",\n"
  }
  out = out + "  }"
  return out
}

fn _request_json_schema(doc: any, request_body: any) {
  if request_body == nil {
    return nil
  }
  const rb = _resolve_ref(doc, request_body)
  const content = rb.get("content")
  if content == nil {
    return nil
  }
  const app_json = _json_media_type(content)
  if app_json == nil {
    return nil
  }
  return app_json.get("schema")
}

fn _request_body_required(doc: any, request_body: any) {
  if request_body == nil {
    return false
  }
  const rb = _resolve_ref(doc, request_body)
  const required = rb.get("required")
  if type_of(required) == "bool" {
    return required
  }
  return false
}

fn _body_variants_for_op(doc: any, op: any, fn_name: any, taken_names: any) {
  const raw_schema = _request_json_schema(doc, op.request_body)
  if raw_schema == nil {
    return []
  }
  const root = _schema(doc, raw_schema)
  const variant_nodes = if root.get("oneOf") != nil {
    root.get("oneOf")
  } else {
    root.get("anyOf")
  }
  if type_of(variant_nodes) != "list" || len(variant_nodes) < 2 {
    return []
  }
  const discriminator = root.get("discriminator")
  const discriminator_property = if type_of(discriminator) == "dict" {
    discriminator.get("propertyName")
  } else {
    nil
  }
  let variants = []
  let taken_suffixes = []
  let taken_fn_names = taken_names + [fn_name]
  for entry in variant_nodes.enumerate() {
    const raw_variant = entry.value
    const resolved = _schema(doc, raw_variant)
    const mapping_tag = _discriminator_mapping_tag(discriminator, raw_variant)
    const display_name = _variant_display_name(raw_variant, resolved, mapping_tag, entry.index)
    const tag = _variant_tag(discriminator_property, resolved, display_name, mapping_tag)
    const suffix_base = _snake_case_ident(display_name)
    const suffix = _unique_fn_name(suffix_base, taken_suffixes)
    taken_suffixes = taken_suffixes + [suffix]
    const variant_fn_name = _unique_fn_name(fn_name + "_" + suffix, taken_fn_names)
    taken_fn_names = taken_fn_names + [variant_fn_name]
    variants = variants
      + [
        {
          name: display_name,
          tag: tag,
          fn_name: variant_fn_name,
          fields: _variant_constructor_fields(doc, resolved),
        },
      ]
  }
  return variants
}

fn _discriminator_mapping_tag(discriminator: any, raw_variant: any) {
  if type_of(discriminator) != "dict" || type_of(raw_variant) != "dict" {
    return nil
  }
  const mapping = discriminator.get("mapping")
  if type_of(mapping) != "dict" {
    return nil
  }
  const ref = raw_variant.get("$ref")
  if ref == nil {
    return nil
  }
  for entry in mapping {
    if entry.value == ref {
      return entry.key
    }
  }
  return nil
}

fn _variant_display_name(raw_variant: any, resolved: any, mapping_tag: any, index: any) {
  if type_of(resolved) == "dict" {
    const title = resolved.get("title")
    if type_of(title) == "string" && title != "" {
      return _pascal_case(title)
    }
  }
  if type_of(raw_variant) == "dict" {
    const ref = raw_variant.get("$ref")
    if type_of(ref) == "string" && ref != "" {
      return _alias_name_from_ref(ref)
    }
  }
  if type_of(mapping_tag) == "string" && mapping_tag != "" {
    return _pascal_case(mapping_tag)
  }
  return "Variant" + to_string(index + 1)
}

fn _variant_tag(discriminator_property: any, resolved: any, display_name: any, mapping_tag: any) {
  if type_of(mapping_tag) == "string" && mapping_tag != "" {
    return mapping_tag
  }
  if type_of(discriminator_property) == "string" && discriminator_property != "" {
    const const_tag = _schema_property_literal(resolved, discriminator_property)
    if const_tag != nil {
      return to_string(const_tag)
    }
  }
  return display_name
}

fn _schema_property_literal(resolved: any, property_name: any) {
  if type_of(resolved) != "dict" {
    return nil
  }
  const props = resolved.get("properties") ?? {}
  const prop = props.get(property_name)
  if type_of(prop) != "dict" {
    return nil
  }
  const const_value = prop.get("const")
  if const_value != nil {
    return const_value
  }
  const values = prop.get("enum")
  if type_of(values) == "list" && len(values) > 0 {
    return values[0]
  }
  return nil
}

fn _variant_constructor_fields(doc: any, resolved: any) {
  if type_of(resolved) != "dict" || type_of(resolved.get("properties")) != "dict" {
    return []
  }
  const props = resolved.get("properties") ?? {}
  const required = resolved.get("required") ?? []
  let keys = []
  for entry in props {
    keys = keys + [entry.key]
  }
  keys = keys.sort()
  let fields = []
  let taken_idents = []
  for key in keys {
    const prop_schema = props.get(key)
    const const_value = if type_of(prop_schema) == "dict" {
      prop_schema.get("const")
    } else {
      nil
    }
    const ident_base = _sanitize_ident(key)
    const ident = _unique_fn_name(ident_base, taken_idents)
    taken_idents = taken_idents + [ident]
    const ty = _harn_type_for_property(doc, prop_schema, 1).annotation
    fields = fields
      + [
        {
          key: key,
          ident: ident,
          annotation: ty,
          required: required.contains(key),
          const_value: const_value,
          has_const: const_value != nil,
        },
      ]
  }
  return fields
}

fn _body_variant_fn_names(variants: any) {
  let names = []
  for variant in variants {
    names = names + [variant.fn_name]
  }
  return names
}

fn _body_variant_tags(variants: any) {
  let tags = []
  for variant in variants {
    tags = tags + [variant.tag]
  }
  return tags
}

fn _render_body_prepare(fn_name: any, variants: any) {
  if len(variants) == 0 {
    return "const body_str = json_stringify(body)"
  }
  const tags = _render_string_list(_body_variant_tags(variants))
  const ctor_names = join(_body_variant_fn_names(variants), ", ")
  const tag_check = if len("  if !" + tags + ".contains(body_variant) {") <= 100 {
    "  if !" + tags + ".contains(body_variant) {\n"
  } else {
    "  if !" + tags + ".contains(\n"
      + "    body_variant,\n"
      + "  ) {\n"
  }
  return "const body_variant = if type_of(body) == \"dict\" {\n"
    + "    body.get(\"_variant\")\n"
    + "  } else {\n"
    + "    nil\n"
    + "  }\n"
    + "  if body_variant == nil {\n"
    + "    throw \""
    + fn_name
    + ": polymorphic request body must be built with one of: "
    + _escape_string(ctor_names)
    + "\"\n"
    + "  }\n"
    + tag_check
    + "    throw \""
    + fn_name
    + ": unknown request body variant \" + to_string(body_variant)\n"
    + "  }\n"
    + "  const body_str = json_stringify(_strip_codegen_variant(body))"
}

fn _render_string_list(items: any) {
  let parts = []
  for item in items {
    parts = parts + ["\"" + _escape_string(to_string(item)) + "\""]
  }
  return "[" + join(parts, ", ") + "]"
}

fn _render_body_variant_constructors(variants: any) {
  if len(variants) == 0 {
    return ""
  }
  let chunks = []
  for variant in variants {
    chunks = chunks + [_render_body_variant_constructor(variant)]
  }
  return "\n" + join(chunks, "\n\n")
}

fn _render_body_variant_constructor(variant: any) {
  let required_sig = []
  let optional_sig = []
  let literal_entries = []
  let optional_lines = []
  for field in variant.fields {
    if field.has_const {
      literal_entries = literal_entries
        + [_harn_dict_entry(field.key, _render_literal(field.const_value))]
    } else if field.required {
      required_sig = required_sig + [field.ident + ": " + field.annotation]
      literal_entries = literal_entries + [_harn_dict_entry(field.key, field.ident)]
    } else {
      optional_sig = optional_sig + [field.ident + ": any = nil"]
      optional_lines = optional_lines
        + [
          "  if "
            + field.ident
            + " != nil {\n"
            + "    body = {...body, "
            + _harn_dict_entry(field.key, field.ident)
            + "}\n"
            + "  }",
        ]
    }
  }
  const doc_comment = "/** Build a `" + _escape_string(variant.tag)
    + "` variant of the polymorphic request body. */\n"
  const sig_parts = required_sig + optional_sig
  if len(sig_parts) == 0 && len(literal_entries) == 0 {
    return doc_comment
      + "pub fn "
      + variant.fn_name
      + "(payload: dict) -> dict {\n"
      + "  return {...payload, _variant: \""
      + _escape_string(variant.tag)
      + "\"}\n"
      + "}"
  }
  literal_entries = literal_entries
    + [_harn_dict_entry("_variant", "\"" + _escape_string(variant.tag) + "\"")]
  let body = doc_comment
    + "pub fn "
    + variant.fn_name
    + "("
    + join(sig_parts, ", ")
    + ") -> dict {\n"
  body = body + "  let body = " + _render_binding_dict(literal_entries) + "\n"
  for line in optional_lines {
    body = body + line + "\n"
  }
  body = body + "  return body\n"
  body = body + "}"
  return body
}

fn _render_literal(value: any) {
  if type_of(value) == "string" {
    return "\"" + _escape_string(value) + "\""
  }
  if type_of(value) == "bool" {
    return to_string(value)
  }
  if value == nil {
    return "nil"
  }
  return json_stringify(value)
}

fn _render_data_literal(value: any) {
  if value == nil {
    return "nil"
  }
  if type_of(value) == "string" {
    return "\"" + _escape_string(value) + "\""
  }
  if type_of(value) == "bool" || type_of(value) == "int" || type_of(value) == "float" {
    return to_string(value)
  }
  if type_of(value) == "list" {
    if len(value) == 0 {
      return "[]"
    }
    let out = "[\n"
    for item in value {
      out = out + "    " + _indent_after_first(_render_data_literal(item), "    ") + ",\n"
    }
    out = out + "  ]"
    return out
  }
  if type_of(value) == "dict" {
    let parts = []
    for entry in value {
      if entry.value != nil {
        parts = parts + [_harn_dict_entry(entry.key, _render_data_literal(entry.value))]
      }
    }
    if len(parts) == 0 {
      return "{}"
    }
    let out = "{\n"
    for part in parts {
      out = out + "    " + _indent_after_first(part, "    ") + ",\n"
    }
    out = out + "  }"
    return out
  }
  return "\"" + _escape_string(to_string(value)) + "\""
}

fn _indent_after_first(src: any, indent: any) {
  return replace(src, "\n", "\n" + indent)
}

fn _render_json_parse_expr(value: any) {
  return _render_json_parse_expr_at(value, "  ")
}

fn _render_json_parse_expr_at(value: any, base_indent: string, max_inline: int = 80) {
  const encoded = _escape_string(json_stringify(value))
  if len(encoded) <= max_inline {
    return "json_parse(\"" + encoded + "\")"
  }
  return "json_parse(\n" + base_indent + "  \"" + encoded + "\",\n" + base_indent + ")"
}

// -------------------------------------------------------------------------------------------------
// Response type resolution
// -------------------------------------------------------------------------------------------------

//   For each operation we pick the first 2xx response whose
//   application/json body carries a JSON schema, classify that schema,
//   and either emit a typed `type` alias for it or fall back to `dict`.
//   Aliases keyed by component `$ref` are deduplicated across
//   operations; inline schemas get an alias named after their op.

// -------------------------------------------------------------------------------------------------

fn _resolve_response_type(doc: any, op: any, cache: any) {
  const picked = _pick_success_response(doc, op)
  if picked == nil {
    // No 2xx declared at all — legacy `dict` with empty-body fallback.
    return {
      info: {type_name: "dict", returns_nil: false, alias_name: nil, response_mode: "json_dict"},
      cache: cache,
    }
  }
  if picked.kind == "nil" {
    return {
      info: {type_name: "nil", returns_nil: true, alias_name: nil, response_mode: "nil"},
      cache: cache,
    }
  }
  if picked.kind == "opaque" {
    return {
      info: {type_name: "dict", returns_nil: false, alias_name: nil, response_mode: "opaque"},
      cache: cache,
    }
  }
  const schema_raw = picked.schema
  if schema_raw == nil {
    // JSON content entry with no declared schema — fall back to dict.
    return {
      info: {type_name: "dict", returns_nil: false, alias_name: nil, response_mode: "json_dict"},
      cache: cache,
    }
  }
  const ref = schema_raw.get("$ref")
  // For classification we always work off the fully-resolved (allOf-
  // merged) schema, since components often declare the interesting
  // shape inside `allOf: [...]`.
  const full = _schema(doc, schema_raw)
  const shape = _schema_shape_kind(full)
  if shape == "nil" {
    return {
      info: {type_name: "nil", returns_nil: true, alias_name: nil, response_mode: "nil"},
      cache: cache,
    }
  }
  const untyped_json_type = _untyped_json_return_type(full)
  if shape == "dict" && untyped_json_type != "dict" {
    return {
      info: {
        type_name: untyped_json_type,
        returns_nil: false,
        alias_name: nil,
        response_mode: "json_any",
      },
      cache: cache,
    }
  }
  if ref != nil {
    const cached = cache.by_ref.get(ref)
    if cached != nil {
      if shape == "dict" {
        return {
          info: {
            type_name: "dict",
            returns_nil: false,
            alias_name: nil,
            response_mode: "json_dict",
          },
          cache: cache,
        }
      }
      return {
        info: {
          type_name: cached,
          returns_nil: false,
          alias_name: cached,
          response_mode: "json_dict",
        },
        cache: cache,
      }
    }
    if shape == "dict" {
      // oneOf/anyOf/primitive/etc. — no struct alias for v0.
      return {
        info: {type_name: "dict", returns_nil: false, alias_name: nil, response_mode: "json_dict"},
        cache: cache,
      }
    }
    if !_struct_has_renderable_keys(full) {
      return {
        info: {type_name: "dict", returns_nil: false, alias_name: nil, response_mode: "json_dict"},
        cache: cache,
      }
    }
    const base_alias = _alias_name_from_ref(ref)
    const alias_name = _unique_type_name(base_alias, cache)
    const source = _emit_struct_alias(doc, alias_name, full)
    const new_cache = {
      by_ref: {...cache.by_ref, [ref]: alias_name},
      by_name: {...cache.by_name, [alias_name]: source},
      order: cache.order + [alias_name],
    }
    return {
      info: {
        type_name: alias_name,
        returns_nil: false,
        alias_name: alias_name,
        response_mode: "json_dict",
      },
      cache: new_cache,
    }
  }
  // Inline schema — classify, and if struct-shaped emit an alias named
  // after the operation id.
  if shape == "dict" {
    return {
      info: {type_name: "dict", returns_nil: false, alias_name: nil, response_mode: "json_dict"},
      cache: cache,
    }
  }
  if !_struct_has_renderable_keys(full) {
    return {
      info: {type_name: "dict", returns_nil: false, alias_name: nil, response_mode: "json_dict"},
      cache: cache,
    }
  }
  const base = _alias_name_from_operation(op.operation_id)
  const alias_name = _unique_type_name(base, cache)
  const source = _emit_struct_alias(doc, alias_name, full)
  const new_cache = {
    by_ref: cache.by_ref,
    by_name: {...cache.by_name, [alias_name]: source},
    order: cache.order + [alias_name],
  }
  return {
    info: {
      type_name: alias_name,
      returns_nil: false,
      alias_name: alias_name,
      response_mode: "json_dict",
    },
    cache: new_cache,
  }
}

fn _pick_success_response(doc: any, op: any) {
  // Walk responses in spec order. First entry whose status code starts
  // with "2" wins. Returns one of:
  //   {kind: "json", schema}   — JSON body we can try to type.
  //   {kind: "nil"}            — 204 No Content (absent response body).
  //   {kind: "opaque"}         — 2xx with a body but no JSON schema
  //                              (e.g. application/octet-stream). The
  //                              caller keeps the legacy `dict` return.
  //   nil                      — operation has no 2xx response at all.
  let saw_opaque = false
  for entry in op.responses {
    const code = entry.key
    if _is_success_code(code) {
      const resp = _resolve_ref(doc, entry.value)
      const content = resp.get("content")
      if content == nil {
        return {kind: "nil"}
      }
      const app_json = _json_media_type(content)
      if app_json != nil {
        return {kind: "json", schema: app_json.get("schema")}
      }
      saw_opaque = true
    }
  }
  if saw_opaque {
    return {kind: "opaque"}
  }
  return nil
}

fn _json_media_type(content: any) {
  if type_of(content) != "dict" {
    return nil
  }
  const exact = content.get("application/json")
  if exact != nil {
    return exact
  }
  for entry in content {
    const normalized = _media_type_without_parameters(entry.key)
    if normalized == "application/json" || regex_match("\\+json$", normalized) != nil {
      return entry.value
    }
  }
  return nil
}

fn _media_type_without_parameters(raw: any) {
  const lowered = to_string(raw).lower()
  const semi = _index_of(lowered, ";")
  if semi >= 0 {
    return trim(substring(lowered, 0, semi))
  }
  return trim(lowered)
}

fn _index_of(hay: any, needle: any) {
  const nh = len(hay)
  const nn = len(needle)
  if nn == 0 {
    return 0
  }
  let i = 0
  while i + nn <= nh {
    if substring(hay, i, i + nn) == needle {
      return i
    }
    i = i + 1
  }
  return -1
}

fn _is_success_code(code: any) {
  if type_of(code) != "string" {
    return false
  }
  return starts_with(code, "2")
}

fn _schema_shape_kind(sch: any) {
  // Returns "struct" (emit an object alias), "dict" (polymorphic /
  // primitive / unsupported — fall back to `dict`), or "nil" (no
  // response body shape to speak of).
  //
  // A schema that declares both `properties` and `oneOf`/`anyOf` is an
  // intersection ("has these fields AND matches one of these shapes").
  // v0 treats that as a struct — the depth-1 properties provide useful
  // narrowing, and the union narrowing is deferred to `schema_is` at
  // the call site.
  if sch == nil {
    return "nil"
  }
  if type_of(sch) != "dict" {
    return "dict"
  }
  if sch.get("properties") != nil {
    return "struct"
  }
  if sch.get("oneOf") != nil || sch.get("anyOf") != nil {
    return "dict"
  }
  const ty = sch.get("type")
  if ty == "object" {
    // `type: object` with no explicit properties — treat as bag-of-kv.
    return "dict"
  }
  // Primitive or unspecified.
  return "dict"
}

fn _untyped_json_return_type(sch: any) {
  if type_of(sch) != "dict" {
    return "any"
  }
  if sch.get("oneOf") != nil || sch.get("anyOf") != nil {
    return "any"
  }
  const ty = sch.get("type")
  if ty == "array" {
    return "list"
  }
  const prim = _primitive_harn_type(ty)
  if prim != nil {
    return prim
  }
  return "dict"
}

fn _alias_name_from_ref(ref: any) {
  // "#/components/schemas/pageObjectResponse" -> "PageObjectResponse"
  const parts = split(ref, "/")
  const tail = _unescape_pointer(parts[len(parts) - 1])
  return _pascal_case(tail)
}

fn _alias_name_from_operation(operation_id: any) {
  // Feed the raw operation_id into `_pascal_case` so camelCase ids
  // like `searchItems` render as `SearchItems` rather than the
  // lowercased `Searchitems` we'd get from `_sanitize_fn_name`.
  return _pascal_case(operation_id) + "Response"
}

fn _pascal_case(raw: any) {
  if raw == nil || raw == "" {
    return "T"
  }
  const segments = split(regex_replace("[^a-zA-Z0-9]+", "_", raw), "_")
  let out = ""
  for seg in segments {
    if seg != "" {
      const first = substring(seg, 0, 1).upper()
      const rest = if len(seg) > 1 {
        substring(seg, 1, len(seg))
      } else {
        ""
      }
      out = out + first + rest
    }
  }
  if out == "" {
    return "T"
  }
  const first_char = substring(out, 0, 1)
  if _is_digit(first_char) {
    return "T" + out
  }
  return out
}

fn _unique_type_name(base: any, cache: any) {
  if cache.by_name.get(base) == nil {
    return base
  }
  let n = 2
  let candidate = base + to_string(n)
  while cache.by_name.get(candidate) != nil {
    n = n + 1
    candidate = base + to_string(n)
  }
  return candidate
}

fn _emit_struct_alias(doc: any, alias_name: any, resolved: any) {
  const props = resolved.get("properties") ?? {}
  const required = resolved.get("required") ?? []
  let keys = []
  for entry in props {
    keys = keys + [entry.key]
  }
  keys = keys.sort()
  let fields = []
  for key in keys {
    const prop_schema = props.get(key)
    const field_type = _harn_type_for_property(doc, prop_schema, 1)
    fields = fields + [_harn_struct_field(key, field_type.annotation, required.contains(key))]
  }
  if len(fields) <= 4 {
    return "type " + alias_name + " = {" + join(fields, ", ") + "}"
  }
  let out = "type " + alias_name + " = {\n"
  for field in fields {
    out = out + "  " + field + ",\n"
  }
  return out + "}"
}

fn _harn_type_for_property(doc: any, prop_schema: any, depth: any) {
  // Returns {annotation: string, comment: string}. `depth` starts at 1
  // for direct properties of the response. v0 rule: stop narrowing at
  // depth 2 — nested dicts/lists render as bare `dict`/`list`.
  if type_of(prop_schema) != "dict" {
    return {annotation: "dict", comment: ""}
  }
  const ref = prop_schema.get("$ref")
  if ref != nil {
    const resolved = _schema(doc, prop_schema)
    const kind = _schema_shape_kind(resolved)
    if kind == "dict" {
      const ty = resolved.get("type")
      const prim = _primitive_harn_type(ty)
      if prim != nil {
        return {annotation: prim, comment: ""}
      }
      const ref_name = _alias_name_from_ref(ref)
      return {
        annotation: "dict",
        comment: ref_name + " (polymorphic or primitive) — narrow with schema_is.",
      }
    }
    // Referenced schema is a struct. v0 does not recursively emit
    // dependent aliases, so nested struct refs render as `dict` with a
    // hint pointing at the schema name.
    const ref_name = _alias_name_from_ref(ref)
    return {annotation: "dict", comment: ref_name + " — nested; narrow with schema_is."}
  }
  if prop_schema.get("oneOf") != nil || prop_schema.get("anyOf") != nil {
    return {annotation: "dict", comment: "polymorphic; narrow with schema_is."}
  }
  const ty = prop_schema.get("type")
  if ty == "array" {
    return {annotation: "list", comment: ""}
  }
  if ty == "object" {
    if prop_schema.get("properties") != nil && depth < 2 {
      // Could recurse inline, but v0 keeps it simple: bare dict with a
      // nudge. Future work (issue follow-up) may emit nested aliases.
      return {annotation: "dict", comment: "inline object; narrow with schema_is."}
    }
    return {annotation: "dict", comment: ""}
  }
  const prim = _primitive_harn_type(ty)
  if prim != nil {
    return {annotation: prim, comment: ""}
  }
  // Unknown / nullable-union / missing — fall back to dict.
  return {annotation: "dict", comment: ""}
}

fn _primitive_harn_type(ty: any) {
  if ty == "string" {
    return "string"
  }
  if ty == "boolean" {
    return "bool"
  }
  if ty == "integer" {
    return "int"
  }
  if ty == "number" {
    return "float"
  }
  return nil
}

fn _harn_struct_field(key: any, annotation: any, required: any) {
  // Type-alias field names accept bare identifiers even when the name
  // collides with a keyword (e.g. `type`, `object`). Callers guarantee
  // the key is a plain identifier via `_struct_has_renderable_keys`.
  if required {
    return key + ": " + annotation
  }
  return key + "?: " + annotation
}

fn _struct_has_renderable_keys(resolved: any) {
  const props = resolved.get("properties") ?? {}
  for entry in props {
    if !_is_plain_identifier(entry.key) {
      return false
    }
  }
  return true
}

fn _sanitize_fn_name(raw: any) {
  return _snake_case_base(raw, "op")
}

fn _sanitize_ident(raw: any) {
  const s = _sanitize_fn_name(raw)
  if _is_reserved(s) {
    return s + "_"
  }
  return s
}

fn _snake_case_ident(raw: any) {
  const out = _snake_case_base(raw, "variant")
  if _is_reserved(out) {
    return out + "_"
  }
  return out
}

fn _snake_case_base(raw: any, fallback: any) {
  if raw == nil || raw == "" {
    return fallback
  }
  const cleaned = regex_replace("[^a-zA-Z0-9]+", "_", raw)
  let out = ""
  let i = 0
  while i < len(cleaned) {
    const ch = substring(cleaned, i, i + 1)
    if ch == "_" {
      if out != "" && substring(out, len(out) - 1, len(out)) != "_" {
        out = out + "_"
      }
    } else {
      if _is_upper(ch) && out != "" && substring(out, len(out) - 1, len(out)) != "_" {
        out = out + "_"
      }
      out = out + ch.lower()
    }
    i = i + 1
  }
  out = regex_replace("^_+|_+$", "", out)
  if out == "" {
    return fallback
  }
  const first_char = substring(out, 0, 1)
  if _is_digit(first_char) {
    return fallback + "_" + out
  }
  return out
}

fn _is_upper(c: any) {
  return regex_match("^[A-Z]$", c) != nil
}

fn _is_digit(c: any) {
  return c == "0" || c == "1" || c == "2" || c == "3" || c == "4"
    || c == "5"
    || c == "6"
    || c == "7"
    || c == "8"
    || c == "9"
}

const _RESERVED = [
  "if",
  "else",
  "elif",
  "for",
  "in",
  "while",
  "match",
  "let",
  "var",
  "fn",
  "pub",
  "return",
  "throw",
  "try",
  "catch",
  "finally",
  "pipeline",
  "import",
  "from",
  "as",
  "type",
  "interface",
  "enum",
  "true",
  "false",
  "nil",
  "and",
  "or",
  "not",
  "skill",
  "tool",
  "ask_user",
  "body",
  "client",
]

fn _is_reserved(s: any) {
  return _RESERVED.contains(s)
}

fn _unique_fn_name(base: any, taken: any) {
  if !taken.contains(base) {
    return base
  }
  let n = 2
  let candidate = base + "_" + to_string(n)
  while taken.contains(candidate) {
    n = n + 1
    candidate = base + "_" + to_string(n)
  }
  return candidate
}

fn _escape_comment(s: any) {
  return replace(replace(s, "*/", "* /"), "\n", " ")
}

fn _harn_dict_entry(key: any, value_expr: any) {
  return _harn_dict_key(key) + ": " + value_expr
}

fn _harn_dict_key(key: any) {
  if _is_plain_identifier(key) {
    return key
  }
  return "\"" + _escape_string(key) + "\""
}

fn _is_plain_identifier(s: any) {
  if s == "" {
    return false
  }
  const first = substring(s, 0, 1)
  if _is_digit(first) {
    return false
  }
  return regex_match("^[A-Za-z_][A-Za-z0-9_]*$", s) != nil
}

fn _escape_string(s: any) {
  // Defence-in-depth: even though emitted code is re-checked by `harn check`
  // in tests, control characters smuggled in from a malicious OpenAPI spec
  // could close a Harn string literal early or break our codegen output. We
  // explicitly escape \n, \r, \t, and reject any remaining ASCII control
  // characters (U+0000-U+001F) before emitting.
  const coerced = to_string(s)
  if regex_match("[\\x00-\\x08\\x0b\\x0c\\x0e-\\x1f]", coerced) != nil {
    throw "harn-openapi: control character in string value (only \\n, \\r, \\t are escaped, others are rejected)"
  }
  let out = replace(coerced, "\\", "\\\\")
  out = replace(out, "\"", "\\\"")
  out = replace(out, "\n", "\\n")
  out = replace(out, "\r", "\\r")
  out = replace(out, "\t", "\\t")
  return out
}

fn _escape_toml_string(s: any) {
  return _escape_string(to_string(s))
}

fn _toml_key(key: any) {
  if regex_match("^[A-Za-z0-9_-]+$", key) != nil {
    return key
  }
  return "\"" + _escape_toml_string(key) + "\""
}

fn _render_manifest_dependency(name: any, spec: any) {
  if type_of(spec) == "string" {
    return _toml_key(name) + " = \"" + _escape_toml_string(spec) + "\"\n"
  }
  if type_of(spec) != "dict" {
    return _toml_key(name) + " = \"*\"\n"
  }
  let parts = []
  for key in ["path", "git", "rev", "branch", "tag", "version"] {
    const value = spec.get(key)
    if value != nil {
      parts = parts + [_toml_key(key) + " = \"" + _escape_toml_string(value) + "\""]
    }
  }
  if len(parts) == 0 {
    return _toml_key(name) + " = {}\n"
  }
  return _toml_key(name) + " = { " + join(parts, ", ") + " }\n"
}

fn _render_dict_literal(d: any) {
  if type_of(d) != "dict" {
    return "{}"
  }
  let parts = []
  for entry in d {
    parts = parts
      + [_harn_dict_entry(entry.key, "\"" + _escape_string(to_string(entry.value)) + "\"")]
  }
  if len(parts) == 0 {
    return "{}"
  }
  return "{" + join(parts, ", ") + "}"
}
